## 0.7.51.10 (Luz): the suits each their own – combat suits plated with a closed visor helmet, the civilian and
## survey suits an EVA helmet with a gold visor; the powers' guards in combat suits of their colours; the helmet worn
## when needed or always (saved).
func _test_suit_looks() -> void:
	var CA = ChibiArt
	var look: Dictionary = (GameState.pilot.get("look", {}) as Dictionary).duplicate()
	var datas := {}
	var differ := true
	for suit in ["suit_civil", "suit_survey", "suit_work", "suit_mil_light", "suit_mil_heavy"]:
		for hm in [false, true]:
			var l2 := look.duplicate()
			l2["suit"] = suit
			l2["helmet"] = hm
			var d: PackedByteArray = CA.frame(l2, 0, 0).get_image().get_data()
			for k in datas:
				differ = differ and datas[k] != d
			datas["%s%s" % [suit, hm]] = d
	# the helmet hides the face of a combat suit: no skin colour left in the head
	var lv := {}
	for liv in CA.LIVERY:
		var l3 := look.duplicate()
		l3["suit"] = "suit_mil_light"
		l3["helmet"] = true
		l3["livery"] = liv
		lv[liv] = CA.frame(l3, 0, 0).get_image().get_data()
	var liv_ok: bool = lv.size() == 7 and lv["covenant"] != lv["directorate"] and lv["assembly"] != lv["independent"] and lv["pirate"] != lv["independent"] 		and lv["corp"] != lv["independent"]      # 0.7.52.5: + the pirates; 0.7.53.19: + corporate security
	# the helmet setting, saved and loaded
	var g = GameState.gear
	var was := String(g.helmet)
	g.helmet = "always"
	var PG = preload("res://scripts/core/pilot_gear.gd")
	var g2 = PG.new()
	g2.from_dict(JSON.parse_string(JSON.stringify(g.to_dict())))
	var save_ok: bool = g2.helmet == "always"
	g.helmet = was
	check(differ and liv_ok and save_ok,
		"0.7.51.10: every suit its own look with and without its helmet (%d pictures), the guards' combat suits in 4 powers' colours, the helmet worn when needed or always, saved" % datas.size())


func _gp_buttons(n: Node) -> Array:
	var out: Array = []
	for c in n.get_children():
		if c is Button:
			out.append(c)
		out.append_array(_gp_buttons(c))
	return out


func _test_landing(view: SystemView) -> void:
	var beacons := 0
	var gas_free := true
	for t in Universe.warp_targets(view.system_id):
		if t["kind"] == "descent":
			beacons += 1
			var b := Universe.find_body(view.system_id, String(t["data"]["body"]))
			gas_free = gas_free and (Universe.landable(b) or bool(b.get("cloud_city", false)))      # package 54: a giant only for its cloud cities
	var node = null
	for bid in view.descents:
		node = view.descents[bid]
		if Universe.has_atmosphere(Universe.find_body(view.system_id, bid)):
			break
	if node == null:
		check(false, "50: a descent beacon in the home system")
		return
	var p := view.player
	p.position = node.position + Vector2(-900, 0)
	var cmd_ok: bool = Commands.execute({"type": "descend", "id": node.data["id"]}) == "" and p.order.get("type", "") == "descend"
	p.position = node.position + Vector2(-80, 0)
	view.start_descent(p, node)
	var guard := 0
	while not view._descent.is_empty() and guard < 600:
		view._update_descent(1.0 / 30.0)
		guard += 1
	var f := GameState.active()
	var down: bool = f.docked_at.begins_with("land:") and main.planet_map != null and not main.planet_map.sites.is_empty()
	var body: Dictionary = main.planet_map.body if main.planet_map != null else {}
	var site: Dictionary = main.planet_map.sites[0] if down else {}
	var sites_all: Array = main.planet_map.sites.duplicate() if down else []
	if down:
		main.land_at(body, site)
	var g = main.ground
	var field: bool = g != null and g.level in ["landing", "settlement"] and g.map.ship_at != Vector2.INF and g._ship_spr != null and g.map.zone_at(g.map.spawn).get("id", "") == "ship"
	_test_settlement(view, body, sites_all)
	_test_takeoff(body, sites_all)
	_test_env()
	_test_clinic(view, body, sites_all)
	# 0.7.50.4: a small place - down by the landing drone, not the ship; a city - the ship herself
	var drone_ok := true
	if down:
		for s2 in sites_all:
			if String(s2["kind"]) != "city":
				main.land_at(body, s2)
				g = main.ground
				drone_ok = g != null and g._lander and g._ship_tex().get_width() == LanderArt.W
				break
		for s3 in sites_all:
			if String(s3["kind"]) == "city":
				main.land_at(body, s3)
				g = main.ground
				drone_ok = drone_ok and g != null and not g._lander
				break
	check(drone_ok, "0.7.50.4: small places by the landing drone, cities by the ship herself")
	_test_city(view, body, sites_all)
	main.take_off()
	guard = 0
	while not view._descent.is_empty() and guard < 600:
		view._update_descent(1.0 / 30.0)
		guard += 1
	var up: bool = f.docked_at == "" and p.visible and is_equal_approx(p.scale.x, 1.0) and main.ground == null and main.planet_map == null
	check(cmd_ok and beacons >= 1 and gas_free and down and field and up and GameState.codex.unlocked.has("basics_landing"),
		"50: %d descent beacons (over a gas giant only for its cloud cities); down to %s, the planet map (%d places), landed at %s, back up to orbit" % [beacons, String(body.get("name", "?")), main.planet_map.sites.size() if main.planet_map != null else Universe.landing_sites(view.system_id, body).size(), String(site.get("name", "?"))])


## 0.7.50.15: down by the drone, its ramp folds down and you walk out; back aboard, the choice – orbit or the planet
## map; the ramp folds up, the drone lifts off, climbs and is caught by the ship; then the planet map again.
func _test_takeoff(body: Dictionary, sites_all: Array) -> void:
	var site := {}
	for s in sites_all:
		if String(s["kind"]) in ["outpost", "mine", "research"]:
			site = s
			break
	if site.is_empty():
		check(true, "0.7.50.15: (no settlement on this body)")
		return
	var f := GameState.active()
	main.land_at(body, site, true)
	var g = main.ground
	for i in 200:
		if g._touch < 0.0:
			break
		g._process(0.05)
	var ramp_ok: bool = g._hatch >= 0.99 and g.pilot.visible and String(g.map.zone_at(g.pilot.pos).get("id", "")) == "ship"
	var lights := 0
	for ch in g._world.get_children():
		if ch is PadLights:
			lights = ch.rects.size()
	g.zone = g.map.zone_at(g.pilot.pos)
	g.use()
	var menu_ok: bool = g._lift_menu != null and (g._lift_menu.get_meta("keys", []) as Array).size() == 2
	g._choose_takeoff("orbit")
	var shut := false
	for i in 300:
		if main.flight != null or not is_instance_valid(g):
			break
		g._process(0.05)
		shut = shut or (g._hatch <= 0.01 and not g.pilot.visible)
	var fl = main.flight
	var caught := false
	if fl != null:
		for i in 300:
			fl._process(0.05)
			if fl._done:
				break
		caught = fl.up and fl._clamped and not fl._drone.visible
		if main._fade_tw != null and main._fade_tw.is_valid():
			main._fade_tw.kill()                      # (the test goes on by hand)
		fl.queue_free()
		main.flight = null
	var bid := String(body["id"])
	main.take_off("map")
	var map_ok: bool = main.planet_map != null and f.docked_at == "land:" + bid and main.ground == null
	check(ramp_ok and lights == 4 and menu_ok and shut and caught and map_ok,
		"0.7.50.15: %s – the drone's ramp down, %d pads lit, take-off: orbit or planet map, ramp up, the drone caught by the ship, back to the planet map" % [String(site["name"]), lights])


## 0.7.51.4: the clinic – a room on a station's commercial level (none in a settlement); fallen on foot at a
## settlement you wake in the nearest city's clinic (your ship in its hangar), the pockets emptied; after a lost ship
## you wake in the station's clinic.
func _test_clinic(view: SystemView, body: Dictionary, sites_all: Array) -> void:
	var site := {}
	var has_city := false
	for s in sites_all:
		if String(s["kind"]) in ["outpost", "mine", "research"] and site.is_empty():
			site = s
	has_city = not main.nearest_clinic_city(view.system_id, String(body["id"])).is_empty()
	if site.is_empty() or not has_city:
		check(true, "0.7.51.4: (no settlement here or no city in the system)")
		return
	var f := GameState.active()
	var gear = GameState.gear
	# 0.7.51.11: the clinic is a level of its own – not in the shop row; its treatment window, its image studio, its
	# recovery room; the image studio leaves the shop row where there is a clinic
	var st: Dictionary = view.stations.values()[0].data
	var av := {"clinic": "", "market": "", "gear": "", "look": ""}
	var deck := DeckGen.build(st, av)
	var cl := DeckGen.build_clinic(st, av)
	var room_ok := true
	for z in deck.zones:
		room_ok = room_ok and not (String(z.get("kind", "")) == "service" and String(z.get("id", "")) in ["clinic", "look"])
	var ids := {}
	for z2 in cl.zones:
		ids[String(z2.get("id", ""))] = String(z2.get("kind", ""))
	room_ok = room_ok and ids.get("clinic", "") == "service" and ids.get("look", "") == "service" and ids.has("wake") and cl.lifts.size() == 2
	var no_clinic_deck := DeckGen.build(st, {"market": "", "look": ""})
	var look_row := false
	for z3 in no_clinic_deck.zones:
		look_row = look_row or (String(z3.get("kind", "")) == "service" and String(z3.get("id", "")) == "look")
	room_ok = room_ok and look_row
	# fallen at a settlement
	main.land_at(body, site)
	gear.add_item("cs_medkit", 2)
	gear.add_item("wp_smg:C")
	var suit0: String = gear.suit
	var val0: int = int(gear.carried_value()["value"])
	main._fallen()
	var g = main.ground
	var city_ok: bool = g != null and g.is_city() and g.level == "clinic" and f.docked_at.begins_with("land:") and bool(Commands.docked_station().get("city", false)) \
		and g.pilot.pos.distance_to(g._clinic_spot()) < 2.0 and gear.free_places() == gear.inv.size() and gear.health < 100.0
	# 0.7.53.14 (Luz): the buy-back window as for a lost ship – 10 % of what you wore and carried (not the locker); until
	# then the basic kit; bought back, it is all there again
	var fo: Dictionary = GameState.fall_offer
	var offer_ok: bool = main.loss_window.visible and bool(fo.get("foot", false)) and int(fo["price"]) == int(round(val0 * 0.1)) \
		and gear.suit == "suit_civil:F" and not g.input_enabled
	GameState.credits += int(fo.get("price", 0))
	main.loss_window._decide(true)
	var back_ok: bool = not main.loss_window.visible and gear.suit == suit0 and gear.count("wp_smg:C") == 1 and GameState.fall_offer.is_empty()
	city_ok = city_ok and offer_ok and back_ok
	if not (offer_ok and back_ok):
		print("[SMOKE] fall buy-back: ", offer_ok, " ", back_ok, " ", fo.get("price", -1), " ", val0, " ", gear.suit)
	var treat: String = Commands.execute({"type": "clinic_heal"})
	var healed: bool = treat == "" and is_equal_approx(gear.health, 100.0)
	# after a lost ship: the station's clinic
	main._wake_at(st)
	var g2 = main.ground
	var station_ok: bool = g2 != null and g2.level == "clinic" and g2.pilot.pos.distance_to(g2._clinic_spot()) < 2.0
	main.close_deck(false)
	check(room_ok and city_ok and healed and station_ok,
		"0.7.51.4/0.7.51.11: the clinic – a level of its own by the lift (treatment, image studio, recovery room), the image studio in the shop row only without a clinic; fallen at %s you wake in %s's clinic (ship in its hangar), the gear buy-back window (10 %%, basic kit until then, bought back all there), treatment heals; after a lost ship you wake in the station's clinic" % [String(site["name"]), String(Commands.docked_station().get("name", "?"))])


## 0.7.51.3: outside on an airless moon – the helmet on (the townsfolk in suits too), the tank empties, the life
## support draws energy, the cold that gets through hurts; a medkit heals, a charging point fills up; without air it
## suffocates, and at the end the body gives out (collapse). Under a roof the suit rests; a terran world's air is
## good to breathe.
func _test_env() -> void:
	var GD = preload("res://data/gear.gd")
	var body := {"id": "env_test_moon", "type": "moon_rock", "name": "Test Moon"}
	var site := {"id": "env_test_site", "kind": "outpost", "name": "Vacuum Post"}
	main.land_at(body, site)
	var g = main.ground
	var gear = GameState.gear
	var helmet_ok: bool = g.needs_helmet() and bool(g.pilot.look.get("helmet", false))
	var folk := 0
	for w in g.people:
		if bool(w.look.get("helmet", false)):
			folk += 1
	g.pilot.pos = g.map.spawn
	var o0: float = gear.oxygen
	var e0: float = gear.energy
	var h0: float = gear.health
	for i in 60:
		g._env_step(1.0)
	# 0.7.53.14 (Luz): with energy the cold is kept out (at a cost in energy); with the energy gone it gets through
	var kept_ok: bool = is_equal_approx(gear.health, h0)
	gear.energy = 0.0
	for i2 in 10:
		g._env_step(1.0)
	var drain_ok: bool = gear.oxygen < o0 - 0.9 and gear.energy < e0 and kept_ok and gear.health < h0 and not g.indoors()
	# a medkit off the belt
	var hb: float = gear.health
	var mk := -1
	for b in gear.belt.size():
		if not (gear.belt[b] as Dictionary).is_empty() and String(gear.belt[b]["id"]) == "cs_medkit":
			mk = b
	g.use_belt(mk)
	var heal_ok: bool = mk >= 0 and gear.health > hb
	# a charging point by a pad
	var charge_z := {}
	for z in g.map.zones:
		if String(z.get("kind", "")) == "charge":
			charge_z = z
	g.pilot.pos = (charge_z["rect"] as Rect2).get_center() if not charge_z.is_empty() else g.pilot.pos
	g.zone = g.map.zone_at(g.pilot.pos)
	g.use()
	var t: Dictionary = gear.totals()
	var charge_ok: bool = not charge_z.is_empty() and is_equal_approx(gear.energy, float(t["energy"])) and is_equal_approx(gear.oxygen, float(t["oxygen"]))
	# no air
	g.pilot.pos = g.map.spawn
	gear.oxygen = 0.0
	var hs: float = gear.health
	g._env_step(1.0)
	var choke_ok: bool = gear.health <= hs - GD.SUFFOCATE + 0.01
	# the end
	g.used.disconnect(main._on_deck_use)
	gear.health = 0.01
	g._env_step(1.0)
	var collapse_ok: bool = g._collapsed and not g.input_enabled
	g.used.connect(main._on_deck_use)
	# a terran world: good air, no helmet
	var safe_ok: bool = GD.env_of("terran")["breathable"] and not GD.needs_helmet(GD.env_of("terran")) and GD.needs_helmet(GD.env_of("lava"))
	# 0.7.53.16 (Luz): a while without harm the body mends slowly – up to 75 %, no further
	gear.health = 90.0
	gear.health_step(0.1)
	gear.health = 40.0
	gear.health_step(0.1)
	var h40: float = gear.health
	for i3 in 5:
		gear.health_step(1.0)
	var waits: bool = is_equal_approx(gear.health, h40)
	for i4 in 60:
		gear.health_step(1.0)
	var mend_ok: bool = waits and is_equal_approx(gear.health, GD.HEALTH * GD.HEAL_CAP)
	gear.health = 90.0
	gear.health_step(1.0)
	mend_ok = mend_ok and is_equal_approx(gear.health, 90.0)
	safe_ok = safe_ok and mend_ok
	if not mend_ok:
		print("[SMOKE] heal: ", waits, " ", gear.health)
	gear.aboard()
	check(helmet_ok and folk >= 1 and drain_ok and heal_ok and charge_ok and choke_ok and collapse_ok and safe_ok,
		"0.7.51.3: on an airless moon – helmet on (%d townsfolk in suits), oxygen and energy drain, the cold kept out on energy and getting through without, a medkit heals, a charging point fills up, no air suffocates, the body gives out; good air on a terran world; the body mends to 75 %% after a while without harm" % folk)


## 0.7.50.10: a settlement – its four pads (drones coming and going on the free ones), its street, walk-in shops, the
## building its economy is known for, guards; bounded by its world; its market trades.
func _test_settlement(view: SystemView, body: Dictionary, sites_all: Array) -> void:
	var site := {}
	for s in sites_all:
		if String(s["kind"]) in ["outpost", "mine", "research"]:
			site = s
			break
	if site.is_empty():
		check(true, "0.7.50.10: (no settlement on this body)")
		return
	main.land_at(body, site)
	var g = main.ground
	var f := GameState.active()
	var shops := 0
	var special := ""
	for z in g.map.zones:
		if String(z.get("kind", "")) == "service":
			shops += 1
			if String(z["title"]).contains(":"):
				special = String(z["title"])
	var traffic = null
	for ch in g._world.get_children():
		if ch is PadTraffic:
			traffic = ch
	var moved := false
	if traffic != null:
		for i in 900:
			traffic._process(0.05)
			for p in traffic.pads:
				moved = moved or String(p["state"]) in ["landing", "lifting"]
	var guards := 0
	for w in g.people:
		if w.guard:
			guards += 1
	var border := 0
	for o in g.map.objects:
		if String(o["kind"]) in ["tree", "rock", "dune", "crystal", "lava_rock"]:
			border += 1
	var sea_ok: bool = SettleGen.bounds(body) == "sea" or border > 20
	# 0.7.50.12: its economy area behind the fence, alive
	var econ_life := false
	for ch2 in g._world.get_children():
		if ch2 is EconLife:
			econ_life = true
			ch2._process(0.5)
	sea_ok = sea_ok and not g.map.econ.is_empty() and econ_life
	var town: Dictionary = Commands.docked_station()
	var buy := Commands.execute({"type": "market_buy", "item": "food", "amount": 1})
	check(g.level == "settlement" and g.map.pads.size() == 4 and moved and shops >= 3 and special != "" and guards >= 1 and sea_ok
		and town.get("settlement", false) and f.docked_at == Universe.city_id(body, site) and GameState.codex.unlocked.has("basics_settlements"),
		"0.7.50.10: %s – a settlement: 4 pads (drones coming and going), %d shops, '%s', %d guards, bounded by %s (%d), economy area: %s – market: %s" % [String(site["name"]), shops, special, guards, SettleGen.bounds(body), border, String(g.map.econ.get("kind", "?")), "trades" if buy == "" else buy])
	_test_gear_shop(g, town)
	_test_sf_buildings(g, body)


## 0.7.51.6 (Luz: no suburban houses): every building of a settlement is one of the sci-fi architectures – no pitched
## roofs, stone cottages or adobe – each to scale (a storey ~2.6 m), and on a world without air it is sealed.
func _test_sf_buildings(g, body: Dictionary) -> void:
	var archs := {}
	var ok := true
	var sealed_ok := true
	var airless := not Universe.has_atmosphere(body)
	for o in g.map.objects:
		if String(o["kind"]) != "building":
			continue
		var a := String(o.get("arch", ""))
		archs[a] = true
		ok = ok and a in BuildArt.ARCHES
		sealed_ok = sealed_ok and bool(o.get("sealed", false)) == airless
	# each architecture paints, sealed and not, with a door to scale
	var painted := true
	for a2 in BuildArt.ARCHES:
		for sl in [false, true]:
			var img := Image.create(160, 140, false, Image.FORMAT_RGBA8)
			BuildArt.paint(img, {"arch": a2, "storeys": 2, "seed": 7, "sealed": sl, "door": 60}, 160, 140)
			painted = painted and img.get_pixel(68, 125).a > 0.5
	# airless: a test body without air gets sealed buildings
	var dry := {"id": "sf_test_airless", "type": "barren", "name": "Airless"}
	var gm := SettleGen.build({"faction": "assembly"}, dry, {"id": "sf_site", "kind": "outpost", "name": "Sealed"}, {}, GameState.current_system)
	var all_sealed := true
	var n := 0
	for o2 in gm.objects:
		if String(o2["kind"]) == "building":
			n += 1
			all_sealed = all_sealed and bool(o2.get("sealed", false)) and String(o2["arch"]) in BuildArt.ARCHES
	check(ok and sealed_ok and painted and n > 3 and all_sealed and BuildArt.STOREY == 38 and BuildArt.DOOR_H == 30,
		"0.7.51.6: settlement buildings all sci-fi (%s), sealed on airless worlds (%d buildings of an airless outpost all with airlocks), every architecture paints" % [", ".join(archs.keys()), n])


## 0.7.51.2: the Gear shop – a walk-in shop in the settlement; a settlement carries the plain things (no combat
## suits), a military station the combat suits; buying puts it into the pockets, selling pays half; the pilot walks
## about in the suit (another picture than without one, the helmet another again).
func _test_gear_shop(g, town: Dictionary) -> void:
	var GD = preload("res://data/gear.gd")
	var shop_zone := false
	for z in g.map.zones:
		shop_zone = shop_zone or (String(z.get("kind", "")) == "service" and String(z.get("id", "")) == "gear")
	var o: Dictionary = GearShop.offer(town)
	var small_ok: bool = o.has("suit_civil") and not o.has("suit_mil_heavy") and not o.has("suit_mil_light") and o.has("cs_medkit") and o.has("cs_o2")
	var mil := {"id": "test_mil_station", "type": "military", "tier": 3}
	var om: Dictionary = GearShop.offer(mil)
	var mil_ok: bool = om.has("suit_mil_heavy") and om.has("suit_mil_light") and (om["suit_mil_light"] as Array).has("A")
	var gear = GameState.gear
	var c0 := GameState.credits
	var n0: int = gear.count("cs_medkit")
	var b_err := Commands.execute({"type": "gear_buy", "id": "cs_medkit"})
	var bought: bool = b_err == "" and gear.count("cs_medkit") == n0 + 1 and GameState.credits < c0
	var not_here := Commands.execute({"type": "gear_buy", "id": "suit_mil_heavy:A"}) != ""
	var slot := -1
	for i in gear.inv.size():
		if not (gear.inv[i] as Dictionary).is_empty() and String(gear.inv[i]["id"]) == "cs_medkit":
			slot = i
	var c1 := GameState.credits
	var sold: bool = slot >= 0 and Commands.execute({"type": "gear_sell", "slot": slot}) == "" and GameState.credits > c1
	# the pilot in the suit
	var plain := ChibiArt.frame(GameState.pilot.get("look", {}), 0, 0).get_image()
	var lk: Dictionary = g.pilot_look()
	lk["helmet"] = false                                 # (0.7.51.3: on a hostile world it is already on)
	var suited := ChibiArt.frame(lk, 0, 0).get_image()
	lk["helmet"] = true
	var helmed := ChibiArt.frame(lk, 0, 0).get_image()
	var look_ok: bool = String(lk["suit"]) == GD.family(String(gear.suit)) and plain.get_data() != suited.get_data() and suited.get_data() != helmed.get_data() and g.pilot.slung != ""
	check(shop_zone and small_ok and mil_ok and bought and not_here and sold and look_ok,
		"0.7.51.2: the Gear shop – walk-in at %s (%d families), a military station sells combat suits up to A, buy into the pockets, sell for half; the pilot in the suit, the helmet, the weapon slung" % [String(town.get("name", "?")), o.size()])
	_test_gear_shop_page(town)


## 0.7.51.8 (Luz, with a sketch): the Gear shop three steps deep – the front's four picture tiles (as high as the
## window lets them be), a category's kinds as picture tiles, a kind's list with a button per quality; buying from it.
func _test_gear_shop_page(town: Dictionary) -> void:
	var GP = load("res://scripts/ui/station/gear_panel.gd")
	var sp = main.station_panel
	GP.view = ""
	GP.group = ""
	var was_foot: bool = sp.on_foot
	sp.on_foot = true
	sp.open(town, main.view)
	sp.open_service("gear")
	var front: int = _gs_nodes(sp._panel).filter(func(n): return n.get("clicked") != null and String(n.get("kind")) in ["suit", "weapon", "feature", "belt"]).size()
	sp.rebuild()                                     # 0.7.51.9: a rebuild must not stack a second front under the first
	sp.rebuild()
	var front2: int = _gs_nodes(sp._panel).filter(func(n): return n.get("clicked") != null and String(n.get("kind")) in ["suit", "weapon", "feature", "belt"]).size()
	GP.view = "weapon"
	sp.rebuild()
	var kinds: int = _gs_nodes(sp._panel).filter(func(n): return n.get("clicked") != null and String(n.get("kind")) == "group").size()
	GP.group = "wp_kinetic"
	sp.rebuild()
	var qbtns: Array = _gs_nodes(sp._panel).filter(func(n): return n is Button and not (n as Button).disabled and (n as Button).text.length() > 2 and (n as Button).text.substr(1, 1) == "\n" and "FEDCBA".contains((n as Button).text.left(1)))
	var gear = GameState.gear
	var c0 := GameState.credits
	if not qbtns.is_empty():
		(qbtns[0] as Button).pressed.emit()
	var bought: bool = GameState.credits < c0 and _gs_weapons(gear) > 0
	var grows: bool = GP.front_height(1100.0) > GP.front_height(900.0) and GP.front_height(300.0) >= 280.0
	GP.view = ""
	GP.group = ""
	sp.close()
	sp.on_foot = was_foot
	check(front == 4 and front2 == 4 and kinds == 3 and not qbtns.is_empty() and bought and grows,
		"0.7.51.8: the Gear shop – %d picture tiles in front (as high as the window, once only after rebuilds), %d kinds of weapons, a list with quality buttons, bought from it" % [front, kinds])


func _gs_weapons(gear) -> int:
	var n := 0
	for p in gear.inv:
		if not (p as Dictionary).is_empty() and String(p["id"]).begins_with("wp_"):
			n += 1
	return n


func _gs_nodes(n: Node) -> Array:
	var out: Array = []
	for c in n.get_children():
		out.append(c)
		out.append_array(_gs_nodes(c))
	return out


## 0.7.50.5: a city – down through its landing hatch, its hangar, the lifts to the shopping street and the tower bar,
## its services working like a station's, back up through the hatch.
func _test_city(view: SystemView, body: Dictionary, sites_all: Array) -> void:
	var site := {}
	for s in sites_all:
		if String(s["kind"]) == "city":
			site = s
			break
	if site.is_empty():
		var bodies: Array = Universe.get_layout(view.system_id)["planets"] + Universe.get_layout(view.system_id).get("moons", [])
		for b2 in bodies:
			if not Universe.landable(b2):
				continue
			for s2 in Universe.landing_sites(view.system_id, b2):
				if String(s2["kind"]) == "city":
					body = b2
					site = s2
					break
			if not site.is_empty():
				break
	if site.is_empty():
		check(false, "50b: a city to land in")
		return
	var f := GameState.active()
	# the hatch: its doors open and close, the ship sinks; at the end you are in the city
	var h := CityHatch.new()
	main.add_child(h)
	h.open(body, site, true)
	var fin := [false]
	h.finished.connect(func(): fin[0] = true)
	var opened := false
	for i in 240:
		h._update(1.0 / 30.0)
		opened = opened or h._open_k() > 0.99
	var shut := h._open_k() < 0.01
	h.queue_free()
	main.enter_city(body, site)
	var g = main.ground
	var city: Dictionary = Commands.docked_station()
	var in_city: bool = g != null and g.is_city() and g.level == "hangar" and f.docked_at == Universe.city_id(body, site) and city.get("city", false) \
		and String(city.get("name", "")) == String(site["name"]) and g.map.ship_at != Vector2.INF
	# the lifts: shopping street and tower bar
	var lifts_ok := false
	for z in g.map.zones:
		if String(z.get("id", "")) == "lift":
			lifts_ok = String(z["title"]).contains("Tower bar")
	g.go_level("street")
	var shops := 0
	var fronts := 0
	for z2 in g.map.zones:
		if String(z2.get("kind", "")) == "service":
			shops += 1
		if String(z2.get("id", "")).begins_with("front_"):
			fronts += 1
	var street_ok: bool = g.level == "street" and shops >= 2 and fronts >= 3 and g.map.path(g.map.spawn, g.map.wander[0]).size() > 0
	# a shop works like a station's
	var opened_svc := ""
	for z3 in g.map.zones:
		if String(z3.get("kind", "")) == "service" and String(z3.get("closed", "")) == "":
			main._on_deck_use(z3)
			opened_svc = String(z3["id"]) if main.station_panel.visible and main.station_panel.current_service == String(z3["id"]) else ""
			main.station_panel.close()
			break
	g = main.ground
	g.go_level("tower")
	var bar_ok: bool = g.level == "tower" and g._skyline != null and g._bartender != null and g.map.window_rect.size.x > 0.0
	for i2 in 30:
		g._skyline._process(1.0 / 30.0)
	var market_ok := Commands.execute({"type": "market_buy", "item": "food", "amount": 1}) == ""
	check(opened and shut and in_city and lifts_ok and street_ok and opened_svc != "" and bar_ok and market_ok and GameState.codex.unlocked.has("basics_cities"),
		"50b: %s – down through landing hatch %d (opened, shut), the city's hangar; lifts to the shopping street (%d shops, %d shop fronts) and the tower bar (floor %d, the city's skyline); %s opened on foot, the market trades" % [String(site["name"]), h.hatch_no, shops, fronts, g.tower_floor(), opened_svc])
	# 0.7.50.6: four styles, day and night; the street a canyon under the sky; the flight's city on land
	var styles_ok: bool = CityStyle.key_for({"faction": "assembly"}) == "assembly" and CityStyle.key_for({"faction": "covenant"}) == "covenant" 		and CityStyle.key_for({"faction": "directorate"}) == "directorate" and CityStyle.key_for({"faction": "rustmaw"}) == "independent"
	var dn_ok := CityStyle.daylight({"lon": -1.0, "lat": 0.4}) > 0.9 and CityStyle.daylight({"lon": 1.1, "lat": -0.3}) < 0.1 and city.has("day")
	g.go_level("street")
	var canyon := false
	for ch in g._sky.get_children():
		canyon = canyon or ch is CityCanyon
	var fl := FlightScene.new()
	main.add_child(fl)
	fl.open(body, site)
	var on_land: bool = fl._sea.is_empty() or fl._sea[posmod(int(fl._place_at.y), fl._S) * fl._S + posmod(int(fl._place_at.x), fl._S)] == 0
	fl._t = FlightScene.DURATION
	fl._update(0.0)
	var meets: bool = fl._to_screen(fl._place_at).distance_to(fl._ship.position + Vector2(0, -40)) < 30.0
	fl.queue_free()
	check(styles_ok and dn_ok and canyon and on_land and meets,
		"0.7.50.6: city styles (Assembly, Covenant, Directorate, independent), %s by the planet map's light; the shopping street a canyon under the sky; the flight's city on land, coming with the ground" % ("day" if float(city.get("day", 0.0)) > 0.5 else "night"))
	# 0.7.50.7: ground plans by world, the worlds turn, decks in the city's style
	var forms := {}
	for bt in ["terran", "ocean", "jungle", "desert", "ice", "barren"]:
		forms[String(FlightScene.CITY_FORMS.get(bt, "radial"))] = true
	var t_keep := GameState.play_time
	var turned := false
	for h2 in 12:
		GameState.play_time = t_keep + CityStyle.day_length(body) * h2 / 12.0
		var dd := CityStyle.daylight(site, body) > 0.5
		turned = turned or (dd != (float(city.get("day", 0.0)) > 0.5))
	GameState.play_time = t_keep
	g.go_level("hangar", "stairs")
	var flags := 0
	for fd in g.map.face_deco:
		if String(fd.get("kind", "")) in ["flag", "poster"] and fd.has("col2"):
			flags += 1
	var deck_ok: bool = String(g.map.pal.get("type", "")).begins_with("city_") and flags >= 2
	check(forms.size() >= 6 and turned and deck_ok, "0.7.50.7: %d city ground plans by world (harbour, clearings, walled, domes, crater …); the world turns – the city sees day and night; its hangar in its colours with %d flags" % [forms.size(), flags])
	# 0.7.50.8: the day goes on while you are there – the tower bar's view follows it
	g.go_level("tower")
	var d_before: float = g._skyline.day
	var t_keep2 := GameState.play_time
	var live := false
	for h3 in 6:
		GameState.play_time = t_keep2 + CityStyle.day_length(body) * (h3 + 1) / 7.0
		g._update_city_day(1.0)
		live = live or absf(g._skyline.day - d_before) > 0.3
	GameState.play_time = t_keep2
	g._update_city_day(1.0)
	var sc := CityStyle.sunset_color(CityStyle.star_color(view.system_id))
	check(live and sc.r > sc.b, "0.7.50.8: the day goes on while you are in the city – the view from the bar follows it (dusk in the star's light, sunset colour %s)" % sc.to_html(false))
	# 0.7.50.9: guards – posted and on patrol, in the power's uniform, they speak; no weapons drawn in the city
	var guards := 0
	var patrols := 0
	for lv in ["hangar", "street", "tower"]:
		g.go_level(lv, "stairs" if lv == "hangar" else "lift")
		for w in g.people:
			if w.guard:
				guards += 1
				if not w.patrol.is_empty():
					patrols += 1
	g.go_level("street")
	var gw = null
	for w2 in g.people:
		if w2.guard:
			gw = w2
			break
	var spoke := false
	if gw != null:
		g._arrive = 0.0
		g.pilot.pos = gw.pos + Vector2(10, 0)
		g._process(0.016)
		spoke = String(g.zone.get("kind", "")) == "guard" and g.use() and g._toast != ""
	check(guards >= 3 and patrols >= 1 and spoke, "0.7.50.9: %d city guards in hangar, street and tower bar (%d on patrol) – spoken to: %s" % [guards, patrols, g._toast])
	# and up again through the hatch
	g.go_level("hangar", "stairs")
	var back_body := Universe.find_body(f.system_id, String(city.get("body", "")))
	main.close_deck(false)
	main._city_hatch(back_body, {"id": String(city.get("site", "")), "name": String(city.get("name", "")), "kind": "city"}, false)
	var hu: CityHatch = main.hatch
	var guard := 0
	var up_ok: bool = hu != null and not hu.down and not back_body.is_empty()
	if hu != null:
		hu._update(CityHatch.UP_TIME + 0.1)
	guard = 0
	while not view._descent.is_empty() and guard < 600:
		view._update_descent(1.0 / 30.0)
		guard += 1
	check(up_ok and f.docked_at == "" and main.ground == null, "50b: out of the city – up through the hatch and back to orbit")


## Package 40b: gates in six styles by whose system it is; old gates are slower and now and then fling the ship out.
func _test_gates40(view: SystemView) -> void:
	var U = Universe
	# 0.6.40.6: no route classes – every route is open to any jump drive; a better drive is faster and steadier
	var one := true
	for sy0 in U.systems:
		for nb0 in sy0["links"]:
			one = one and int(sy0["links"][nb0]) == 1
	var f_mk1 := GameState.create_from_preset("std_mule", "player")
	f_mk1.modules["hyperdrive"] = "hyperdrive:2:C"
	f_mk1.mark_dirty()
	var far_sid := -1
	for sy1 in U.systems:
		if sy1.get("outer", false):
			far_sid = int(sy1["id"])
			break
	var path_far: Array = U.find_path(U.home_system, far_sid, GameState.drive_grade(f_mk1))
	var f_mk3 := GameState.create_from_preset("std_mule", "player")
	f_mk3.modules["hyperdrive"] = "hyperdrive:6:C"
	f_mk3.mark_dirty()
	var faster: bool = GameState.jump_duration(U.home_system, f_mk3) < GameState.jump_duration(U.home_system, f_mk1)
	check(one and not path_far.is_empty() and faster,
		"0.6.40.6: no route classes – a Mk I jump drive reaches the Far Reaches (%d jumps); a Mk III jumps faster (%.1f s vs %.1f s) and steadies old gates" % [path_far.size(), GameState.jump_duration(U.home_system, f_mk3), GameState.jump_duration(U.home_system, f_mk1)])
	var styles := {}
	var rule_ok := true
	for sy in U.systems:
		var sid: int = sy["id"]
		var st: String = U.gate_style(sid)
		styles[st] = true
		var f := String(sy.get("faction", ""))
		if f in ["assembly", "covenant", "directorate"]:
			rule_ok = rule_ok and st == f
		elif sy.get("belt", false) and not sy.get("independent", false) and f == "":
			rule_ok = rule_ok and st == ("pirate" if sy.get("fortress", false) else "old")     # 40d: fortresses patch their gates
	var gate_ok := true
	for g in view.layout["gates"]:
		gate_ok = gate_ok and String(g.get("style", "")) == U.gate_style(view.system_id)
	var tex_ok := true
	var seen := {}
	for st2 in PixelArt.GATE_STYLES:
		var im: Image = PixelArt.gate_texture_styled(2, st2).get_image()
		tex_ok = tex_ok and im.get_width() == 81
		seen[im.get_data().hex_encode().sha256_text()] = true
	check(styles.has("old") and styles.has("independent") and rule_ok and gate_ok and tex_ok and seen.size() == 6,
		"40b: gates by whose system it is – the powers' own, independent, old ones in the empty Rim, patched pirate gates (%d styles in the cluster), six distinct drawings" % styles.size())
	# old gates: longer jumps; a misjump flings the ship out somewhere and hurts – never fatally
	var old_sid := -1
	for sy2 in U.systems:
		if U.gate_style(int(sy2["id"])) == "old":
			old_sid = int(sy2["id"])
			break
	var slow: bool = GameState.jump_duration(old_sid) > GameState.jump_duration(Universe.home_system) * 1.4
	var f2 := GameState.create_from_preset("std_mule", "player")
	f2.system_id = old_sid
	var nb: int = int(U.systems[old_sid]["links"].keys()[0])
	f2.system_id = nb
	var s0 := f2.stats()
	f2.armor = float(s0["armor_max"])
	f2.structure = float(s0["structure_max"])
	var keep_pa: Dictionary = GameState.pending_arrival.duplicate()
	GameState._misjump(f2, old_sid)
	GameState.pending_arrival = keep_pa
	var gpos: Vector2 = U.get_gate_pos(nb, old_sid)
	var thrown: bool = f2.position.distance_to(gpos) > 20000.0
	var hurt: bool = f2.armor < float(s0["armor_max"]) and f2.structure >= float(s0["structure_max"]) * 0.25
	check(old_sid >= 0 and slow and thrown and hurt,
		"40b: an old gate's jump takes longer (%.1f s); when its field breaks the ship is flung out far from the gate and damaged, never destroyed" % GameState.jump_duration(old_sid))


func _belt_empty() -> int:
	for sy in Universe.systems:
		if sy.get("belt", false) and not Universe.is_independent(int(sy["id"])):
			return int(sy["id"])
	return 0


func _test_mining41(view: SystemView) -> void:
	var U = Universe
	var GD = GameData
	var new_ok := true
	for cid in ["copper_ore", "tungsten_ore", "gold_ore", "uraninite", "spodumene", "graphite_ore", "quartz", "monazite", "nitrogen_ice", "dry_ice", "osmium_ore", "palladium_ore",
			"hydrogen", "xenon", "phosphine", "fluorine", "circuits", "fuel_rods", "medical_isotopes"]:
		new_ok = new_ok and GD.commodities.has(cid)
	var deep_in_field := false
	var deep_cols := 0
	var purities := {}
	for sid in U.systems.size():
		var L: Dictionary = U.get_layout(sid)
		for a in L["asteroids"]:
			deep_in_field = deep_in_field or bool(GD.commodities[String(a["ore"])].get("deep", false))
			purities[U.purity_grade(a)] = true
		for co in L.get("colossi", []):
			deep_cols += 1 if float(co.get("deep_amount", 0.0)) > 0.0 else 0
	check(new_ok and not deep_in_field and deep_cols > 0 and purities.size() == 3,
		"41: new ores, gases, components; osmium and palladium only deep in colossi (%d), asteroids of low / medium / high purity" % deep_cols)
	# storage: gases twice the room in racks, efficient in tanks; radioactive goods want shielded racks
	var f := GameState.create_from_preset("std_mule", "player")
	f.cargo.clear()
	var free0 := f.cargo_free()
	f.add_cargo("hydrogen", 10.0)
	var gas_double: bool = is_equal_approx(free0 - f.cargo_free(), 20.0)
	f.cargo.clear()
	f.add_cargo("uraninite", 5.0)
	f.add_cargo("thorium", 2.0)
	var exposed: bool = f.unshielded_rad() > 0.0
	f.modules["optional_0"] = "o_shielded:3:C"
	f.modules["optional_1"] = "o_gastank:3:C"
	f.mark_dirty()
	var shield_cap := float(f.stats()["rad_cargo_max"])
	var shielded: bool = f.unshielded_rad() <= 0.001 if shield_cap >= 5.6 else f.unshielded_rad() < 5.6
	f.cargo.clear()
	var free1 := f.cargo_free()
	f.add_cargo("hydrogen", 10.0)
	var in_tank: bool = is_equal_approx(f.cargo_free(), free1)
	var less_room: bool = float(GD.modules["o_shielded:3:C"]["rad_cargo"]) < float(GD.modules["o_cargo:3:C"]["cargo"]) * 0.5
	check(gas_double and exposed and shielded and in_tank and less_room,
		"41: gases take twice the room in cargo racks and their own in gas tanks; radioactive goods outside shielded racks expose the crew; shielded racks hold far less")
	var hud = view.get_tree().current_scene.hud if view.get_tree().current_scene.get("hud") != null else null
	if hud != null and hud.has_method("radiation_banner"):
		var act := GameState.active()
		var keep_cargo: Dictionary = act.cargo.duplicate()
		var keep_dock: String = act.docked_at
		act.docked_at = ""
		act.cargo["enriched_uranium"] = 2.0
		var rb: Dictionary = hud.radiation_banner()
		act.cargo = keep_cargo
		act.docked_at = keep_dock
		check(not rb.is_empty() and String(rb["text"]).begins_with("RADIATION"), "41: unshielded radioactive cargo raises the red RADIATION warning (with an alarm)")
	# components at a station's fabricators
	var st: Dictionary = {}
	for st_c in view.layout["stations"]:
		if Industry.can_fabricate_here(st_c):
			st = st_c
			break
	if not st.is_empty():
		var g := GameState.create_from_preset("std_mule", "player")
		g.cargo.clear()
		g.add_cargo("copper", 6.0)
		g.add_cargo("silicon", 4.0)
		var cr0 := GameState.credits
		GameState.credits = 100000
		var err := Industry.fabricate(g, st, "circuits", 5)
		var job: Dictionary = GameState.jobs_at(String(st["id"]), "fab").back() if not GameState.jobs_at(String(st["id"]), "fab").is_empty() else {}
		GameState._advance_station_jobs(9999.0)
		if not job.is_empty():
			GameState.collect_job(g, job)
		var comp_ok: bool = err == "" and is_equal_approx(float(g.cargo.get("circuits", 0.0)), 2.0) and float(g.cargo.get("copper", 0.0)) < 0.01
		GameState.credits = cr0
		check(comp_ok, "41: components from refined materials at a station's fabricators (2 circuit boards from 6 copper and 4 silicon)")
	# gas giants, the band and the harvest
	var giant := {}
	for pl in view.layout["planets"]:
		if U.GAS_YIELDS.has(String(pl["type"])):
			giant = pl
			break
	var c0 := Vector2(1000, 0)
	var band_ok: bool = SystemView.band_depth(c0 + Vector2(120, 0), c0, 100.0) < SystemView.band_depth(c0 + Vector2(80, 0), c0, 100.0) 		and SystemView.band_depth(c0 + Vector2(150, 0), c0, 100.0) < 0.0 and U.GAS_YIELDS.size() == 4
	var far_all := true
	for pl2 in view.layout["planets"]:
		if U.GAS_YIELDS.has(String(pl2["type"])):
			far_all = far_all and view.player.position.distance_to(pl2["pos"]) > float(pl2["radius"]) * view.GAS_NEAR
	if far_all:
		band_ok = band_ok and view.gas_band(view.player.position).is_empty()          # far away: no band, however it looks
	var kj: Dictionary = GD.hulls.get("kujira", {})
	var kf := GameState.create_from_preset("std_kujira", "player")
	var has_scoop := false
	for b in kf.builtin_modules():
		has_scoop = has_scoop or String(b["data"].get("tool", "")) == "gas"
	var tex: Texture2D = PixelArt.ship_texture("kujira", "player")
	check(band_ok and not kj.is_empty() and float(kf.stats()["gas_cargo_max"]) >= 1500.0 and has_scoop and float(kj["heat_resist"]) > 0.0 and tex.get_width() > 100,
		"41: harvest bands round the giants (deeper = more), each kind its own gases; the Kujira – 1,600 m³ of gas tanks, a built-in scoop, heat resistant")
	var ship: Ship = view.player
	# every tool kind has a name (the Modules tab crashed on the gas collector in 0.6.41.2)
	var names_ok := true
	for mid41 in GameData.modules:
		var md41: Dictionary = GameData.modules[mid41]
		if md41.has("tool"):
			names_ok = names_ok and GameData.TOOL_NAMES.has(String(md41["tool"])) and GameData.module_summary(mid41) != ""
	for bm41 in kf.builtin_modules():
		if bm41["data"].has("tool"):
			names_ok = names_ok and GameData.TOOL_NAMES.has(String(bm41["data"]["tool"]))
	check(names_ok, "41: every tool – the gas collector and deep drill too – has a name and a summary (Modules tab)")
	# switching the collector on needs no target (it crashed in 0.6.41.1 on the empty target)
	var gslot := ""
	for gk in ship.fit.modules:
		if String(gk).begins_with("tool"):
			gslot = gk
			break
	if gslot != "":
		var gkeep: String = ship.fit.modules[gslot]
		ship.fit.modules[gslot] = "t_gas:1:C"
		ship.fit.mark_dirty()
		var gerr := ship.set_module_active(gslot, true)
		var smg: ShipMenu = view.get_tree().current_scene.ship_menu
		smg.open(view, 1)                         # the Modules tab with the collector fitted (crashed in 0.6.41.2)
		var tab_ok: bool = smg.visible
		smg.close()
		# the Inventory and Info tabs show the gas tanks and shielded racks (with gas in the hold)
		var okeep: String = ship.fit.modules.get("optional_0", "")
		ship.fit.modules["optional_0"] = "o_gastank:2:C"
		ship.fit.mark_dirty()
		ship.fit.add_cargo("hydrogen", 3.0)
		smg.open(view, 3)
		var inv_text := ""
		for lb in smg.find_children("*", "Label", true, false):
			inv_text += (lb as Label).text + "\n"
		smg.open(view, 0)
		smg.close()
		ship.fit.remove_cargo("hydrogen", 3.0)
		ship.fit.modules["optional_0"] = okeep
		ship.fit.mark_dirty()
		check(inv_text.contains("GAS TANKS") and inv_text.contains("(gas)"), "41: the Inventory shows the gas tanks (used / room) and which goods are gas")
		gerr = gerr if tab_ok else "Modules tab did not open"
		ship.set_module_active(gslot, false)
		ship.fit.modules[gslot] = gkeep
		ship.fit.mark_dirty()
		check(gerr == "" and kj.has("hatches"), "41: the gas collector switches on without a target; the Kujira takes its gas in through a drone hatch")
	var a0: float = ship.fit.armor + ship.fit.structure
	ship.heat_damage(5.0)
	check(ship.fit.armor + ship.fit.structure < a0 - 4.9, "41: heat and pressure go past the shields into armour and hull")
	ship.fit.armor = minf(ship.fit.armor + 5.0, float(ship.fit.stats()["armor_max"]))


func _with_progress(m: Dictionary) -> Dictionary:
	var d := m.duplicate()
	d["progress"] = int(d["amount"])
	return d


func _test_planets(view: SystemView) -> void:
	var U = Universe
	var seen := {}
	var dwarf_ok := true
	var giant_ok := true
	var way_dwarf := 0
	var city_ok := true
