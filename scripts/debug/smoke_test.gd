		# (Luz) energy: the charging points fill you up and are drawn dry for a while; the three carry energy and rounds,
		# cannot shoot without, run to a point that is ready and fill up there
		var sts: Array = g.map.get_meta("col_stations", [])
		var e_ok := false
		if foes.size() == 3 and sts.size() == CD.STATIONS:
			var all_have: bool = foes.all(func(f): return float(f["energy"]) > 0.0 and int(f["ammo"]) > 0 and bool(f["aware"]) and (f["stations"] as Array).size() == CD.STATIONS)
			GameState.gear.energy = 1.0
			g.zone = (g.map.zones as Array).filter(func(z): return String(z.get("kind", "")) == "col_charge" and int(z.get("i", -1)) == 3)[0]
			g.use()
			var full_e: bool = float(GameState.gear.energy) == float(GameState.gear.totals()["energy"]) and is_equal_approx(float(sts[3]["cool"]), CD.STATION_COOL)
			GameState.gear.energy = 1.0
			g.use()
			var dry: bool = float(GameState.gear.energy) == 1.0
			GameState.gear.energy = float(GameState.gear.totals()["energy"])
			var fe: Dictionary = foes[2]
			var could: bool = g.combat.foe_power(fe)
			fe["energy"] = 0.0
			fe["ammo"] = 0
			var cannot: bool = not g.combat.foe_power(fe)
			var tr0 := Time.get_ticks_msec()
			while Time.get_ticks_msec() - tr0 < 4000 and String(fe["state"]) != "recharge":
				await get_tree().process_frame
			var runs: bool = String(fe["state"]) == "recharge" and (fe["path"] as PackedVector2Array).size() > 0 and float((fe["station"] as Dictionary)["cool"]) == 0.0 \
				and int((fe["station"] as Dictionary)["i"]) != 3
			if runs:
				var fw: Walker = fe["w"]
				fw.pos = (fe["station"] as Dictionary)["at"]
				fw.position = fw.pos * GroundMap.SCALE
			for f3b in 6:
				await get_tree().process_frame
			e_ok = all_have and full_e and dry and could and cannot and runs and float(fe["energy"]) > 0.0 and int(fe["ammo"]) > 0 and String(fe["state"]) != "recharge" \
				and float((fe["station"] as Dictionary)["cool"]) > 0.0 and g._world.get_children().any(func(nd): return is_instance_of(nd, CV.VrFx) and (nd.stations as Array).size() == CD.STATIONS)
			if not e_ok:
				print("COLFIGHT62A energy: all ", all_have, " full ", full_e, " dry ", dry, " could ", could, " cannot ", cannot, " runs ", runs, " foe ", fe["energy"], " ", fe["ammo"], " ", fe["state"], " stations ", sts)
			if shots:
				g.story_cam = (sts[2]["at"] as Vector2) + Vector2(0.0, -20.0)
				for f3c in 40:
					await get_tree().process_frame
				get_viewport().get_texture().get_image().save_png("res://Claude outputs/col62a4_ladestation.png")
				g.story_cam = Vector2.INF
		fight_ok = fight_ok and e_ok
		# a foe really goes down when shot; all three out is a win: Coins, gear points, rank points, the next round
		if foes.size() == 3:
			g.combat._hurt_foe(foes[1], 9999.0, "kinetic")
			g.combat._hurt_foe(foes[2], 9999.0, "kinetic")
		var two_left: bool = g.combat.alive().size() == 1 and String(g._col_fight.get("state", "")) == "fight"
		if foes.size() == 3:
			g.combat._hurt_foe(foes[0], 9999.0, "kinetic")
		var tw := Time.get_ticks_msec()
		while Time.get_ticks_msec() - tw < 8000 and not (g.minigame != null and g.minigame.has_method("is_col_result")):
			await get_tree().process_frame
		var rw: Dictionary = CD.reward(1)
		var st: Dictionary = GameState.col_state()
		win_ok = two_left and g.minigame != null and g.minigame.has_method("is_col_result") and bool(g.minigame.res.get("won", false)) and GameState.coins == 100 + int(rw["coins"]) \
			and int(st["points"]) == int(rw["points"]) and int(st["xp"]) == int(rw["xp"]) and int(st["round"]) == 2 and int(st["streak"]) == 1 and int(st["fights"]) == 1 \
			and String(Commands.execute({"type": "col_fight_end", "won": true})) == "" and int(GameState.col_state()["round"]) == 3
		GameState.col_state()["round"] = 2                       # (that second call was only to see it goes through the bus)
		GameState.col_state()["points"] = int(rw["points"])
		if shots and g.minigame != null:
			for f5 in 40:
				await get_tree().process_frame
			get_viewport().get_texture().get_image().save_png("res://Claude outputs/col62a4_sieg.png")
		if g.minigame != null and g.minigame.has_method("is_col_result"):
			g.minigame._t = 2.0
			g.minigame.go(true)                              # on to the next round: the fighters' room again
		for f6 in 10:
			await get_tree().process_frame
		win_ok = win_ok and String(g.level) == "zcolin" and GameState.col_own_gear == null and String(GameState.gear.suit) == own_suit and g.minigame != null and g.minigame.has_method("is_col_prep") \
			and (g._col_fight as Dictionary).is_empty()
		if not win_ok:
			print("COLFIGHT62A win: two left ", two_left, " window ", g.minigame, " coins ", GameState.coins, " state ", GameState.col_state(), " level ", g.level, " own gear ", GameState.col_own_gear)
		# the second fight: no full entrance needed (it can be cut short); you go down: the run ends, the rank stays
		if g.minigame != null and g.minigame.has_method("is_col_prep"):
			g._col_prep_done(true)
		for f7 in 20:
			await get_tree().process_frame
		var again: bool = String(g.level) == "zcolar" and not (g._col_intro as Dictionary).is_empty()
		g._col_fight_start()                                 # (as holding Esc or Options does)
		for f8 in 5:
			await get_tree().process_frame
		var tq := Time.get_ticks_msec()
		while Time.get_ticks_msec() - tq < 8000 and String(g._col_fight.get("state", "")) == "count":
			await get_tree().process_frame
		var xp_before: int = int(GameState.col_state()["xp"])
		var second: bool = String(g.level) == "zcolvr" and String(g._col_fight.get("state", "")) == "fight" and g.combat != null and g.combat.alive().size() == 3
		g.zone = _zone_of(g.map, "col_giveup")
		g.use()
		for f9 in 5:
			await get_tree().process_frame
		var asked: bool = g._lift_menu != null
		g._close_lift_menu()
		GameState.gear.health = 5.0
		g.combat._hurt_pilot(9999.0, "kinetic")
		var down: bool = g.col_lost and float(GameState.gear.health) > 0.0 and not g._collapsed
		var tl2 := Time.get_ticks_msec()
		while Time.get_ticks_msec() - tl2 < 8000 and not (g.minigame != null and g.minigame.has_method("is_col_result")):
			await get_tree().process_frame
		var st2: Dictionary = GameState.col_state()
		lose_ok = again and second and asked and down and g.minigame != null and g.minigame.has_method("is_col_result") and not bool(g.minigame.res.get("won", true)) \
			and int(st2["points"]) == 0 and int(st2["round"]) == 1 and int(st2["streak"]) == 0 and int(st2["xp"]) == xp_before and int(st2["fights"]) >= 2 and int(st2["best"]) >= 1 \
			and String(st2["fit"]["suit"]) == "suit_civil:F"
		if shots and g.minigame != null:
			for f10 in 40:
				await get_tree().process_frame
			get_viewport().get_texture().get_image().save_png("res://Claude outputs/col62a4_niederlage.png")
		if g.minigame != null and g.minigame.has_method("is_col_result"):
			g.minigame._t = 2.0
			g.minigame.go(true)
		for f11 in 10:
			await get_tree().process_frame
		lose_ok = lose_ok and String(g.level) == "zcolin" and g.minigame == null and GameState.col_own_gear == null and String(GameState.gear.suit) == own_suit and g.input_enabled
		if not lose_ok:
			print("COLFIGHT62A defeat: again ", again, " second ", second, " asked ", asked, " down ", down, " window ", g.minigame, " state ", st2, " level ", g.level)
	check(rule_ok and map_ok and intro_ok and fight_ok and win_ok and lose_ok,
		"62a, part 4: the fight: the rank (it stays; a larger budget and a better quality with every rank), opponents by lot with a named one every tenth round, three settings of the fight's ground larger than the arena; the entrance (the round from above, the far gate, the three walk in, the picture of them against you, the hologram comes up); the crowd's applause, louder the fuller the stands; the fight in the house's gear with your own put by and saved as yours; charging points that fill you up and are drawn dry for a while, the three living on energy and rounds and running to a point when dry; the count; all three out is a win (Coins, gear points, rank points, the next round, on into the fighters' room); you go down or give up: the run ends, its gear points are gone, the rank stays; back in your own gear  [%s %s %s %s %s %s]" % [rule_ok, map_ok, intro_ok, fight_ok, win_ok, lose_ok])
	GameState.col_gear_off()
	CG.gate_open = 0.0
	CG.boot = 0.0
	if main.ground != null and is_instance_valid(main.ground):
		main.close_deck(false)
	main.station_panel.close()
	if Commands.world != null and is_instance_valid(Commands.world):
		Commands.world.remove_player()
	GameState.from_dict(snap)
	GameState.play_time = t_keep
	main.load_system(GameState.current_system)
	GameState.active_changed.emit()
	for i9 in 30:
		await get_tree().process_frame
	for wl9 in 900:
		if main.loading == null or not is_instance_valid(main.loading):
			break
		await get_tree().process_frame


func _test_casino62(_view: SystemView) -> void:
	var Gen = load("res://scripts/ground/centauria_gen.gd")
	var shot_mode := OS.get_environment("CTR_SHOTS")
	var shots := shot_mode != ""
	var snap: Dictionary = GameState.to_dict()
	var t_keep := GameState.play_time
	Commands.cheats_enabled = true
	# every floor as a map: two capsules with free ground before them, places to stroll that are free, what belongs on it
	var maps_ok: bool = Gen.CAS_FLOORS.size() == 6 and Gen.CAS_W.size() == 6 and Gen.CAS_ALT.size() == 6
	for qf in Gen.CAS_FLOORS.size():
		var qm: GroundMap = Gen.build_casino({}, qf, true)
		var qz: Array = qm.zones
		var qp: Array = qm.get_meta("cas_props", [])
		var qcaps: Array = qm.get_meta("cas_lifts", [])
		var one: bool = qm.w == int(Gen.CAS_W[qf]) and qm.h == int(Gen.CAS_HH[qf]) and qm.lifts.is_empty() and qcaps.size() == 2 \
			and qcaps.all(func(c): return qm.free_at((c as Vector2) + Vector2(0.0, 7.0), 4.0)) \
			and qz.any(func(z): return String(z.get("kind", "")) == "ctr_clift") \
			and qm.wander.size() >= 6 and (qm.wander as Array).all(func(p): return qm.free_at(p, 4.0)) and (qf == 0 or qf == 5 or int(Gen.CAS_W[qf]) <= int(Gen.CAS_W[qf - 1])) \
			and qm.has_meta("cas_window") == (qf != 0 and qf != 3) and qm.has_meta("cas_views") == (qf == 0 or qf == 3 or qf == 5) \
			and (qf == 0 or float(Gen.CAS_ALT[qf]) > float(Gen.CAS_ALT[qf - 1])) \
			and (qm.people as Array).all(func(p): return not (String(p.get("role", "")) in ["keeper", "bartender"]) or not (p.get("look", {}) as Dictionary).is_empty())
		match qf:
			0:
				one = one and qz.any(func(z): return String(z.get("kind", "")) == "ctr_cashier") and qz.any(func(z): return String(z.get("id", "")) == "cas_out" and String(z.get("to", "")) == "zplaza") \
					and qm.free_at(qm.get_meta("from_plaza"), 4.0) and qm.has_meta("cas_chandelier")
			1:
				one = one and qp.filter(func(p): return String(p["kind"]) == "slot").size() >= 40
			2:
				one = one and qp.filter(func(p): return String(p["kind"]) == "roulette").size() == 2 and qp.filter(func(p): return String(p["kind"]) == "cards").size() == 3 \
					and qp.filter(func(p): return String(p["kind"]) == "poker").size() == 1 and qz.any(func(z): return String(z.get("kind", "")) == "drift")
			3:
				one = one and qp.filter(func(p): return String(p["kind"]) == "seats").size() == 3 \
					and qz.filter(func(z): return String(z.get("id", "")).begins_with("cas_bets") and String(z.get("kind", "")) == "ctr_bets").size() == 2 \
					and qz.filter(func(z): return String(z.get("kind", "")) == "ctr_watch").size() == 3 \
					and qp.filter(func(p): return String(p["kind"]) == "odds").size() == 4
			4:
				one = one and qp.any(func(p): return String(p["kind"]) == "piano") and (qm.people as Array).any(func(p): return String(p.get("role", "")) == "bartender")
			_:
				# (Luz) the lounge: the three high tables, five platforms each with a dancer, the DJ, the dance floor full,
				# the pool (nobody walks into it), the terrace under the sky, the way through the wall of glass, guests
				# in the looks of the rich, nobody without a look
				var qdeck: Rect2 = qm.get_meta("cas_terrace", Rect2())
				var qpool: Rect2 = qm.get_meta("cas_pool", Rect2())
				var qdoor: Rect2 = qm.get_meta("cas_door", Rect2())
				var qhall := Vector2(20.0, float(Gen.C_F0) + 9.5) * GroundMap.TILE
				one = one and ["roulette", "cards", "poker"].all(func(k): return qp.filter(func(p): return String(p["kind"]) == k and bool(p.get("hi", false))).size() == 1) \
					and qp.filter(func(p): return String(p["kind"]) == "podium").size() == 5 and qp.filter(func(p): return String(p["kind"]) == "flame").size() == 4 \
					and qp.any(func(p): return String(p["kind"]) == "dj") and qz.filter(func(z): return String(z.get("id", "")).begins_with("cas_high")).size() == 3 \
					and (qm.people as Array).filter(func(p): return bool(p.get("dance", false))).size() >= 15 \
					and (qm.people as Array).any(func(p): return String(p.get("role", "")) == "bartender") \
					and (qm.people as Array).all(func(p): return not (p.get("look", {}) as Dictionary).is_empty()) \
					and (qm.people as Array).filter(func(p): return String(p.get("role", "")) == "" and not bool(p.get("sit", false))).size() >= 12 \
					and qdeck.size.x > 300.0 and qpool.size.x > 200.0 and qdeck.encloses(qpool) and qm.has_meta("cas_dfloor") and qm.has_meta("cas_dark") and qm.has_meta("cas_canvas") \
					and not qm.free_at(qpool.get_center(), 4.0) and qm.free_at(qdoor.get_center(), 4.0) and qm.free_at(qdeck.get_center(), 4.0) \
					and not qm.path(qhall, qdeck.get_center() + Vector2(0.0, 40.0)).is_empty() \
					and (qm.objects as Array).filter(func(o): return String(o.get("kind", "")) == "lounger").size() == 6
				if not one:
					print("CAS62 lounge: props ", qp.map(func(p): return String(p["kind"])), " dance ", (qm.people as Array).filter(func(p): return bool(p.get("dance", false))).size(),
						" path ", qm.path(qhall, qdeck.get_center() + Vector2(0.0, 40.0)).size(), " deck ", qdeck, " pool ", qpool)
		if not one:
			print("CAS62 map ", qf, ": w ", qm.w, " h ", qm.h, " caps ", qcaps, " wander ", qm.wander.size(), " props ", qp.size())
		maps_ok = maps_ok and one
	# down to Centauria, out onto the plaza, up the stair
	Commands.execute({"type": "debug_special", "special": "fern"})
	for i in 40:
		await get_tree().process_frame
	for wl in 900:
		if main.loading == null or not is_instance_valid(main.loading):
			break
		await get_tree().process_frame
	main.station_panel.close()
	var sid := Universe.special_system("fern")
	var pel := ""
	for mo in Universe.get_layout(sid)["moons"]:
		if String(mo["name"]) == "Pelagia":
			pel = String(mo["id"])
	var err := String(Commands.execute({"type": "debug_land", "body": pel, "kind": "city"}))
	var tm := Time.get_ticks_msec()
	while Time.get_ticks_msec() - tm < 40000:
		await get_tree().process_frame
		if main.ground != null and is_instance_valid(main.ground) and main.ground.input_enabled and String(main.ground.level) == "hangar":
			break
	var g = main.ground
	var land_ok: bool = g != null and is_instance_valid(g) and g.is_centauria()
	if not land_ok:
		print("CAS62 land: err ", err)
	var in_ok := false
	var coin_ok := false
	var lift_ok := false
	var ride_ok := false
	var vip_ok := false
	var out_ok := false
	if land_ok:
		if shots:
			Commands.execute({"type": "debug_daytime", "phase": "night"})
		g.go_level("zplaza", "from_station")
		for f0 in 10:
			await get_tree().process_frame
		for zp in g.map.zones:
			if String(zp.get("id", "")) == "ctr_casino":
				g.zone = zp
		g.use()
		for f1 in 10:
			await get_tree().process_frame
		in_ok = String(g.level) == "zcasino" and int(g.ctr_floor) == 0 and g.map.free_at(g.pilot.pos, 4.0) and String(g._title.text).contains("Lobby") \
			and g._world.get_children().any(func(nd): return nd.has_method("_chandelier") and String(nd.part) == "wall") \
			and g._sorted.get_children().filter(func(nd): return nd.has_method("_chandelier") and String(nd.part) == "prop").size() == 11 \
			and (g._cas_doors as Array).size() == 2
		if not in_ok:
			print("CAS62 in: level ", g.level, " floor ", g.ctr_floor, " title ", g._title.text, " doors ", (g._cas_doors as Array).size())
		# the cashier: Coins for credits and back for a little less; too many either way is refused; they are saved
		var cr0: int = GameState.credits
		GameState.credits = 100000
		GameState.coins = 0
		var e1 := String(Commands.execute({"type": "coins_buy", "n": 100}))
		var a1: bool = e1 == "" and GameState.coins == 100 and GameState.credits == 100000 - 100 * GameState.COIN_BUY
		var e2 := String(Commands.execute({"type": "coins_sell", "n": 40}))
		var a2: bool = e2 == "" and GameState.coins == 60 and GameState.credits == 100000 - 100 * GameState.COIN_BUY + 40 * GameState.COIN_SELL
		var a3: bool = String(Commands.execute({"type": "coins_buy", "n": 100000})) != "" and String(Commands.execute({"type": "coins_sell", "n": 61})) != "" \
			and String(Commands.execute({"type": "coins_buy", "n": 0})) != "" and GameState.coins == 60 and int(GameState.to_dict()["coins"]) == 60 \
			and GameState.COIN_SELL < GameState.COIN_BUY
		g.zone = _zone_of(g.map, "ctr_cashier")
		g.use()
		for f2 in 5:
			await get_tree().process_frame
		var ckeys: Array = g._lift_menu.get_meta("keys", []) if g._lift_menu != null else []
		if shot_mode == "1":
			g.story_cam = Vector2(Gen.CAS_W[0] - 14.0, Gen.C_F0 + 3.0) * GroundMap.TILE
			for f3 in 40:
				await get_tree().process_frame
			get_viewport().get_texture().get_image().save_png("res://Claude outputs/cas62_kasse.png")
			g.story_cam = Vector2.INF
		g._close_lift_menu()
		coin_ok = a1 and a2 and a3 and ckeys.size() == 6          # package 63: the house's prize is the fifth of six
		if not coin_ok:
			print("CAS62 coins: ", e1, " | ", e2, " coins ", GameState.coins, " credits ", GameState.credits, " keys ", ckeys.size())
		# (Luz) part 2: the machines and the wheel. The numbers first: the house keeps its edge, a kind hand (Dexterity,
		# the perk Lucky Hand) makes it smaller and never turns it round
		var CasD = load("res://data/casino.gd")
		var srng := RandomNumberGenerator.new()
		srng.seed = 6202
		var rtp := [0.0, 0.0]
		for li in 2:
			var got := 0
			for sp in 60000:
				got += int(CasD.spin(srng, [0.0, CasD.slot_luck(8, true)][li], 1, 0)["win"])
			rtp[li] = got / 60000.0
		var wrtp := [0.0, 0.0]
		for li2 in 2:
			var gotw := 0
			for sp2 in 60000:
				gotw += int(CasD.settle({"red": 1}, int(CasD.roll(srng, [0.0, CasD.wheel_luck(8, true)][li2], {"red": 1})["n"])))
			wrtp[li2] = gotw / 60000.0
		var num_ok: bool = float(rtp[0]) > 0.78 and float(rtp[0]) < 0.95 and float(rtp[1]) > float(rtp[0]) and float(rtp[1]) < 1.0 \
			and float(wrtp[0]) > 0.95 and float(wrtp[0]) < 0.995 and float(wrtp[1]) > float(wrtp[0]) and float(wrtp[1]) < 1.0 \
			and CasD.bet_pays("n17", 17) == 36 and CasD.bet_pays("d2", 17) == 3 and CasD.bet_pays("c2", 17) == 3 and CasD.bet_pays("red", 0) == 0 and CasD.bet_pays("black", 17) == 2 \
			and CasD.WHEEL.size() == 37 and CasD.REDS.size() == 18 and not CasD.bet_ok("n37") and CasD.bet_ok("c3") and CasD.slot_luck(3, false) == 0.0
		if not num_ok:
			print("CAS62 numbers: slots ", rtp, " wheel ", wrtp)
		# a machine: the zone opens its window, a pull takes the stake and pays what the reels show, the jackpot grows
		g._ctr_floor_go(1, true)
		for fs0 in 8:
			await get_tree().process_frame
		g.zone = _zone_of(g.map, "ctr_slot")
		g.use()
		for fs1 in 5:
			await get_tree().process_frame
		var slot_ok: bool = g.minigame != null and g.minigame.has_method("slot_result")
		if slot_ok:
			GameState.coins = 500
			var jp0: int = GameState.casino_jackpot
			var es := String(Commands.execute({"type": "slot_spin", "stake": 5}))
			var sres: Dictionary = g.minigame.res
			slot_ok = es == "" and GameState.coins == 495 + int(sres.get("win", -1)) and g.minigame.busy() and GameState.casino_jackpot > jp0 \
				and String(Commands.execute({"type": "slot_spin", "stake": 5})) != "" and String(Commands.execute({"type": "slot_spin", "stake": 7})) != ""
			var tsl := Time.get_ticks_msec()
			while g.minigame.busy() and Time.get_ticks_msec() - tsl < 6000:
				await get_tree().process_frame
