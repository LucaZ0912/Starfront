	for mo in Universe.get_layout(sid)["moons"]:
		if String(mo["name"]) == "Pelagia":
			pel = String(mo["id"])
	Commands.execute({"type": "debug_land", "body": pel, "kind": "city"})
	var tm := Time.get_ticks_msec()
