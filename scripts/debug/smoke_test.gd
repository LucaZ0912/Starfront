	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
