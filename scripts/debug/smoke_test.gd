				var beam_hit: bool = saw_aim and saw_fire and is_equal_approx(float(sv.run["hp"]), 1000.0 - float(SV.FOES["core"]["beam"])) and float(sv.run["t"]) == SV.RUN_TIME
				run_steps.call(30)
