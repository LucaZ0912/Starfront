			ossa_ok = ossa_ok and main.story_ui.dialogue != null and String(main.story_ui._dlg.get("id", "")) == "ossa_maul"
	st.set_flag("w58_maul", true)
	if main.story_ui.dialogue != null:
		main.story_ui._close_dialogue()
