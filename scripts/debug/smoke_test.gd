	var plain := ShipFitting.from_dict(f.to_dict())
	plain.faction = "civilian"
	plain.mark_dirty()
	GameState.pilot["skills"]["gunnery"]["lvl"] = 5
	GameState.pilot["skills"]["piloting"]["lvl"] = 5
	f.mark_dirty()
	var s1: Dictionary = f.stats()
	var s0: Dictionary = plain.stats()
