func _zone_of(m: GroundMap, k: String) -> Dictionary:
	for z in m.zones:
		if String(z.get("kind", "")) == k:
			return z
	return {}


## 0.7.52.25 (Luz): the short cloak – a few seconds unseen by its quality, then recharging; firing shows you. And
## the drones on your suit outside a fight – up and back on C.
func _test_foot_cloak(view: SystemView) -> void:
	var GD = GearShop.GearData
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var data_ok: bool = GD.all_ids().has("tl_cloak:A") and GD.all_ids().has("tl_cloak:F") \
		and float(GroundCombat.CLOAK_TIME["A"]) > float(GroundCombat.CLOAK_TIME["F"]) and float(GroundCombat.CLOAK_CD["A"]) < float(GroundCombat.CLOAK_CD["F"])
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	gear.weapons[0] = "wp_rifle:C"
	Commands.execute({"type": "debug_arena", "world": "desert", "foes": []})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null:
		check(false, "0.7.52.25: the arena opens")
		return
	gear.refill()
	cb.step(0.05, Vector2.ZERO)
	var q2: Vector2 = cb._free_near(cb.pilot_pos() + Vector2(0, -100))
	for off in [Vector2(0, -100), Vector2(0, 100), Vector2(-100, 0), Vector2(100, 60), Vector2(-80, -80), Vector2(80, -80)]:
		var qq: Vector2 = cb._free_near(cb.pilot_pos() + off)
		if qq != Vector2.INF and not cb.sight(qq, cb.pilot_pos())["blocked"]:
			q2 = qq
			break
	var fo: Dictionary = cb.spawn("bandit_rifleman", q2)
	cb._wake(fo)
	var m1: String = cb.cloak("tl_cloak:C")
	var on_ok: bool = m1.contains("Cloaked") and is_equal_approx(cb.cloak_t, float(GroundCombat.CLOAK_TIME["C"])) and cb.pilot_hidden()
	var at_you := 0
	for i in 20:
		cb.step(0.1, Vector2.ZERO)
		for s in cb.shots:
			if s["res"]["to"] == null and s["res"]["from"] == fo:
				at_you += 1
	var hidden_ok: bool = at_you == 0 and cb._foe_target(fo) == null and not cb.spots(fo, cb.pilot_pos())
	# it drops, recharges, and firing shows you
	cb.cloak_t = 0.05
	cb.step(0.1, Vector2.ZERO)
	var off_ok: bool = not cb.pilot_hidden() and cb.cloak_cd > 0.0 and cb.cloak("tl_cloak:C").contains("recharging") and g.pilot.modulate == Color.WHITE
	cb.cloak_cd = 0.0
	cb.cloak("tl_cloak:A")
	cb.lock(fo)
	cb.lock_t = 0.0
	cb.pilot_cool = 0.0
	cb.fight = true
	var mine := 0
	for j in 5:
		cb.step(0.05, Vector2.ZERO)
		mine += cb.shots.filter(func(s2): return s2["res"]["from"] == null).size()
	off_ok = off_ok and cb.pilot_hidden() and mine == 0             # cloaked, your weapons hold fire
	# 0.7.52.26 (Luz): a member with a short cloak on its belt cloaks with you; one without does not
	for i0 in gear.inv.size():
		gear.inv[i0] = {}
	gear.inv[0] = {"id": "tl_cloak:B", "n": 1}
	var cm: Dictionary = GameState.new_crew("gunner", "C", "")
	var given: String = gear.member_equip(cm, 0)
	var plain: Dictionary = GameState.new_crew("engineer", "C", "")
	var ca: Dictionary = cb.spawn_ally(cm, 0)
	var cn: Dictionary = cb.spawn_ally(plain, 1)
	cb.cloak_t = 0.0
	cb.cloak_cd = 0.0
	var cmsg: String = cb.cloak("tl_cloak:C")
	var team_ok: bool = given == "" and String(ca["cloak_id"]) == "tl_cloak:B" and float(ca["cloak_t"]) > 0.0 and float(cn["cloak_t"]) == 0.0 \
		and cmsg.contains(String(ca["name"])) and cb._foe_target(fo) != ca
	var ally_shots := 0
	for j2 in 5:
		cb.step(0.05, Vector2.ZERO)
		ally_shots += cb.shots.filter(func(s3): return s3["res"]["from"] == ca).size()
	team_ok = team_ok and ally_shots == 0 and gear.member_unequip(cm, "belt", 0) == "" and gear.count("tl_cloak:B") == 1
	# the drones on your suit outside a fight: up on C, back on C
	gear.drones[0] = "dr_laser:C"
	var bd = g.DroneBuddy.new()
	bd.view = g
	g._world.add_child(bd)
	bd._process(0.05)
	var docked0: bool = String(bd.drones[0]["state"]) == "docked"
	var up: String = bd.command(0)
	for k in 20:
		bd._process(0.05)
	var buddy_ok: bool = docked0 and up.contains("up") and String(bd.drones[0]["state"]) == "hover" and (bd.drones[0]["pos"] as Vector2).distance_to(g.pilot.pos) < 40.0
	bd.command(0)
	for k2 in 60:
		bd._process(0.05)
	buddy_ok = buddy_ok and String(bd.drones[0]["state"]) == "docked"
	bd.queue_free()
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(data_ok and on_ok and hidden_ok and off_ok and buddy_ok and team_ok,
		"0.7.52.25: the short cloak – F to A longer and sooner back; cloaked the foe neither shoots at you nor picks you; it drops and recharges; your weapons hold fire while cloaked; the drones outside a fight go up and dock again; a member with a cloak on its belt cloaks with you  [%s]" % " ".join(PackedStringArray([str(data_ok), str(on_ok), str(hidden_ok), str(off_ok), str(buddy_ok), str(team_ok)])))


## 0.7.52.23 (Luz): the debug vault – a closed station room; the blast door sealed until the button behind the box's
## flap opens it; the relic behind its laser cage cannot be scanned until the terminal switches the lasers off.
func _test_foot_vault(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var e: String = Commands.execute({"type": "debug_vault"})
	var g = main.ground
	if g == null or e != "":
		check(false, "0.7.52.23: the vault opens  [%s]" % e)
		return
	var VG = load("res://scripts/ground/vault_gen.gd")
	var dr: Rect2i = VG.DOOR
	var made_ok: bool = g.env.is_empty() and g.map.explore.size() == 9 and String(g.map.explore[7]["kind"]) == "vent" and bool(g.map.explore[2].get("wall", false)) and String(g.map.explore[0]["kind"]) == "blastdoor" \
		and String(g.map.explore[1]["kind"]) == "blastdoor" and g.belt_tool("tl_cutter") != "" and g.belt_tool("tl_scanner") != "" \
		and g.belt_tool("cs_breach") != "" and g.combat != null
	var vault_p := Vector2(10, 12) * GroundMap.TILE
	var niche_p := Vector2(13, 2.6) * GroundMap.TILE
	var shut_ok: bool = not GroundMap.walkable_t(g.map.t_at(dr.position.x, dr.position.y + 1)) and g.map.path(g.pilot.pos, vault_p).is_empty()
	# 0.7.52.27 (Luz): the air shaft – shut; cut open, a way into the vault through it; in it you sneak
	var vent: Dictionary = g.map.explore[7]
	var d0: Array = VG.DUCT[0]
	var vent_ok: bool = not GroundMap.walkable_t(g.map.t_at(int(d0[0]), int(d0[1])))
	g._cut_done(vent, "duct")
	vent_ok = vent_ok and String(vent["state"]) == "open" and GroundMap.walkable_t(g.map.t_at(int(d0[0]), int(d0[1]))) \
		and not g.map.path(g.pilot.pos, vault_p).is_empty()
	var mid: Array = VG.DUCT[4]
	var back_pos: Vector2 = g.pilot.pos
	g.pilot.pos = (Vector2(int(mid[0]), int(mid[1])) + Vector2(0.5, 0.5)) * GroundMap.TILE
	g._duct_step()
	vent_ok = vent_ok and g.combat.sneaking
	g.pilot.pos = back_pos
	g._duct_step()
	vent_ok = vent_ok and not g.combat.sneaking
	# the button behind the flap opens the door: through it there is a way now
	g._cut_done(g.map.explore[2], "button")
	var open_ok: bool = String(g.map.explore[0]["state"]) == "open" and GroundMap.walkable_t(g.map.t_at(dr.position.x, dr.position.y + 1)) \
		and not g.map.path(g.pilot.pos, vault_p).is_empty()
	# the cage: no scan through the lasers; the terminal switches them off; then it scans
	g.pilot.pos = Vector2(15, 12.4) * GroundMap.TILE
	g.pilot.position = g.pilot.pos * GroundMap.SCALE
	# 0.7.52.24: jacking in takes an E-Breach from the belt
	var nb0: int = gear.count("cs_breach")
	g._open_hack(g.map.explore[5])
	var breach_ok: bool = g.minigame != null and gear.count("cs_breach") == nb0 - 1
	g._close_game()
	var sk := -1
	for b in gear.belt.size():
		if not (gear.belt[b] as Dictionary).is_empty() and String(gear.belt[b]["id"]).begins_with("tl_scanner"):
			sk = b
	var caged: bool = g._scan_start(sk) and g._scan.is_empty()
	g._hack_done(g.map.explore[5], "lasers")
	var cage_ok: bool = caged and String(g.map.explore[3]["state"]) == "off" and g._scan_start(sk) and not g._scan.is_empty()
	# the terminal opens the small door into the niche
	g._hack_done(g.map.explore[5], "door")
	var small_ok: bool = String(g.map.explore[1]["state"]) == "open" and not g.map.path(g.pilot.pos, niche_p).is_empty()
	var rd := GameState.research_data
	g._scan = {}
	g.scan_done(g.map.explore[4])
	cage_ok = cage_ok and GameState.research_data > rd and String(g.map.explore[4]["state"]) == "scanned"
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(made_ok and shut_ok and open_ok and cage_ok and breach_ok and small_ok and vent_ok,
		"0.7.52.23: the debug vault – a station room with air, the things and the tools; the blast door sealed, the button behind the flap opens a way; no scan through the laser cage, the terminal switches it off, then the relic scans; jacking in takes an E-Breach; the small door to the niche; the air shaft cut open, crawled through sneaking  [%s]" % " ".join(PackedStringArray([str(made_ok), str(shut_ok), str(open_ok), str(cage_ok), str(breach_ok), str(small_ok), str(vent_ok)])))


## 0.7.52.22 (package 52b): tools at work – a box cut open with the torch (a button or a terminal behind its one flap),
## a terminal hacked through its security grid (key, lock, core; traced: locked out), a tablet and a relic scanned.
func _test_foot_explore(view: SystemView) -> void:
	var f := GameState.active()
