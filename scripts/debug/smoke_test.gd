		and int(c0["xp"]) == 70 and int(c0["best"]) == 1 and int(c0["fights"]) == 2 and String(c0["fit"]["weapons"][0]) == "wp_pistol:F" and CD.rank(c0) == 1 and CD.budget(c0) == 12 \
