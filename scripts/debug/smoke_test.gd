## Package 53c (Luz): jobs on foot – offered on the board, accepted: the site on the planet map with its briefing;
## the goal reached there completes the job (report back for the pay); a hard heist fails with the alarm; a bounty
## falls with its captain; a reactivation sends the city's lift down.
func _test_ground_jobs(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var m0 := GameState.missions.size()
	# offers: some of the board's are jobs on foot
	var rng := RandomNumberGenerator.new()
	rng.seed = 5320
	var L := Universe.get_layout(f.system_id)
	var st0: Dictionary = L["stations"][0] if not L["stations"].is_empty() else {}
	var grounds := 0
	for i in 40:
		var om: Dictionary = Missions.generate(f.system_id, st0, rng)
		if String(om.get("type", "")) == "ground":
			grounds += 1
	# 0.7.53.16 (Luz): jobs on foot only on their own tab – the space contracts are as many as before
	var gof: Array = GameState.ground_offers_for(f.system_id, st0) if not st0.is_empty() else []
	var offer_ok: bool = grounds == 0 and gof.size() == Missions.GROUND_OFFERS and gof.all(func(x): return String(x["type"]) == "ground")
	# a relic race: accepted, its site on the map, the briefing, the relic read completes it, the pay at the giver
	var res := {}
	for goal_k in ["relic", "heist", "heist_dealer", "bounty_foot", "reactivate", "rescue"]:
		# 0.7.53.17 (Luz): a heist goes for the Red Talons' hoard or the dealer's safe under a city – rolled; take the one wanted
		var goal: String = "heist" if goal_k == "heist_dealer" else goal_k
		var vr: String = {"heist": "pirate", "heist_dealer": "sewer"}.get(goal_k, "")
		var e: String = Commands.execute({"type": "debug_ground_job", "goal": goal, "variant": vr, "seed": 5321 + goal_k.length() * 7})
		var mm: Dictionary = GameState.missions[-1] if GameState.missions.size() > 0 else {}
		res[goal_k] = e == "" and String(mm.get("type", "")) == "ground" and String(mm.get("goal", "")) == goal
		if not res[goal_k]:
			continue
		var site: Dictionary = mm["site"]
		if goal == "reactivate":
			res[goal_k] = not GameState.maint_site_for(String(site["city"])).is_empty()
			GameState.abandon_mission(mm)
			GameState.maint_sites.clear()
			continue
		var body: Dictionary = Universe.find_body(int(site["system"]), String(site["body"]))
		var on_map: bool = GameState.pois_for(int(site["system"]), body).any(func(s): return String(s["id"]) == String(site["id"]))
		if goal_k == "heist_dealer":
			on_map = not on_map and site.has("city") and GameState.sewer_site_for(String(site["city"])) == site
		f.docked_at = "land:" + String(body["id"])
		main.land_at(body, site)
		var g = main.ground
		if g == null:
			res[goal_k] = false
			continue
		g._mission_window()
		var brief: bool = g._lift_menu != null
		g._close_lift_menu()
		var nlev: int = PoiData_53.levels(String(site["theme"]))
		g.depth = nlev - 1
		g.go_level("dungeon", "dungeon_in")
		var ok := false
		match goal:
			"relic":
				for dc in g.map.explore:
					if String(dc["kind"]) == "crystals":
						g.cage_off(dc)
				for d in g.map.explore:
					if String(d["kind"]) == "relic":
						g.scan_done(d)
				ok = int(mm["progress"]) >= 1
				var cr0 := GameState.credits
				ok = ok and GameState.turn_in_mission(mm, String(mm["giver"])) == "" and GameState.credits > cr0
			"heist":
				g._site["hard"] = true
				g.raise_alarm()
				g._site["alarmed"] = true
				for d2 in g.map.explore:
					if String(d2["kind"]) == "crate" and bool(d2.get("target", false)):
						g._poi_target_done(d2)
				ok = not GameState.missions.has(mm)              # the alarm blew the hard heist
			"rescue":
				# 53c: the cell picked, the prisoner follows; hurt by a blast; out in the open the rescue is done
				g.depth = 0
				g.go_level("dungeon", "dungeon_in")
				var cl: Dictionary = {}
				for dcl in g.map.explore:
					if String(dcl["kind"]) == "cells" and bool(dcl.get("prisoner", false)):
						cl = dcl
				if not cl.is_empty():
					g.explore_use({"i": g.map.explore.find(cl)})
					for stp in 4:
						g._fuses_step(1.0)
					var follows: bool = not g._hostage.is_empty() and g._hostage.has("w")
					g.pilot.pos = (cl["pos"] as Vector2) + Vector2(0, 120)
					for stp2 in 30:
						g._hostage_step(0.1)
					var near: bool = follows and (g._hostage["w"] as Walker).pos.distance_to(cl["pos"]) > 10.0
					g._hostage_blast((g._hostage["w"] as Walker).pos + Vector2(10, 0), 40.0)
					var hurt: bool = float(g._hostage.get("hp", 60.0)) < 60.0
					g.go_level("landing", "dungeon_out")
					ok = near and hurt and int(mm["progress"]) >= 1 and g._hostage.is_empty()
				GameState.abandon_mission(mm)
			"bounty_foot":
				for fo in g.combat.foes:
					if String(fo["kind"]) == "pirate_captain":
						fo["dead"] = true
				g._mission_step(0.1)
				ok = int(mm["progress"]) >= 1
				GameState.abandon_mission(mm)
		res[goal_k] = on_map and brief and ok
		main.close_deck(false)
		main._close_planet_map()
		f.docked_at = ""
	while GameState.missions.size() > m0:
		GameState.missions.pop_back()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(offer_ok and bool(res.get("relic", false)) and bool(res.get("heist", false)) and bool(res.get("heist_dealer", false)) and bool(res.get("bounty_foot", false)) and bool(res.get("reactivate", false)) and bool(res.get("rescue", false)),
		"53c: jobs on foot – on their own tab of the board (space contracts untouched); accepted, the site on the planet map with its briefing; the relic read completes a relic race, paid at the giver; a hard heist blown by the alarm (the Red Talons' hoard, and the dealer's safe under a city – its site below the city, not on the map); a bounty done when its captain falls; a reactivation sends the city's lift down; a rescue – the cell picked, the prisoner follows, hurt by a blast, out in the open done  [%s %s]" % [str(offer_ok), str(res)])


func _has_kind(m: GroundMap, k: String) -> bool:
	return m.explore.any(func(d): return String(d["kind"]) == k)



## 53e (Luz): the Museum in Curie – 48 exhibits with their pictures and rarities; the roof plaza with its front, the
## hall, the stairs up to the floors above (one map), the basement; setting a find into its case, the curator buying a
## spare one; the monolith's cast once the Dark Ones' room is full; the Archivist Suit with its built-in tools.
func _test_museum(view: SystemView) -> void:
	var MD = load("res://data/museum.gd")
	var EA = load("res://scripts/core/exhibit_art.gd")
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var finds0: Array = GameState.museum_finds.duplicate()
	var don0: Array = GameState.museum_donated.duplicate()
	var cr0: int = GameState.credits
	# the data: 48 pieces in five rooms, each its own picture
	var counts := {}
	var ids := {}
	var pics_ok := true
	for e in MD.EXHIBITS:
		counts[String(e["room"])] = int(counts.get(String(e["room"]), 0)) + 1
		ids[String(e["id"])] = true
		var im: Image = EA.image(String(e["id"]))
		var opaque := 0
		for yy in 24:
			for xx in 24:
				if im.get_pixel(xx, yy).a > 0.0:
					opaque += 1
		pics_ok = pics_ok and im.get_width() == 24 and opaque > 40 and MD.RARITY.has(String(e["rarity"]))
	var data_ok: bool = MD.EXHIBITS.size() == 48 and ids.size() == 48 and pics_ok and counts.get("minerals", 0) == 20 and counts.get("oldworld", 0) == 5 \
		and counts.get("severance", 0) == 5 and counts.get("precursors", 0) == 10 and counts.get("darkones", 0) == 8 and MD.price("ow_pazz") == 12000
	var rng := RandomNumberGenerator.new()
	rng.seed = 5
	var rolls_ok := true
	for k in 30:
		var pr := PoiData_53.museum_pick("precursor", rng)
		var wr := PoiData_53.museum_pick("wreck", rng, true)
		rolls_ok = rolls_ok and pr.begins_with("pr_") and not MD.is_tablet(pr) and wr.begins_with("sv_")
	# down to a city (any), then up to the Museum's plaza
	var e1: String = Commands.execute({"type": "debug_land", "kind": "city"})
	var g = main.ground
	if g == null or e1 != "":
		check(false, "53e: down to a city  [%s]" % e1)
		return
	g._close_lift_menu()
	GameState.museum_finds = ["mn_gold", "mn_gold", "do_mask"]
	GameState.museum_donated = []
	g.go_level("mplaza", "lift")
	var zin: Dictionary = _zone_of(g.map, "museum_in")
	var plaza_ok: bool = g.level == "mplaza" and g.map.style == "plaza" and not zin.is_empty() and g.map.window_rect.size.x > 10 and g.map.has_meta("museum_x") \
		and g.map.objects.filter(func(o): return String(o["kind"]) in ["statue", "statue_precursor"]).size() == 4 and g.map.objects.any(func(o): return String(o["kind"]) == "column")
	g._arrive = 0.0
	g.zone = zin
	g.use()
	var hall_ok: bool = g.level == "museum" and g.map.style == "museum" and not _zone_of(g.map, "curator").is_empty() 		and g.map.people.size() >= 1 and g.map.objects.any(func(o): return String(o["kind"]) == "curator_desk") 		and g.map.face_deco.any(func(fd): return String(fd["kind"]) == "museum_gate") and g.map.face_deco.any(func(fd2): return String(fd2["kind"]) == "arch_min") 		and not _zone_of(g.map, "seat").is_empty() and g.map.has_meta("no_guards") and g.people.filter(func(w): return w.guard).size() == 0
	# 0.7.53.26 (Luz): each room its own map – the hall's gate up, its arches to the minerals and down; every way there and
	# back, every room reached from where you come in
	var go_of := func(mp: GroundMap, to: String) -> Dictionary:
		for z0 in mp.zones:
			if String(z0.get("kind", "")) == "museum_go" and String(z0["to"]) == to:
				return z0
		return {}
	var case_ids := {}
	var ways_ok := true
	for leg in [["museum", "museum_min", 20], ["museum", "museum_1", 10], ["museum_1", "museum_2", 10], ["museum", "museum_down", 8]]:
		if g.level != String(leg[0]):
			g.go_level(String(leg[0]), "museum_in")
		var zg: Dictionary = go_of.call(g.map, String(leg[1]))
		var from_pos: Vector2 = g.pilot.pos
		var ok_leg: bool = not zg.is_empty() and not g.map.path(g.map.spawn, (zg["rect"] as Rect2).get_center()).is_empty()
		g._arrive = 0.0
		g.zone = zg
		g.use()
		var cs: Array = g.map.explore.filter(func(d): return String(d["kind"]) in ["vitrine", "niche"])
		for d0 in cs:
			case_ids[String(d0["exhibit"])] = true
		var back: Dictionary = go_of.call(g.map, String(leg[0]))
		ok_leg = ok_leg and g.level == String(leg[1]) and cs.size() == int(leg[2]) and not back.is_empty() 			and not g.map.path(g.pilot.pos, (back["rect"] as Rect2).get_center()).is_empty()
		if String(leg[1]) != "museum_down":
			g._arrive = 0.0
			g.zone = back
