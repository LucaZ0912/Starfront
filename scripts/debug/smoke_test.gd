func _test_beyond57(_view: SystemView) -> void:
	var U = Universe
	var ids := {}
	for sp in U.POCKET:
		ids[sp] = U.special_system(sp)
	var all_in: bool = int(ids["beyond"]) >= 0 and int(ids["driftwood"]) >= 0 and int(ids["hollow"]) >= 0
	# gates only among the three, none to the Cluster; out in the Veil, apart from the Far Reaches
	var apart_ok := all_in
	var far_d := INF
	if all_in:
		for sp2 in ids:
			var s: Dictionary = U.systems[ids[sp2]]
			var links: Array = (s["links"] as Dictionary).keys()
			apart_ok = apart_ok and links.size() == 2 and U.is_pocket(int(ids[sp2])) and s.get("veil", false) and U.is_independent(int(ids[sp2]))
			for l in links:
				apart_ok = apart_ok and U.is_pocket(int(l))
			apart_ok = apart_ok and U.find_path(U.home_system, int(ids[sp2]), 3).is_empty()
			var p: Vector2 = s["pos"]
			apart_ok = apart_ok and p.x > 0.0 and p.y > 0.0 and p.x < U.MAP_SIZE.x and p.y < U.MAP_SIZE.y
			for o in U.systems:
				if o.get("outer", false):
					far_d = minf(far_d, (o["pos"] as Vector2).distance_to(p))
	apart_ok = apart_ok and far_d > 250.0
	check(apart_ok, "57: Beyond, Driftwood and Hollow – a pocket in the Veil, gates only among the three, none to the Cluster, independent (%.0f map units from the Far Reaches)" % far_d)
	if not all_in:
		return
	# Beyond's bodies: a G star, Brine (ocean, one city), Hush (ice giant) with its ice moon Rime – Dan's store round it
	var L: Dictionary = U.get_layout(int(ids["beyond"]))
	var by_name := {}
	for b in L["planets"] + L.get("moons", []):
		by_name[String(b["name"])] = b
	var star_ok: bool = String(L["star"].get("star_id", "")) == "G"
	var brine: Dictionary = by_name.get("Brine", {})
	var cities := 0
	if not brine.is_empty():
		for site in U.landing_sites(int(ids["beyond"]), brine):
			cities += int(String(site["kind"]) == "city")
	var others := 0
	for b2 in L["planets"] + L.get("moons", []):
		if String(b2.get("name", "")) != "Brine" and U.landable(b2):
			for site2 in U.landing_sites(int(ids["beyond"]), b2):
				others += int(String(site2["kind"]) == "city")
	var body_ok: bool = star_ok and String(brine.get("type", "")) == "ocean" and cities == 1 and others == 0 		and String(by_name.get("Hush", {}).get("type", "")) == "ice_giant" and String(by_name.get("Rime", {}).get("type", "")) == "moon_ice"
	var dan := {}
	for st in L["stations"]:
		if String(st.get("art", "")) == "dusty_duty":
			dan = st
	var dan_ok: bool = not dan.is_empty() and String(dan["name"]) == "Dan's Dusty Duty Store" and String(dan.get("anchor", "")) == String(by_name.get("Rime", {}).get("id", "?")) 		and L["stations"].size() == 1 and dan.has("market")
	var art: Dictionary = StationArt.build(dan) if not dan.is_empty() else {}
	dan_ok = dan_ok and not art.is_empty() and (art["bays"] as Array).size() >= 1
	# the wreck belt instead of the asteroid belt; the Gold Fleet's wrecks – four kinds in Beyond, two in Driftwood
	var kinds := {}
	for bt in L["belts"]:
		kinds[String(bt["kind"])] = true
	var belt_ok: bool = kinds.has("wreck") and not kinds.has("asteroid") and U.get_layout(int(ids["driftwood"]))["belts"].any(func(x): return String(x["kind"]) == "wreck")
	var gw: Array = L.get("gold_wrecks", [])
	var gk := {}
	for w in gw:
		gk[String(w["kind"])] = true
	var tex_ok := true
	for kd in 4:
		for stg in 3:
			var t: Dictionary = StationArt.build({"art": "gold_colossus", "tier": stg + 1, "seed": kd + 4 * 7})
			tex_ok = tex_ok and (t["texture"] as Texture2D).get_width() == 640
	var warp_n := 0
	for wt in U.warp_targets(int(ids["beyond"])):
		warp_n += int(String(wt["kind"]) == "gold_wreck")
	var wreck_ok: bool = gw.size() == 4 and gk.size() == 4 and U.get_layout(int(ids["driftwood"])).get("gold_wrecks", []).size() == 2 		and U.get_layout(int(ids["hollow"])).get("gold_wrecks", []).is_empty() and tex_ok and warp_n == 4
	# the rest of the game leaves the pocket alone: no raiders, no convoys, no waystation
	var quiet_ok: bool = int(U.system_profile_raw(int(ids["beyond"]))["pirates"]) == 0
	for st2 in L["stations"]:
		quiet_ok = quiet_ok and String(st2["type"]) != "waystation"
	var cv_ok := true
	if GameState.convoys != null:
		for cv in GameState.convoys.convoys:
			cv_ok = cv_ok and not U.is_pocket(int(cv["src"])) and not U.is_pocket(int(cv["dst"]))
	var no_wreck_msg: String = Commands.execute({"type": "debug_gold_wreck"}) if not U.is_pocket(GameState.current_system) else "x"
	check(body_ok and dan_ok and belt_ok and wreck_ok and quiet_ok and cv_ok and no_wreck_msg != "",
		"57: Beyond – a G star, Brine (ocean, its one city), Hush (ice giant) and its ice moon Rime with Dan's Dusty Duty Store; a wreck belt, no asteroid belt; the Gold Fleet's wrecks (4 kinds in Beyond, 2 in Driftwood, warp targets, 640 px pictures); no raiders, no convoys  [%s]" % 		" ".join(PackedStringArray([str(body_ok), str(dan_ok), str(belt_ok), str(wreck_ok), str(quiet_ok), str(cv_ok), str(no_wreck_msg != "")])))
	# package 57 (Luz): the wreck belt's fields – wreck colossi (sections torn off Gold Fleet ships) and hull scrap, mined
	var wf: Array = L["fields"].filter(func(f): return f.get("wreck", false))
	var wcs: Array = L["colossi"].filter(func(co): return co.has("wreck"))
	var scrap := 0
	for a in L["asteroids"]:
		scrap += int(String(a["shape"]) == "scrap")
	var wc_ok: bool = wf.size() >= 2 and wcs.size() >= 4 and scrap > 100
	for f2 in wf:
		wc_ok = wc_ok and String(f2["class"]) == "metallic" and String(f2["name"]).begins_with("Wreck Field")
	var wnames := {}
	for co in wcs:
		wc_ok = wc_ok and (co["poly"] as PackedVector2Array).size() == 96 and float(co["amount"]) > 10000.0 and ColossusShape.contains(co["poly"], Vector2.ZERO) \
			and float(co["radius"]) >= 400.0 and float(co["radius"]) <= 1500.0
		wnames[String(co["name"])] = true
	wc_ok = wc_ok and wnames.size() == wcs.size()
	# her outline matches her picture: points inside the outline are hull (opaque) – 12 variants
	var wart_ok := true
	for vi in 12:
		var img: Image = (StationArt.build({"art": "wreck_piece", "tier": 2, "seed": vi})["texture"] as Texture2D).get_image()
		var hit := 0
		var tot := 0
		for p in StationArt.piece_outline(vi, 1):
			for f3 in [0.3, 0.6, 0.85]:
				tot += 1
				hit += int(img.get_pixelv(p * f3 + Vector2(320, 320)).a > 0.5)
		wart_ok = wart_ok and img.get_width() == 640 and float(hit) / tot > 0.7
	var cel_ok := false
	if not wcs.is_empty():
		var cel := Celestial.new()
		cel.setup("colossus", wcs[0])
		cel_ok = cel._col_sprite != null and cel._col_sprite.material == null and cel.poly.size() == 96 and cel.title() == String(wcs[0]["name"])
		cel.free()
	var stex: Texture2D = PixelArt.asteroid_sprite("metallic", "scrap", 3, 40, "iron_ore")
	var wmsg: String = Commands.execute({"type": "debug_wreck_colossus"}) if not U.is_pocket(GameState.current_system) else "x"
	check(wc_ok and wart_ok and cel_ok and stex.get_width() == 40 and wmsg != "",
		"57: the wreck belt – metallic Wreck Fields, wreck colossi (sections of Gold Fleet ships: outline matches the picture, deposit, unique names) and hull scrap  [%s]" % \
		" ".join(PackedStringArray([str(wc_ok), str(wart_ok), str(cel_ok), str(stex.get_width() == 40), str(wmsg != ""),
			"fields %d colossi %d scrap %d names %d" % [wf.size(), wcs.size(), scrap, wnames.size()]])))


func _test_story55(view: SystemView) -> void:
	var notes: Array = []
	var st = GameState.story
	var keep: Dictionary = st.to_dict()
	var cr0: int = GameState.credits
	st.reset()
	var e: String = Commands.execute({"type": "debug_story", "do": "start", "id": "debug_test"})
	var ui: StoryUI = main.story_ui
	var dlg_ok: bool = e == "" and ui.dialogue != null and get_tree().paused and st.step_index("debug_test") == 0
	ui.choose(1)                                       # "I know how this works." – sets a flag
	ui.choose(0)
	dlg_ok = dlg_ok and ui.dialogue == null and not get_tree().paused and bool(st.flags.get("test_confident", false)) and st.step_index("debug_test") == 1
	var target: String = String(st.missions["debug_test"]["target"])
	var fly_ok: bool = target != "" and st.tips_seen.has("tip_objective") and st.tracked == "debug_test" and ui.marker_targets().has(target)
	st.event("near", {"id": target, "km": 6000.0})
	var far_ok: bool = st.step_index("debug_test") == 1
	st.event("near", {"id": target, "km": 3000.0})
	var near_ok: bool = far_ok and st.step_index("debug_test") == 2
	st.event("dock", {"id": "some_other_station"})
	var wrong_ok: bool = st.step_index("debug_test") == 2
	st.event("dock", {"id": target})
	var done_ok: bool = wrong_ok and not st.running("debug_test") and st.done.has("debug_test") and st.secrets.has("test_secret") and GameState.credits == cr0 + 1000
	var log_ok: bool = true
	# save and load
	st.start("debug_test")
	ui.choose(0)
	ui.choose(0)
	var d: Dictionary = st.to_dict()
	var st2 = load("res://scripts/core/story.gd").new()
	st2.from_dict(d)
	var save_ok: bool = st2.step_index("debug_test") == 1 and st2.secrets.has("test_secret") and st2.tracked == "debug_test" and (st2.missions["debug_test"]["log"] as Array).size() >= 2
	# the journal's four tabs build
	main.open_journal()
	var pw = main.pilot_window
	var jr_ok: bool = pw.visible and pw.tab == pw.TAB_JOURNAL
	for js in ["story", "side", "tips", "secrets"]:
		pw.jsub = js
		pw.jsel = ""
		pw.rebuild()
		jr_ok = jr_ok and pw.body.get_child_count() >= 2
	pw.jsub = "story"
	pw.close()
	var keys_ok: bool = st.keys("press {key:module_1} now") == "press %s now" % Keybinds.key_text("module_1")
	ui.close_tip()
	st.from_dict(keep)
	GameState.credits = cr0
	if not (dlg_ok and fly_ok and near_ok and done_ok and save_ok and jr_ok and keys_ok):
		notes.append("target %s step %d tracked %s" % [target, st.step_index("debug_test"), st.tracked])
	check(dlg_ok and fly_ok and near_ok and done_ok and log_ok and save_ok and jr_ok and keys_ok,
		"55: the story's framework – the test mission: a dialogue (paused, an answer sets a flag), a tip, a marked station (near – not from afar – then dock there, not elsewhere), credits and a secret; tracked; kept in the save; the journal's four tabs; keys in texts  [%s]%s" % [
			" ".join(PackedStringArray([str(dlg_ok), str(fly_ok), str(near_ok), str(done_ok), str(save_ok), str(jr_ok), str(keys_ok)])), (" " + ", ".join(PackedStringArray(notes))) if not notes.is_empty() else ""])


## Window rework (Luz, 18 Nov 2026): no station window is wider than the screen (a long line wraps, the window
## shrinks back after a wide one); the shipyard and the hangar – the picked ship on top, the tile strip below,
## filters by size and role, Q / E stepping through; ships elsewhere in the hangar's strip.
func _test_stationwin(view: SystemView) -> void:
	var SY = load("res://scripts/ui/station/shipyard_panel.gd")
	var HG = load("res://scripts/ui/station/hangar_panel.gd")
	var best: Dictionary = view.layout["stations"][0]
	for st in view.layout["stations"]:
		if (st.get("services", []) as Array).size() > (best.get("services", []) as Array).size() or (best["shipyard"].is_empty() and not st["shipyard"].is_empty()):
			best = st
	var f := GameState.active()
	var keep_dock := f.docked_at
	f.docked_at = String(best["id"])
	var sp: StationUI = main.station_panel
	var scr: Vector2 = get_viewport().get_visible_rect().size
	var wide: Array = []
	sp.open(best, view)
	for svc in GameData.services:
		if sp.service_available(svc) != "":
			continue
		sp.open_service(String(svc["id"]))
		for fr in 3:
			await get_tree().process_frame
		if sp.win.get_combined_minimum_size().x > 1260.0:          # the smallest screen supported: 1280
			wide.append("%s %.0f" % [svc["id"], sp.win.get_combined_minimum_size().x])
			if "--why" in OS.get_cmdline_user_args():
				_wide_walk(sp.win, 0, 1100.0)
	SY.size_f = "all"
	SY.role_f = "all"
	SY.pick = ""
	sp.open_service("shipyard")
	var p = sp._panel
	var list: Array = p._hulls()
	var first: String = SY.pick
	sp.menu_tab(1)
	var stepped: bool = list.size() < 2 or SY.pick == list[1]
	var tiles := 0
	for b in sp._panel.find_children("*", "Button", true, false):
		if (b as Button).custom_minimum_size.y >= 90.0 and (b as Button).custom_minimum_size.x > 100.0:
			tiles += 1
	SY.size_f = "1"
	sp.rebuild()
	var small_only: bool = sp._panel._hulls().all(func(h): return int(GameData.hulls[h]["size"]) == 1)
	SY.size_f = "all"
	SY.role_f = "mining"
	sp.rebuild()
	var mining_ok: bool = sp._panel._hulls().all(func(h): return SY.role_of(GameData.hulls[h]) == "mining") and SY.role_of(GameData.hulls["drillhead"]) == "mining" and SY.role_of(GameData.hulls["mule"]) == "trade"
	SY.role_f = "all"
	var yard_ok: bool = first == list[0] and stepped and tiles == list.size() and small_only and mining_ok
	# the hangar: the ships here first, then the rest (greyed)
	var other := GameState.create_fit("dragonfly", {}, "player")
	other.ship_name = "Elsewhere Test"
	other.docked_at = "nowhere"
	other.system_id = GameState.current_system
	GameState.add_ship(other)
	HG.pick_uid = -1
	sp.open_service("hangar")
	var ships: Array = sp._panel._ships()
	var hangar_ok: bool = HG.pick_uid == f.uid and ships.back() == other and ships.size() == GameState.fleet.size()
	sp.menu_tab(5)
	hangar_ok = hangar_ok and HG.pick_uid == other.uid
	GameState.fleet.erase(other)
	HG.pick_uid = -1
	# the market: a list and the picked good's card; buying with the slider's amount; the drop-downs set the filter
	var MK = load("res://scripts/ui/station/market_panel.gd")
	MK.filter = "all"
	sp.open_service("market")
	var mp = sp._panel
	var good := ""
	for cid in mp._sorted_goods():
		if Market.buy_price(best, cid) > 0 and GameData.item_volume(cid) <= 1.0 and good == "":
			good = cid
	var market_ok: bool = good != "" and mp._rows.size() > 10
	var keep_cr := GameState.credits
	var keep_cargo: Dictionary = f.cargo.duplicate()
	GameState.credits = 1000000
	if good != "":
		mp._pick(good)
		var mb: int = mp.max_buy(good)
		var had := float(f.cargo.get(good, 0.0))
		mp._buy(good, 3)
		market_ok = market_ok and mb >= 3 and float(f.cargo.get(good, 0.0)) == had + 3.0 and MK.pick == good
		MK.filter = "cat:metals"
		sp.rebuild()
		market_ok = market_ok and sp._panel._rows.keys().all(func(c): return Market.category_of(c) == "metals")
	MK.filter = "local"
	# Luz, 18 Nov 2026: refining and components take time, one job after the other per queue; collected at the station
	var keep_jobs: Array = GameState.jobs.duplicate(true)
	GameState.jobs.clear()
	f.cargo.clear()
	f.mark_dirty()
	var two: Array = []                                    # two kinds this refinery takes (the station differs in the full run)
	for o in Industry.ores():
		if Industry.ore_yield(best, o) > 0.0 and two.size() < 2:
			two.append(o)
	var sid2 := String(best["id"])
	var prod_ok := true
	var steps := ""
	if two.size() == 2:
		f.cargo[two[0]] = 30.0
		f.cargo[two[1]] = 9.0
		Commands.execute({"type": "refine", "ore": two[0]})
		Commands.execute({"type": "refine", "ore": two[1]})
		var q2: Array = GameState.jobs_at(sid2, "refinery")
		var t1 := float(q2[0]["total"]) if q2.size() == 2 else 0.0
		prod_ok = q2.size() == 2 and is_equal_approx(t1, Industry.refine_time(two[0], 30.0)) and float(f.cargo.get(two[0], 0.0)) == 0.0
		steps += "q%s " % prod_ok
		GameState._advance_station_jobs(t1 * 0.5)
		prod_ok = prod_ok and float(q2[1]["left"]) == float(q2[1]["total"])                 # the second one waits
		GameState._advance_station_jobs(t1 * 0.5 + 0.5)
		prod_ok = prod_ok and bool(q2[0].get("done", false)) and float(q2[1]["left"]) < float(q2[1]["total"])   # leftover time goes on
		steps += "w%s " % prod_ok
		GameState._advance_station_jobs(9999.0)
		var outs: Array = q2.map(func(j): return String(j["out_id"]))
		Commands.execute({"type": "job_collect", "id": -1})
		prod_ok = prod_ok and outs.all(func(o): return float(f.cargo.get(o, 0.0)) > 0.0)
		steps += "c%s" % prod_ok
	prod_ok = prod_ok and Industry.refine_factor("platinum_ore") > Industry.refine_factor("iron_ore") if GameData.commodities.has("platinum_ore") else prod_ok
	prod_ok = prod_ok and Industry.station_build_time("o_cargo:1:C") < Industry.build_time("o_cargo:1:C") and Industry.component_time("fusion_cells", 1) > Industry.component_time("circuits", 1)
	GameState.jobs = keep_jobs
	# the drone bay, repair / fuel and the munitions depot (window rework, part 5)
	var keep_drones: Array = f.drones.duplicate(true)
	var svc_ok := true
	GameState.credits = 1000000
	f.cargo.clear()
	f.mark_dirty()
	sp.open_service("drones")
	if int(f.stats()["drone_storage"]) > f.drones.size():
		var nd := f.drones.size()
		Commands.execute({"type": "drone_buy", "amount": 1})
		sp.rebuild()
		svc_ok = svc_ok and f.drones.size() == nd + 1 and sp._panel.find_children("*", "HSlider", true, false).size() >= 1
	var SV = load("res://scripts/ui/station/service_panel.gd")
	SV.pick_uid = -1
	f.armor = 1.0
	sp.open_service("repair")
	var cost_r := Commands.service_cost("repair", f)
	svc_ok = svc_ok and SV.pick_uid == f.uid and cost_r > 0
	sp._panel._apply(f.uid)
	svc_ok = svc_ok and Commands.service_cost("repair", f) == 0
	var MU = load("res://scripts/ui/station/munitions_panel.gd")
	sp.open_service("munitions")
	var off := Munitions.offer(best)
	if not off.is_empty():
		var mid2: String = off.keys()[0]
		MU.pick = mid2
		sp.rebuild()
		Commands.execute({"type": "munitions_buy", "item": mid2, "amount": 3})
