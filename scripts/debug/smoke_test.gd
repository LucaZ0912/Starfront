	for z3 in g.map.zones:
		if String(z3.get("kind", "")) == "leak":
			lz = z3
	var leak_ok := not lz.is_empty()
	if leak_ok:
		g.pilot.pos = (lz["rect"] as Rect2).get_center()
		g._env_step(0.1)
		leak_ok = not g.env.is_empty() and float(g.env.get("cold", 0.0)) > 0.5
		var sp: Dictionary = {}
		for d2 in g.map.explore:
			if String(d2["kind"]) == "seal_panel" and int(d2["leak"]) == int(lz["i"]):
				sp = d2
		g.explore_use({"i": g.map.explore.find(sp)})
		g._env_step(0.1)
		leak_ok = leak_ok and not sp.is_empty() and String(g.map.explore[int(lz["i"])]["state"]) == "sealed" and g.env.is_empty()
	# down: the research computer and its logs
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_down")
	g.use()
	var logs: Dictionary = {}
	for d3 in g.map.explore:
		if String(d3["kind"]) == "terminal" and "logs" in d3.get("actions", []):
			logs = d3
	var rd0: int = GameState.research_data
	if not logs.is_empty():
		g._explore_effect(logs, "logs")
	var logs_ok: bool = g.depth == 1 and not logs.is_empty() and GameState.research_data >= rd0 + 10 and GameState.poi_used.has(String(g._site["id"]))
	# the jobs: data recovery (on the planet map), a rescue of the researchers
	var jobs_ok := true
	var e2: String = Commands.execute({"type": "debug_ground_job", "goal": "recover", "seed": 5421})
	var mm: Dictionary = GameState.missions[-1] if not GameState.missions.is_empty() else {}
	var site: Dictionary = mm.get("site", {})
	var body: Dictionary = Universe.find_body(int(site.get("system", 0)), String(site.get("body", "")))
	jobs_ok = e2 == "" and String(site.get("theme", "")) == "research" and GameState.pois_for(int(site["system"]), body).has(site) \
		and Universe.SITE_KINDS.has(String(site["kind"])) and Universe.SITE_KINDS.has("pirate")
	GameState.abandon_mission(mm)
	var e3: String = Commands.execute({"type": "debug_ground_job", "goal": "rescue", "variant": "research", "seed": 5422})
	var mm2: Dictionary = GameState.missions[-1] if not GameState.missions.is_empty() else {}
	jobs_ok = jobs_ok and e3 == "" and String(mm2["site"].get("theme", "")) == "research" and String(mm2["site"].get("prisoner", "")) == "a researcher"
	GameState.abandon_mission(mm2)
	# back
	Commands.suit_god = false
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(out_ok and air_ok and leak_ok and logs_ok and jobs_ok,
		"53d: the research station – modules on stilts, the airlock and a torn module; inside its own air, a torn module lets the cold in until its bulkhead is sealed; the cold store; the research logs below; data recovery on the map, a rescue of its researchers  [%s]" % " ".join(PackedStringArray([str(out_ok), str(air_ok), str(leak_ok), str(logs_ok), str(jobs_ok)])))


## 0.7.53.23 (Luz, package 53d): the ruin of the Dark Ones – the maw opens to its symbols in order (a wrong one sends
## a wave; the monolith's vision tells the order); inside empty, round chambers, monoliths, glyphs on the floor, a maw
## down; at the bottom the membrane (its symbols), the pit with the sleeper, the relic for the Museum; the job finds
## the cult in it.
func _test_darkones(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	Commands.suit_god = true
	var e: String = Commands.execute({"type": "debug_poi", "danger": "yellow", "seed": 5423, "theme": "darkones"})
	var g = main.ground
	if g == null or e != "" or g.level != "landing":
		check(false, "53d: the Dark Ones' ruin opens  [%s]" % e)
		Commands.suit_god = false
		return
	g._close_lift_menu()
	var find := func(kind: String) -> Dictionary:
		for d in g.map.explore:
			if String(d["kind"]) == kind:
				return d
		return {}
	var pl: Dictionary = find.call("symbol_pillar")
	var mono: Dictionary = find.call("monolith")
	var gate: Dictionary = find.call("ruin_gate")
	var out_ok: bool = not pl.is_empty() and not mono.is_empty() and String(gate.get("lock", "")) == "symbols" and g.map.style == "darkones"
	# a wrong symbol: a wave, the order begins again
	var order: Array = pl.get("order", [0, 1, 2, 3])
	Commands.suit_god = false
	gear.refill()
	var hp0: float = gear.health + gear.armor + gear.shield
	g._touch_symbol(pl, int(order[1]))
	var wave_ok: bool = gear.health + gear.armor + gear.shield < hp0 and (pl.get("seq", []) as Array).is_empty()
	Commands.suit_god = true
	# the monolith's vision; then the right order opens the maw
	var rd0: int = GameState.research_data
	g.scan_done(mono)
	var vis_ok: bool = String(mono["state"]) == "scanned" and GameState.research_data > rd0
	for si in order:
		g._touch_symbol(pl, int(si))
	out_ok = out_ok and String(gate["state"]) == "open" and String(pl["state"]) == "open"
	g._close_lift_menu()
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_in")
	g.use()
	if g.level != "dungeon":
		check(false, "53d: into the Dark Ones' ruin  [%s %s %s %s]" % [str(out_ok), str(wave_ok), str(vis_ok), g.level])
		Commands.suit_god = false
		return
	# inside: empty, monoliths, glyphs, the maw down
	var glyph: Dictionary = find.call("glyph_trap")
	var in_ok: bool = g.combat != null and g.combat.foes.is_empty() and not (find.call("monolith") as Dictionary).is_empty() and not (find.call("maw") as Dictionary).is_empty() \
		and g.map.floor_kind.has(33)
	if not glyph.is_empty():
		g.pilot.pos = glyph["pos"]
		g._cams_step(0.1)
		in_ok = in_ok and String(glyph["state"]) == "spent"
	# 0.7.53.24 (Luz): a hidden cache – the monolith tells of it (a ? on the map), the cutting torch opens the cracked wall
	var hid_ok := true
	if g.map.has_meta("hidden_wall"):
		var hw: Dictionary = g.map.explore[int(g.map.get_meta("hidden_wall"))]
		g.scan_done(find.call("monolith"))
		var hinted: bool = bool(hw.get("hinted", false))
		var keep_b = gear.belt[0]
		gear.belt[0] = {"id": "tl_cutter:C", "n": 1}
		g.explore_use({"i": g.map.explore.find(hw)})
		gear.belt[0] = keep_b
		var t0: Array = hw["tiles"][0]
		hid_ok = hinted and String(hw["state"]) == "open" and GroundMap.walkable_t(g.map.t_at(int(t0[0]), int(t0[1]))) 			and g.map.explore.any(func(dh): return String(dh["kind"]) == "crate" and bool(dh.get("hidden", false)))
	else:
		hid_ok = false
	# 0.7.53.24: a dangerous site is a bigger one
	var gm: GroundMap = DungeonGen53.build_inside({}, {"theme": "precursor", "seed": 777, "danger": "green"}, 0)
	var rm: GroundMap = DungeonGen53.build_inside({}, {"theme": "precursor", "seed": 777, "danger": "red"}, 0)
	var big_ok: bool = rm.w * rm.h > gm.w * gm.h
	in_ok = in_ok and hid_ok and big_ok
	if not (hid_ok and big_ok):
		print("[SMOKE] hidden/big: ", hid_ok, " ", big_ok, " ", g.map.has_meta("hidden_wall"))
	# the bottom: the membrane and its symbols, the sleeper, the relic
	g.depth = 2
	g.go_level("dungeon", "dungeon_down")
	var mem: Dictionary = find.call("membrane")
	var pl2: Dictionary = find.call("symbol_pillar")
	var relic: Dictionary = find.call("relic")
	var bot_ok: bool = not mem.is_empty() and not pl2.is_empty() and not relic.is_empty() and not (find.call("sleeper") as Dictionary).is_empty()
	if bot_ok:
		for si2 in pl2["order"]:
			g._touch_symbol(pl2, int(si2))
		g._close_lift_menu()
		bot_ok = String(mem["state"]) == "open"
		var n_finds: int = GameState.museum_finds.size()
		g.scan_done(relic)
		bot_ok = bot_ok and GameState.poi_used.has(String(g._site["id"])) and GameState.museum_finds.size() > n_finds
	# the job: the cult in a ruin
	var e2: String = Commands.execute({"type": "debug_ground_job", "goal": "investigate", "variant": "debug", "seed": 5424})
	var mm: Dictionary = GameState.missions[-1] if not GameState.missions.is_empty() else {}
	var site: Dictionary = mm.get("site", {})
	var job_ok: bool = e2 == "" and String(site.get("theme", "")) == "darkones" and bool(site.get("cult", false))
	if job_ok:
		var last_map: GroundMap = DungeonGen53.build_inside({}, site, 2)
		var fl: Array = last_map.get_meta("foes", [])
		job_ok = fl.size() >= 2 and fl.any(func(x): return String(x).begins_with("cult_priest"))
	GameState.abandon_mission(mm)
	# back
	Commands.suit_god = false
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(out_ok and wave_ok and vis_ok and in_ok and bot_ok and job_ok and Universe.SITE_KINDS.has("darkruin"),
		"53d: the Dark Ones' ruin – the maw opens to its symbols in order (a wrong one: a wave; the monolith's vision tells the order); inside empty, monoliths, glyphs, a maw down, a hidden cache the monolith tells of (behind a cracked wall); a red site is bigger; at the bottom the membrane, the sleeper, the relic for the Museum; the job finds the cult  [%s]" % " ".join(PackedStringArray([str(out_ok), str(wave_ok), str(vis_ok), str(in_ok), str(bot_ok), str(job_ok)])))

## 0.7.53.7 (Luz, package 53b): a settlement's way down – the old mine: the headframe outside (its chained gate),
## the drifts with their rails, the cage without power (the generator), boxes of explosives that go up, the deepest
## chamber's find for the Museum; from a real settlement by the path at its edge.
func _test_mine(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var e: String = Commands.execute({"type": "debug_poi", "danger": "yellow", "seed": 5307, "theme": "mine"})
	var g = main.ground
	if g == null or e != "" or g.level != "landing":
		check(false, "53b: the old mine opens  [%s]" % e)
		return
	gear.refill()
	g._close_lift_menu()
	var gate: Dictionary = {}
	for d in g.map.explore:
		if String(d["kind"]) == "mine_gate":
			gate = d
	var zin := _zone_of(g.map, "dungeon_in")
	var out_ok: bool = not gate.is_empty() and zin.has("gate") and not _zone_of(g.map, "town_path").is_empty() \
		and g.map.objects.any(func(o): return String(o["kind"]) == "shaft_house")
	if String(gate["state"]) != "open":
		g._arrive = 0.0
		g.zone = zin
		g.use()
		out_ok = out_ok and g.level == "landing"
		g._cut_done(gate, "duct")
	out_ok = out_ok and String(gate["state"]) == "open"
	g._arrive = 0.0
	g.zone = zin
	g.use()
	if g.level != "dungeon" or g.combat == null:
		check(false, "53b: down into the mine  [%s]" % g.level)
		return
	gear.refill()
	# level 1: rails, the cage, explosives, traps
	var rails := 0
	for y in g.map.h:
		for x in g.map.w:
			if g.map.floor_kind[y * g.map.w + x] in [26, 27]:
				rails += 1
	var cage: Dictionary = {}
	var gen: Dictionary = {}
	var tnt: Dictionary = {}
	var traps := 0
	for d1 in g.map.explore:
		match String(d1["kind"]):
			"cage":
				cage = d1
			"mine_gen":
				gen = d1
			"tnt":
				if tnt.is_empty():
					tnt = d1
			"loose_rock", "gas", "tripwire":
				traps += 1
	var lvl_ok: bool = g.map.style == "mine" and rails > 20 and not cage.is_empty() and not tnt.is_empty() and traps >= 1 and g.map.has_meta("dark")
	# a blast close by sets the explosives off
	Commands.suit_god = true
	var nb: int = g.combat.booms.size()
	g.blast_near((tnt["pos"] as Vector2) + Vector2(24, 0), 30.0)
	g._fuses_step(0.3)
	var tnt_ok: bool = String(tnt["state"]) == "gone" and g.combat.booms.size() > nb
	Commands.suit_god = false
	# the cage: without power it will not go; the generator gives it power; it sinks with you
	g.pilot.pos = (cage["pos"] as Vector2) + Vector2(0, 10)
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_down")
	if String(cage["state"]) == "dormant":
		g.use()
		lvl_ok = lvl_ok and g._sink.is_empty() and not gen.is_empty()
		g.explore_use({"i": g.map.explore.find(gen)})
	var cage_ok: bool = String(cage["state"]) == "active"
	g.use()
	for st in 10:
		if not g._sink.is_empty():
			g._sink_step(0.3)
	cage_ok = cage_ok and g.depth == 1 and g.level == "dungeon"
	# level 2: the deepest chamber behind its gate, the find
	var vein: Dictionary = {}
	var ctrl: Dictionary = {}
	for d2 in g.map.explore:
		if String(d2["kind"]) == "vein":
			vein = d2
		elif String(d2["kind"]) == "terminal" and (d2.get("actions", []) as Array).has("door"):
			ctrl = d2
	var vp: Vector2 = (vein.get("pos", Vector2.ZERO) as Vector2) + Vector2(0, 20)
	var deep_ok: bool = not vein.is_empty() and bool(vein.get("target", false)) and not ctrl.is_empty() and g.map.path(g.map.spawn, vp).is_empty() \
		and _has_kind(g.map, "grate_door")
	g._hack_done(ctrl, "door")
	deep_ok = deep_ok and not g.map.path(g.map.spawn, vp).is_empty()
	gear.belt[0] = {"id": "tl_cutter:C", "n": 1}
	var mf := GameState.museum_finds.size()
	g.explore_use({"i": g.map.explore.find(vein)})
	var find_ok: bool = String(vein["state"]) == "taken" and GameState.museum_finds.size() == mf + 1 and GameState.poi_used.has(String(g._site["id"])) \
		and String(GameState.museum_finds[-1]).begins_with("mn_")
	GameState.museum_finds.resize(mf)
	# a real settlement: the path at its edge to the old mine and back
	main.close_deck(false)
	main._close_planet_map()
	f.docked_at = ""
	var town_ok := true
	var L := Universe.get_layout(view.system_id)
	var tbody := {}
	for b in L["planets"] + L.get("moons", []):
		if Universe.landable(b) and tbody.is_empty():
			tbody = b
	if not tbody.is_empty():
		var e2 := Commands.execute({"type": "debug_land", "body": String(tbody["id"]), "kind": "mine"})
		g = main.ground
		town_ok = e2 == "" and g != null and g.level == "settlement" and not _zone_of(g.map, "mine_path").is_empty()
		if town_ok:
			var site0: Dictionary = g._site
			g._arrive = 0.0
			g.zone = _zone_of(g.map, "mine_path")
			g.use()
			town_ok = g.level == "minehead" and String(g._site.get("theme", "")) == "mine" and g.combat == null
			g._arrive = 0.0
			g.zone = _zone_of(g.map, "town_path")
			g.use()
			town_ok = town_ok and g.level == "settlement" and g._site == site0 and g.pilot.pos.distance_to(g.map.get_meta("mine_path_front")) < 30.0
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(out_ok and lvl_ok and tnt_ok and cage_ok and deep_ok and find_ok and town_ok,
		"53b: the old mine – the headframe and its chained gate; drifts with rails, the cage, explosives, traps; a blast sets the explosives off; the cage without power waits for the generator, then sinks; the deepest chamber's gate, the find for the Museum; from a settlement by the path at its edge and back  [%s]" % " ".join(PackedStringArray([str(out_ok), str(lvl_ok), str(tnt_ok), str(cage_ok), str(deep_ok), str(find_ok), str(town_ok)])))


## 0.7.53.9 (Luz, package 53c): the maintenance tunnels under a city – the lift goes down when the power is out;
## three levels by the stairs; pipes everywhere; the crank door and its fuse box; the maintenance drones mend things
## and leave you be until shot at; steam; the reactor restarted lights it all.
func _test_maint(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var L := Universe.get_layout(view.system_id)
	var cbody := {}
	for b in L["planets"] + L.get("moons", []):
		if Universe.landable(b) and Universe.landing_sites(view.system_id, b).any(func(s): return String(s["kind"]) == "city"):
			cbody = b
			break
	if cbody.is_empty():
		check(true, "53c: maintenance tunnels – no city here (skipped)")
		return
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var e1 := Commands.execute({"type": "debug_land", "body": String(cbody["id"]), "kind": "city"})
	var g = main.ground
	var no_lift: bool = e1 == "" and g != null and g.is_city()
	if no_lift:
		g._open_lift_menu({})
		var n0: int = (g._lift_menu.get_meta("keys", []) as Array).size()
		g._close_lift_menu()
		GameState.maint_sites[String(g.station.get("id", ""))] = GameState.maint_site(g.station, 5309)
		g._open_lift_menu({})
		var n1: int = (g._lift_menu.get_meta("keys", []) as Array).size()
		no_lift = n1 == n0 + 1
		(g._lift_menu.get_meta("keys") as Array)[n1 - 1].call()
	if g == null or g.level != "dungeon" or g.combat == null:
		check(false, "53c: down the lift into the maintenance tunnels  [%s]" % (g.level if g != null else "?"))
		return
	gear.refill()
	# level 1: the tunnels, the drones (passive), the crank door, steam
	var drones: Array = g.combat.foes.filter(func(x): return bool(x.get("drone", false)))
	var lvl_ok: bool = no_lift and g.map.style == "maint" and String(g._site.get("theme", "")) == "maint" and drones.size() >= 2 \
		and drones.all(func(x): return bool(x.get("passive", false))) and _has_kind(g.map, "service_lift") and _has_kind(g.map, "stairs_down") \
		and int(g.map.get_meta("poi")["levels"]) == 3 and g.map.objects.any(func(o): return String(o["kind"]) == "pipe_bundle")
	# passive: seen, they keep mending; shot at, it turns on you
	var d0: Dictionary = drones[0]
	g.pilot.pos = (d0["w"] as Walker).pos + Vector2(40, 0)
	for st in 10:
		g.combat.step(0.1, Vector2.ZERO)
		g._drones_step(0.1)
	var passive_ok: bool = not d0["aware"]
	g.combat._hurt_foe(d0, 1.0, "kinetic")
	passive_ok = passive_ok and d0["aware"] and bool(d0["provoked"])
	# down the stairs to level 3: the crank door, the fuse box, the reactor
	g._arrive = 0.0
	g.depth = 2
	g.go_level("dungeon", "dungeon_down")
	var crank: Dictionary = {}
	var fuse: Dictionary = {}
	var term: Dictionary = {}
	var reactor: Dictionary = {}
	for d in g.map.explore:
		match String(d["kind"]):
			"crank_door":
				crank = d
			"fuse_box":
				fuse = d
			"reactor":
				reactor = d
			"terminal":
				if (d.get("actions", []) as Array).has("restart"):
					term = d
	var rp: Vector2 = (term.get("pos", Vector2.ZERO) as Vector2) + Vector2(0, -2)
	var deep_ok: bool = not crank.is_empty() and not fuse.is_empty() and not reactor.is_empty() and not term.is_empty() and g.map.path(g.map.spawn, rp).is_empty() \
		and _has_kind(g.map, "stairs_up")
	g.explore_use({"i": g.map.explore.find(crank)})
	var cranking: bool = String(crank["state"]) == "cranking"
	for st2 in 6:
		g._fuses_step(1.0)
	deep_ok = deep_ok and cranking and String(crank["state"]) == "open" and not g.map.path(g.map.spawn, rp).is_empty()
	# the reactor restarted: it spins up, every level lit, the site done
	var cr0 := GameState.credits
	g._hack_done(term, "restart")
	var lit_ok: bool = String(reactor["state"]) == "on" and GameState.poi_used.has(String(g._site["id"])) and GameState.credits > cr0
	for key in g._poi_cache.keys():
		if String(key).begins_with("dungeon_"):
			lit_ok = lit_ok and (g._poi_cache[key] as GroundMap).get_meta("dark", Color.BLACK).v > 0.9
	# out by the service lift: back up on the street
	g.depth = 0
	g.go_level("dungeon", "dungeon_up")
