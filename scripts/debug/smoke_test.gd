	off_ok = off_ok and stand_back and stand_seen and heard_ok
	if not off_ok:
		print("[SMOKE] stand: ", stand_back, " ", stand_seen, " ", heard_ok)
	# back
	Commands.suit_god = false
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(key_ok and on_ok and back_ok and lock_ok and sneak_ok and seen_ok and off_ok,
