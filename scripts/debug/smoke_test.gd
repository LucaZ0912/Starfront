			var c_came: bool = ci >= 0 and String(sv.boss_kind) == "core" and bool(sv.barrier_on) and String(sv.banner) == "THE CORE" and int(sv._cnt[KI["pylon"]]) == 4 and int(sv.n) == 5 \
