	giver._solar(10.0, gst)
	check(near > far and far > 0.0 and giver.fit.fuel > 0.0, "solar collector: %.2f fuel/s near the star, %.3f far out" % [near, far])
	# mines on sale; summaries and icons
	var mine_market := false
