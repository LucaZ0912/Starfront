## 53f (Luz): creatures and machines – their pictures; in a fight: a strike close up, the necrotic thing rising once
## and healing, the Precursor robot's colour, what they leave; in the places: rats in swarms, robots in the ruins, the
## rat plague job with its brood mother.
func _test_creatures(view: SystemView) -> void:
	var CA = load("res://scripts/ground/creature_art.gd")
	var FD = load("res://data/foes.gd")
	var art_ok := true
	for kd in CA.KINDS:
		for dr in 4:
			var im: Image = CA.image(String(kd), dr, 1, true, 0.5)
			var n := 0
			for yy in im.get_height():
				for xx in im.get_width():
					if im.get_pixel(xx, yy).a > 0.5:
						n += 1
			art_ok = art_ok and n > 20
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var e1: String = Commands.execute({"type": "debug_arena", "world": "desert", "foes": []})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null:
		check(false, "53f: the arena opens  [%s]" % e1)
		return
	gear.refill()
	Commands.suit_god = false
	var pp: Vector2 = cb.pilot_pos()
	var nec: Dictionary = cb.spawn("necrotic", pp + Vector2(10, 0))
	var rob: Dictionary = cb.spawn("pre_robot", pp + Vector2(120, 0))
	var rat: Dictionary = cb.spawn("mut_rat", pp + Vector2(-10, 0))
	var spawn_ok: bool = (nec["w"] as Walker).creature == "necrotic" and (rat["w"] as Walker).creature == "rat" and float(rob["st"]["armor"]) > 100.0 \
		and float(rat["st"]["shield"]) == 0.0
	# a strike close up hurts you (no shot flies)
	var hp0: float = gear.health + gear.armor + gear.shield
	var shots0: int = cb.shots.size()
	for i in 12:
		cb.fire(nec, null, GearData_53e.stats(String(nec["weapon"])))
	var melee_ok: bool = gear.health + gear.armor + gear.shield < hp0 and cb.shots.size() == shots0
	# the robot turns red once it has seen you
	cb._wake(rob)
	cb._creature_step(rob, 0.1)
	var alert_ok: bool = (rob["w"] as Walker).alert
	# the necrotic thing: down – and up again; down again for good – a sample of it
	var rd0: int = GameState.research_data
	cb._hurt_foe(nec, 9999.0, "explosive")
	var rise_ok: bool = nec["dead"] and float(nec.get("rise_t", 0.0)) > 0.0 and GameState.research_data == rd0
	cb._rise_step(nec, 3.1)
	rise_ok = rise_ok and not nec["dead"] and float(nec["st"]["health"]) > 0.0
	var h1: float = float(nec["st"]["health"])
	nec["hp_wait"] = 0.0
	cb._creature_step(nec, 1.0)
	rise_ok = rise_ok and float(nec["st"]["health"]) > h1                    # it heals while left be
	cb._hurt_foe(nec, 9999.0, "explosive")
	cb._rise_step(nec, 5.0)
	rise_ok = rise_ok and nec["dead"] and GameState.research_data > rd0
	Commands.suit_god = true
	# the places: rats in swarms in the sewers, keepers in the ruins, crawlers in the mine
	var place_ok := true
	var seen := {}
	for sd in 6:
		for th in ["sewer", "precursor", "mine", "research", "corp"]:
			var mp: GroundMap = DungeonGen53.build_inside({}, {"theme": th, "seed": 9000 + sd * 31, "danger": "red"}, 0)
			for fe in mp.get_meta("foes", []):
				seen[String(fe).split("@")[0]] = true
	place_ok = seen.has("mut_rat") and seen.has("pre_robot") and seen.has("cave_crawler") and seen.has("specimen") and seen.has("sec_robot") and seen.has("bandit_rifleman")
	var pest_map: GroundMap = DungeonGen53.build_inside({}, {"theme": "sewer", "seed": 4242, "danger": "yellow", "pest": true}, 1)
	var pf: Array = pest_map.get_meta("foes", [])
	var pest_ok: bool = pest_map.style == "sewer" and pf.any(func(x): return String(x).begins_with("rat_brood")) and pf.filter(func(x): return String(x).begins_with("mut_rat")).size() >= 4 \
		and not pf.any(func(x): return String(x).begins_with("bandit"))
	var rng := RandomNumberGenerator.new()
	rng.seed = 77
	var mm: Dictionary = Missions.ground_offer({"id": "t53f", "giver": "x", "giver_system": GameState.current_system}, GameState.current_system, rng, "pest")
	pest_ok = pest_ok and (mm.is_empty() or (bool(mm["site"].get("pest", false)) and String(mm["site"]["theme"]) == "sewer" and mm["site"].has("city")))
	# back
	Commands.suit_god = false
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(art_ok and spawn_ok and melee_ok and alert_ok and rise_ok and place_ok and pest_ok,
		"53f: creatures and machines – their pictures; a strike close up; the Precursor robot red once it sees you; the necrotic thing rises once, heals, leaves a sample; rats, keepers, crawlers, specimens and security robots in their places; the rat plague job with its brood mother  [%s]" % " ".join(PackedStringArray([str(art_ok), str(spawn_ok), str(melee_ok), str(alert_ok), str(rise_ok), str(place_ok), str(pest_ok)])))


## 53f-2 (Luz): the wild – the three grounds (jungle, coast, ice): the way from the ship to the find; water and crevasses
## block the way but not the view; the painter clears the water for the shader. On the ground: peaceful animals run
## from you and never fight, hunters guard their ground and let you go when you leave it; what they leave goes to the
## pockets and the hold; the find at the end; a hunting job; the goods in the gear shop.
const WildGen53 = preload("res://scripts/ground/wild_gen.gd")

func _test_wild(view: SystemView) -> void:
	var GD = GearData_53e
	var maps_ok := true
	var notes: Array = []
	for th in ["wild_jungle", "wild_coast", "wild_ice"]:
		for sd in [101, 2024, 77777]:
			var m: GroundMap = WildGen53.build({"type": "jungle", "id": "t"}, {"theme": th, "seed": sd, "danger": "yellow", "name": "T"}, 60.0, 30.0)
			var finds: Array = m.explore.filter(func(d): return String(d["kind"]) == "wild_find")
			var ok: bool = m.style == "wild" and m.has_meta("wild") and bool(m.get_meta("poi").get("wild", false)) and finds.size() == 1 \
				and m.ship_at != Vector2.INF and m.free_at(m.spawn, 4.0) and (m.get_meta("foes", []) as Array).size() >= 8 \
				and m.foe_spawns.size() == (m.get_meta("foes", []) as Array).size()
			if ok:
				ok = not m.path(m.spawn, (finds[0]["pos"] as Vector2) + Vector2(0, -2)).is_empty()     # the find can be reached
			var see: PackedByteArray = m.get_meta("see")
			ok = ok and (th == "wild_jungle" or see.has(1))
			if not ok:
				notes.append("%s/%d" % [th, sd])
			maps_ok = maps_ok and ok
	# the painter: water left clear for the shader, land painted
	var mj: GroundMap = WildGen53.build({"type": "jungle", "id": "t"}, {"theme": "wild_coast", "seed": 5, "danger": "yellow"}, 60.0, 30.0)
	var im: Image = mj.texture().get_image()
	var paint_ok: bool = im.get_pixel(4, 4).a < 0.1 and im.get_pixelv(Vector2i(mj.spawn) + Vector2i(30, 30)).a > 0.9
	var mt: Dictionary = WildGen53.WATER_LOOK
	paint_ok = paint_ok and mt.has("coast") and ResourceLoader.exists("res://shaders/wild_water.gdshader")
	# goods
	var goods_ok: bool = GD.kind("gd_hide") == "goods" and GD.price("gd_pelt") > 0 and GD.valid("gd_egg") and load("res://scripts/ui/gear_icons.gd").icon("gd_meat") != null \
		and GameData.commodities.has("exotic_hides") and GameData.commodities.has("game_meat")
	# down onto a coast: the animals there
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var e1: String = Commands.execute({"type": "debug_poi", "danger": "yellow", "seed": 31337, "theme": "wild_coast"})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null or g.map == null or not g.map.has_meta("wild"):
		check(false, "53f-2: down to the wild  [%s]" % e1)
		return
	g._close_lift_menu()
	Commands.suit_god = true
	gear.refill()
	var flee: Array = cb.foes.filter(func(o): return String(o.get("wild", "")) == "flee")
	var terr: Array = cb.foes.filter(func(o): return String(o.get("wild", "")) == "territory" and not bool(o.get("rooted", false)))
	var root: Array = cb.foes.filter(func(o): return bool(o.get("rooted", false)))
	var ai_ok: bool = not flee.is_empty() and not terr.is_empty() and not root.is_empty()
	if ai_ok:
		# a peaceful one: you come close – it runs, and it never fights
		var fa: Dictionary = flee[0]
		g.pilot.pos = (fa["w"] as Walker).pos + Vector2(30, 0)
		cb._wild_step(fa, 0.1)
		ai_ok = String(fa["state"]) == "flee" and not bool(fa["aware"])
		cb._hurt_foe(fa, 1.0, "kinetic")
		ai_ok = ai_ok and not bool(fa["aware"]) and float(fa.get("scare", 0.0)) > 0.0
		# a hunter: onto its ground – it comes; far away – it lets you go
		var ta: Dictionary = terr[0]
		g.pilot.pos = ta["home"] + Vector2(20, 0)
		cb._wild_step(ta, 0.1)
		var woke: bool = bool(ta["aware"])
		g.pilot.pos = ta["home"] + Vector2(float(ta["terr"]) * 3.0 + 40.0, 0)
		ta["hp_wait"] = 0.0
		for i in 8:
			cb._wild_step(ta, 0.5)
		ai_ok = ai_ok and woke and not bool(ta["aware"])
		# the one in the sand: hidden until you are right by it
		var ra: Dictionary = root[0]
		g.pilot.pos = (ra["w"] as Walker).pos + Vector2(140, 0)
		cb._wild_step(ra, 0.1)
		var hid: bool = not bool(ra["aware"])
		g.pilot.pos = (ra["w"] as Walker).pos + Vector2(20, 0)
		cb._wild_step(ra, 0.1)
		ai_ok = ai_ok and hid and bool(ra["aware"])
		# 0.7.53.36 (Luz): a peaceful animal is never picked by R, and no shot goes at it until you hunt it
		var fb: Dictionary = flee[flee.size() - 1]
		fb["provoked"] = false
		fb.erase("hunted")
		g.pilot.pos = (fb["w"] as Walker).pos + Vector2(40, 0)
		cb.active = null
		for k in 6:
			cb.next_target()
		var picked: bool = cb.active == fb
		cb.lock(fb)
		cb.lock_t = 0.0
		cb.pilot_cool = 0.0
		var n_shots: int = cb.shots.size()
		var hp_b: float = float(fb["st"]["health"])
		cb._pilot_fire(0.1)
		ai_ok = ai_ok and cb.peaceful(fb) and not picked and cb.shots.size() == n_shots and float(fb["st"]["health"]) == hp_b
		cb.hunt(fb)
		ai_ok = ai_ok and not cb.peaceful(fb)
		cb.unlock(fb)
	# loot: a big one brought down – into the pockets and the hold
	var big: Dictionary = cb.spawn("armor_crab", g.pilot.pos + Vector2(40, 0))
	for ii in gear.inv.size():
		gear.inv[ii] = {}
	var cargo0: float = f.cargo_used() if f != null else 0.0
	cb._hurt_foe(big, 99999.0, "explosive")
	var loot_ok: bool = gear.inv.any(func(s): return not (s as Dictionary).is_empty() and String(s["id"]).begins_with("gd_")) and (f == null or f.cargo_used() > cargo0)
	# the find at the end: the drone's cargo pod
	var cr0: int = GameState.credits
	var fd: Array = g.map.explore.filter(func(d): return String(d["kind"]) == "wild_find")
	var find_ok: bool = fd.size() == 1 and String(fd[0]["style"]) == "pod"
	if find_ok:
		fd[0]["state"] = "taken"
		g._poi_target_done(fd[0])
		find_ok = GameState.credits > cr0
	# the minimap knows the water
	var mm_ok: bool = WildGen53.mm_col(g.map, 1, 1).b > 0.4
	# a hunting job (where a jungle, ocean or ice world is near)
	var rng := RandomNumberGenerator.new()
	rng.seed = 53
	var hm: Dictionary = Missions.ground_offer({"id": "t53f2", "giver": "x", "giver_system": GameState.current_system}, GameState.current_system, rng, "hunt")
	var hunt_ok: bool = hm.is_empty() or (String(hm["site"]["theme"]).begins_with("wild_") and String(hm["site"].get("hunt_kind", "")) != "" and int(hm["site"]["hunt_n"]) >= 1)
	var hs := {"theme": "wild_ice", "seed": 9, "danger": "red", "hunt_kind": "frost_bear", "hunt_n": 1, "hunt_alpha": true}
	var hmap: GroundMap = WildGen53.build({"type": "ice", "id": "t"}, hs, 60.0, 30.0)
	hunt_ok = hunt_ok and hmap.has_meta("alpha_i") and String(hmap.get_meta("foes")[int(hmap.get_meta("alpha_i"))]) == "frost_bear@red"
	# back
	for ii in gear.inv.size():
		gear.inv[ii] = {}
	Commands.suit_god = false
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(maps_ok and paint_ok and goods_ok and ai_ok and loot_ok and find_ok and mm_ok and hunt_ok,
		"53f-2: the wild – jungle, coast and ice grounds (the find reachable from the ship, water seen across), painted with the water clear for the shader; grazers run and never fight, hunters guard their ground and let you go, the one in the sand waits hidden; never picked by R nor shot at until you hunt them; hides and meat to pockets and hold; the drone's cargo pod; hunting jobs with the old beast  [%s]%s" % [
			" ".join(PackedStringArray([str(maps_ok), str(paint_ok), str(goods_ok), str(ai_ok), str(loot_ok), str(find_ok), str(mm_ok), str(hunt_ok)])), (" " + ", ".join(PackedStringArray(notes))) if not notes.is_empty() else ""])


## Package 54 (Luz): the cloud cities – giants of inhabited systems have 1–2 (none far out), you go down only to them;
## the hangar's gate open to the sky; the plaza (its shops walked into, the lifts, seats people use, the deck going on
## beyond its ends), the giant's air; the skyrail – board at Central, the ride, the doors open at the Skyring, off.
const CloudGen54T = preload("res://scripts/ground/cloud_gen.gd")
const PoiData_54 = preload("res://data/poi.gd")

func _test_cloud(view: SystemView) -> void:
	var notes: Array = []
	# where they are
	var world_ok := true
	var n_in := 0
	var n_out := 0
	var sample: Array = []
	var outers := 0
	for sid0 in Universe.systems.size():
		if bool(Universe.systems[sid0].get("outer", false)):
			if outers < 8:
				sample.append(sid0)
				outers += 1
		elif sample.size() - outers < 20:
			sample.append(sid0)
	for sid in sample:
		for b in Universe.get_layout(sid)["planets"]:
			if not Universe.is_giant(b):
				continue
			var cs: Array = Universe.landing_sites(sid, b)
			if bool(Universe.systems[sid].get("outer", false)):
				n_out += cs.size()
				world_ok = world_ok and not Universe.can_land(b)
			else:
				n_in += 1
				world_ok = world_ok and cs.size() >= 1 and cs.size() <= 2 and cs.all(func(x): return String(x["kind"]) == "city" and bool(x.get("cloud", false))) 					and Universe.can_land(b) and not Universe.landable(b)
	world_ok = world_ok and n_in > 0 and n_out == 0
	if not world_ok:
		notes.append("giants %d in, %d sites out" % [n_in, n_out])
	var look_ok := true
	for gt in ["gas", "ice_giant", "red_gas", "toxic"]:
		var lk: Dictionary = CloudGen54T.giant_look(gt)
		look_ok = look_ok and (lk["bands"] as Array).size() == 5 and lk.has("haze") and lk.has("sky_top")
		look_ok = look_ok and not bool(GearShop.GearData.cloud_env(gt, false)["breathable"]) and bool(GearShop.GearData.cloud_env(gt, true)["breathable"])
	# down into one
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var e1: String = Commands.execute({"type": "debug_cloud", "giant": "gas", "power": "assembly", "air": "suit"})
	var g = main.ground
	if g == null or not g.is_cloud():
		check(false, "54: into a cloud city  [%s]" % e1)
		return
	var hangar_ok: bool = g.level == "hangar" and g.map.has_meta("clouds") and g.map.face_deco.any(func(d): return String(d["kind"]) == "force_gate") 		and g.clouds != null and g.env.is_empty()
	g._open_lift_menu(_zone_of(g.map, "lift"))
	var lift_ok: bool = g._lift_menu != null and (g._lift_menu.get_meta("keys") as Array).size() >= 4
	g._close_lift_menu()
	# the plaza
	g.go_level("cplaza", "lift")
	var m: GroundMap = g.map
	var shops: Array = m.zones.filter(func(z): return String(z.get("kind", "")) == "service")
	var benches: Array = m.zones.filter(func(z): return String(z.get("kind", "")) == "seat" and bool(z.get("npc_ok", false)))
	var o: int = CloudGen54T.PLAZA_MORE
	var plaza_ok: bool = not shops.is_empty() and benches.size() >= 3 and not m.lifts.is_empty() and m.has_meta("spindles") 		and not m.free_at(Vector2(o - 3, 18) * 16.0) and m.free_at(m.spawn) and m.t_at(5, CloudGen54T.P_RAIL - 2) == GroundMap.T.BLOCK
	var shop_in := true
	for z in shops:
		var r: Rect2 = z["rect"]
		shop_in = shop_in and m.path(m.spawn, r.get_center()).size() > 0
	plaza_ok = plaza_ok and shop_in
	var air_ok: bool = not g.env.is_empty() and g.needs_helmet()
	Commands.execute({"type": "debug_cloud", "giant": "gas", "air": "breathable", "level": "cplaza"})
	g = main.ground
	air_ok = air_ok and bool(g.env.get("breathable", false)) and not g.needs_helmet()
	# the skyrail
	g.rail_stop = 0
	g.go_level("cstation", "lift")
	var boards: Array = g.map.zones.filter(func(z): return String(z.get("kind", "")) == "board")
	var st_ok: bool = boards.size() == 3 and g.map.has_meta("car") and not g.map.lifts.is_empty() 		and g.map.face_deco.filter(func(d): return String(d["kind"]) == "gangway").size() == 3
	g._arrive = 0.0
	g.zone = boards[0] if not boards.is_empty() else {}
	g.use()
	var menu_ok: bool = g._lift_menu != null and (g._lift_menu.get_meta("keys") as Array).size() == 2      # 0.7.54.2: which way
	g._board(1)
	var ride_ok: bool = g.level == "ctrain" and g.map.has_meta("car_shell") and int(g.rail.get("to", -1)) == 1 and g.env.is_empty()
	var al: Dictionary = _zone_of(g.map, "alight")
	ride_ok = ride_ok and String(al.get("closed", "")) != ""
	var sc0: float = g.clouds.scroll
	for k in 400:
		g._rail_step(0.1)
	ride_ok = ride_ok and bool(g.rail["arrived"]) and String(al.get("closed", "x")) == "" and g.clouds.scroll > sc0 + 1000.0
	g._arrive = 0.0
	g.zone = al
	g.use()
	var ring_ok: bool = g.level == "cstation" and g.rail_stop == 1 and g.map.lifts.is_empty() and not _zone_of(g.map, "scope").is_empty() and menu_ok
	Commands.execute({"type": "debug_skyrail", "action": "info"})
	# 0.7.54.2 (Luz): the gas works – the third stop; the Gas Exchange; now and then a great freighter at the berth
	Commands.execute({"type": "debug_cloud", "giant": "gas", "level": "cstation", "stop": 2, "freighter": "yes"})
	g = main.ground
