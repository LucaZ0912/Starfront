func _test_foot_tactics(view: SystemView) -> void:
	# 0.7.52.9 (Luz): the controls in two tabs, Space and Ground – every on-foot key on Ground, none of them on Space
	var kp := KeybindPanel.new()
	add_child(kp)
	var on_ground: bool = kp._buttons.has("foot_run:0") == false and kp._buttons.has("cmd_lock:0")
	kp._set_tab("ground")
	on_ground = on_ground and kp._buttons.has("foot_run:0") and kp._buttons.has("foot_belt_1:0") and kp._buttons.has("foot_grenade:0") and not kp._buttons.has("cmd_lock:0")
	kp.queue_free()
	check(on_ground, "0.7.52.9: the controls window in two tabs – Space and Ground, every key on foot rebindable (run, belt, grenade, Shift+R)")
	var GD = GearShop.GearData
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	gear.weapons[0] = "wp_laser_rifle:C"
	var e1 := Commands.execute({"type": "debug_arena", "world": "desert", "foes": []})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null:
		check(false, "0.7.52.5: the arena opens  [%s]" % e1)
		return
	gear.refill()
	Commands.suit_god = false
	# a clear patch: the pilot and a spot 60 px east with nothing between
	var me := Vector2.INF
	for k in 200:
		var q := Vector2(randf_range(0.55, 0.9) * g.map.w, randf_range(0.2, 0.8) * g.map.h) * 16.0
		var ok := true
		for dx in range(-80, 81, 16):
			for dy in range(-40, 41, 16):
				ok = ok and g.map.free_at(q + Vector2(dx, dy), 5.0) and cb.cover_at(q + Vector2(dx, dy)) == 0
		if ok:
			me = q
			break
	if me == Vector2.INF:
		check(false, "0.7.52.5: a clear patch in the arena")
		return
	g.pilot.pos = me
	g.pilot.position = me * GroundMap.SCALE
	# the grenade belt; a frag thrown by hand at two foes hurts both, the far one less
	var dbg_ok: bool = Commands.execute({"type": "debug_gear", "grenades": true}) == "" and String(gear.grenades[0]["id"]) == "gr_frag"
	var fa: Dictionary = cb.spawn("bandit_rifleman", me + Vector2(60, 0))
	var fb: Dictionary = cb.spawn("bandit_rifleman", me + Vector2(60, 40))
	cb.frozen = true
	var n0 := int(gear.grenades[0]["n"])
	gear.gr_sel = 0
	var pressed: bool = cb.grenade_down()
	cb.gr_aim = me + Vector2(60, 0)
	cb.gr_held = 0.5
	var msg: String = cb.grenade_up()
	for i in 12:
		cb.step(0.1, Vector2.ZERO)
	var ha := float(fa["st"]["shield"]) + float(fa["st"]["armor"]) + float(fa["st"]["health"])
	var hb := float(fb["st"]["shield"]) + float(fb["st"]["armor"]) + float(fb["st"]["health"])
	var full := float(fa["mx"]["shield"]) + float(fa["mx"]["armor"]) + float(fa["mx"]["health"])
	var frag_ok: bool = pressed and msg != "" and int(gear.grenades[0]["n"]) == n0 - 1 and ha < full - 20.0 and hb < full and hb > ha
	# 0.7.52.9 (Luz): grenade places of their own (light combat suit: 2 + 3 on the belt), stacks of 10, X tapped switches
	cb.grenade_down()
	cb.gr_held = 0.05
	cb.grenade_up()
	var sel_ok: bool = gear.gr_sel == 1 and gear.grenades.size() == 2 and gear.belt.size() == 4 and GD.stack_max("gr_frag") == 10
	cb.grenade_down()
	cb.gr_held = 0.05
	cb.grenade_up()
	sel_ok = sel_ok and gear.gr_sel == 0
	gear.grenades[1] = {}
	for ii in gear.inv.size():
		gear.inv[ii] = {}
	gear.inv[0] = {"id": "gr_emp", "n": 10}
	gear.inv[1] = {"id": "cs_medkit", "n": 2}
	var eq1: String = gear.equip_from_inv(0)
	var eq2: String = gear.equip_from_inv(1)
	sel_ok = sel_ok and eq1 == "" and String(gear.grenades[1]["id"]) == "gr_emp" and int(gear.grenades[1]["n"]) == 10 and eq2 == "" \
		and gear.belt.any(func(x): return not (x as Dictionary).is_empty() and String(x["id"]) == "cs_medkit") and not gear.belt.any(func(x): return not (x as Dictionary).is_empty() and GD.is_grenade(String(x["id"])))
	frag_ok = frag_ok and sel_ok
	# Shift+R: the nearest foe; its key reads Shift+R
	cb.locks.clear()
	cb.active = null
	cb.nearest_target()
	var near_ok: bool = cb.active == fa and Keybinds.key_text("foot_target_near") == "Shift+R" and Keybinds.key_text("foot_grenade") == "X" \
		and Keybinds.event_to_desc(Keybinds.desc_to_event({"k": KEY_R, "shift": true})).get("shift", false) and not Keybinds.same({"k": KEY_R}, {"k": KEY_R, "shift": true})
	frag_ok = frag_ok and near_ok
	# EMP: the shields go
	var fc: Dictionary = cb.spawn("bandit_boss", me + Vector2(70, -20))
	cb.throw_grenade(null, me + Vector2(70, -20), "gr_emp")
	for i2 in 12:
		cb.step(0.1, Vector2.ZERO)
	var emp_ok: bool = float(fc["st"]["shield"]) < 1.0 and float(fc["st"]["health"]) == float(fc["mx"]["health"])
	# smoke between: worse aim both ways, and an unaware foe does not see through it
	var c_open: float = cb.chance_at_pilot(fc)
	cb.throw_grenade(null, me + Vector2(35, -10), "gr_smoke")
	for i3 in 10:
		cb.step(0.1, Vector2.ZERO)
	var smoke_ok: bool = cb.smoke_between(me, me + Vector2(70, -20)) and cb.chance_at_pilot(fc) < c_open * 0.5
	cb.clouds.clear()
	# a shield dome round you: fire from outside breaks on it (and wears it down), a blast outside does not reach you
	cb.throw_grenade(null, me, "gr_shield")
	for i4 in 8:
		cb.step(0.1, Vector2.ZERO)
	var h0: float = gear.health + gear.shield + gear.armor
	var dm: Dictionary = cb.domes[0] if not cb.domes.is_empty() else {}
	var hp0: float = float(dm.get("hp", 0.0))
	for i5 in 6:
		cb.fire(fc, null, GD.stats("wp_rifle:C"))
	for i6 in 10:
		cb.step(0.1, Vector2.ZERO)
	var outside := me + Vector2(float(dm.get("r", 50.0)) + 20.0, 0)
	cb._explode(outside, 60.0, 80.0, "explosive", fc)
	var dome_ok: bool = not dm.is_empty() and is_equal_approx(gear.health + gear.shield + gear.armor, h0) and float(dm["hp"]) < hp0 \
		and cb.dome_between(me + Vector2(200, 0), me) != null and cb.dome_between(me, me + Vector2(200, 0)) == null
	# 0.7.52.6: in the tactical view a dome shadows what is in and behind it for a foe outside – not for you inside;
	# a shot from outside at a target beyond the dome breaks on it too
	var fdome: Vector2 = me + Vector2(float(dm.get("r", 50.0)) + 18.0, 0)
	var rays_foe: Array = cb.cast(fdome, 300.0)
	var rays_me: Array = cb.cast(me, 300.0)
	dome_ok = dome_ok and not cb.lit_in(rays_foe, fdome, me) and not cb.lit_in(rays_foe, fdome, me - Vector2(float(dm.get("r", 50.0)) - 10.0, 0)) \
		and cb.lit_in(rays_me, me, fdome) and cb.dome_between(fdome, me - Vector2(float(dm.get("r", 50.0)) + 20.0, 0)) != null
	cb.domes.clear()
	# 0.7.52.6: smoke in the tactical view – what lies behind the cloud is marked (shots aim badly there)
	cb.clouds.append({"pos": me + Vector2(60, 0), "r": 30.0, "t": 5.0, "time": 8.0, "seed": 1})
	var rays_s: Array = cb.cast(me, 300.0)
	var behind: Array = rays_s[0]
	var smoke_marked: bool = behind.size() >= 2 and not bool(behind[0][2]) and bool(behind[-1][2]) and float(behind[-1][0]) <= 35.0
	var side_clear: bool = rays_s[90].all(func(sg): return not bool(sg[2]))
	smoke_ok = smoke_ok and smoke_marked and side_clear
	cb.clouds.clear()
	# a high-cover wall shelters from a blast
	var shelter_ok := false
	for ob in g.map.objects:
		if String(ob["kind"]) == "bulwark" and int(ob["w"]) > int(ob["h"]) and not shelter_ok:
			var r := Rect2(Vector2(int(ob["x"]), int(ob["y"])) * 16.0, Vector2(int(ob["w"]), int(ob["h"])) * 16.0)
			shelter_ok = cb.blast_share(Vector2(r.get_center().x, r.position.y - 14.0), Vector2(r.get_center().x, r.end.y + 14.0), 80.0) == 0.0 \
				and cb.blast_share(Vector2(r.get_center().x, r.end.y + 30.0), Vector2(r.get_center().x, r.end.y + 14.0), 80.0) > 0.5
	# the kinds: pirates in black and red, guards in their colours, all foes weaker in body than you
	var pr: Dictionary = cb.spawn("pirate_raider", me + Vector2(-60, 30))
	var gs: Dictionary = cb.spawn("guard_sergeant", me + Vector2(-60, -30))
	var look_ok: bool = String((pr["w"] as Walker).look.get("livery", "")) == "pirate" and String((gs["w"] as Walker).look.get("livery", "")) == "independent" \
		and ChibiArt.LIVERY.has("pirate") and FoeData52.KINDS.size() == FoeData52.FOES.size() and FoeData52.FOES.values().all(func(x): return FoeData52.ROLE.has(String(x["role"])))
	# the sniper: far better aim, far slower fire
	var sn: Dictionary = cb.spawn("pirate_sniper", me + Vector2(0, -60))
	var rif: Dictionary = cb.spawn("bandit_rifleman", me + Vector2(0, 60))
	var sniper_ok: bool = float(sn["aim"]) >= 1.5 and float(sn["rof"]) <= 0.5 and float(sn["sight"]) > FoeData52.SIGHT * 2.0
	# the leader falls: its band loses heart
	var fl0 := float(pr["flee"])
	var cap: Dictionary = cb.spawn("pirate_captain", me + Vector2(-90, 0))
	cb._hurt_foe(cap, 99999.0, "explosive")
	var morale_ok: bool = float(pr["flee"]) > fl0 + 0.2 and float(gs["flee"]) < 0.2
	# a thrower throws when you dig in; nobody does while you keep moving
	for o in cb.alive():
		cb._hurt_foe(o, 99999.0, "explosive")
	var thr: Dictionary = cb.spawn("pirate_grenadier", me + Vector2(110, 0))
	cb._wake(thr)
	cb.frozen = false
	cb.camp_t = 0.0
	var thrown_moving := false
	for i7 in 15:
		cb._camp_at = Vector2.INF                       # moving all the while
		cb.step(0.1, Vector2.ZERO)
		thrown_moving = thrown_moving or not cb.grenades.is_empty()
	cb.camp_t = FoeData52.THROWER_CAMP + 1.0
	thr["gr_cool"] = 0.0
	var g0 := int(thr["grenades"])
	cb._foe_step(thr, 0.05)
	var thrower_ok: bool = int(thr["grenades"]) == g0 - 1 and not cb.grenades.is_empty() and cb.grenades[-1]["from"] == thr
	# a flanker heads for a spot where your cover does not help you
	cb.grenades.clear()
	var fl: Dictionary = cb.spawn("pirate_raider", me + Vector2(150, -60))
	cb._wake(fl)
	cb._decide(fl, (fl["w"] as Walker).pos.distance_to(me), cb.sight((fl["w"] as Walker).pos, me), 200.0)
	var flank_ok: bool = String(fl["state"]) in ["move", "fight"] and (fl["goal"] == Vector2.INF or not cb.sight(fl["goal"], me)["cover"])
	# back
	cb.frozen = true
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(dbg_ok and frag_ok and emp_ok and smoke_ok and dome_ok and shelter_ok and look_ok and sniper_ok and morale_ok and thrower_ok and flank_ok,
		"0.7.52.5: grenades (a frag thrown by hand hurts near more than far, EMP takes shields, smoke spoils aim, a shield dome stops fire and blasts from outside, high cover shelters); pirates and guards in their colours; the sniper's aim and slow fire; a fallen leader breaks its band; a thrower throws at you dug in; a flanker seeks your open side  [%s]" % " ".join(PackedStringArray([str(dbg_ok), str(frag_ok), str(emp_ok), str(smoke_ok), str(dome_ok), str(shelter_ok), str(look_ok), str(sniper_ok), str(morale_ok), str(thrower_ok), str(flank_ok)])))


## 0.7.52.11: ground combat drones – the combat suits' drone place, quality F–A, laser (heat), kinetic (magazine, back
## to reload from the suit), kamikaze (dives on C, a long rebuild), shot down and rebuilt, foes shooting at it.
func _test_foot_drones(view: SystemView) -> void:
	var GD = GearShop.GearData
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	# data: only the combat suits have a drone place; quality makes them better; more rounds and energy for every suit
	var data_ok: bool = int(GD.stats("suit_mil_light:C").get("drones", 0)) == 1 and int(GD.stats("suit_mil_heavy:C").get("drones", 0)) == 1 \
		and int(GD.stats("suit_civil:C").get("drones", 0)) == 0 and GD.DRONES.size() == 3 and GD.kind("dr_laser:C") == "drone" and GD.valid("dr_kamikaze:A") \
		and int(GD.stats("dr_kinetic:A")["mag"]) > int(GD.stats("dr_kinetic:F")["mag"]) and float(GD.stats("dr_laser:A")["heat_max"]) > float(GD.stats("dr_laser:F")["heat_max"]) \
		and float(GD.stats("dr_laser:A")["shield"]) > float(GD.stats("dr_laser:F")["shield"]) and float(GD.stats("dr_kamikaze:C")["rebuild"]) >= 2.0 * float(GD.stats("dr_laser:C")["rebuild"]) \
		and int(GD.stats("suit_mil_light:C")["ammo"]) >= 200 and float(GD.stats("suit_civil:C")["energy"]) >= 130.0 and GD.all_ids().has("dr_laser:B")
	# equipping: into the drone place of a combat suit, not on a civilian suit
	gear.suit = "suit_civil:C"
	gear._fit_slots()
	for i in gear.inv.size():
		gear.inv[i] = {}
	gear.inv[0] = {"id": "dr_laser:C", "n": 1}
	var civ_no: bool = gear.equip_from_inv(0) != "" and gear.drones.is_empty()
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var eq_ok: bool = civ_no and gear.equip_from_inv(0) == "" and String(gear.drones[0]) == "dr_laser:C"
	gear.weapons[0] = "wp_laser_rifle:C"
	# the arena: the drone takes off from your back
	Commands.execute({"type": "debug_arena", "world": "desert", "foes": []})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null:
		check(false, "0.7.52.11: the arena opens")
		return
	gear.refill()
	Commands.suit_god = false
	for i2 in 10:
		cb.step(0.1, Vector2.ZERO)
	# 0.7.52.12 (Luz): it sits on your back, switched off, until C – then it takes off
	var up_ok: bool = cb.drone_alive() and not cb.drone_flying() and String(cb.drone["state"]) == "docked"
	var umsg: String = cb.drone_command()
	for i2b in 10:
		cb.step(0.1, Vector2.ZERO)
	up_ok = up_ok and umsg.contains("up") and String(cb.drone["kind"]) == "laser" and String(cb.drone["state"]) == "hover" \
		and (cb.drone["pos"] as Vector2).distance_to(g.pilot.pos) < 30.0
	# the laser fights your target and heats up; overheated it stops until cool
	var me: Vector2 = g.pilot.pos
	var foe: Dictionary = cb.spawn("bandit_boss", cb._free_near(me + Vector2(70, 0)))
	cb._wake(foe)
	cb.frozen = true
	cb.lock(foe)
	cb.lock_t = 0.0
	var h0 := float(foe["st"]["shield"]) + float(foe["st"]["armor"]) + float(foe["st"]["health"])
	gear.weapons[0] = ""                                 # only the drone fires
	gear.weapons[1] = ""
	for i3 in 20:
		cb.step(0.1, Vector2.ZERO)
	var h1 := float(foe["st"]["shield"]) + float(foe["st"]["armor"]) + float(foe["st"]["health"])
	var laser_ok: bool = cb.fight and h1 < h0 and float(cb.drone["heat"]) > 0.0
	cb.drone["heat"] = 200.0
	cb.drone["over"] = true
	var shots0: int = cb.shots.size()
	cb.step(0.1, Vector2.ZERO)
	laser_ok = laser_ok and bool(cb.drone["over"]) and cb.shots.size() <= shots0
	# it turns towards its target when it fires
	var to_t: float = ((foe["w"] as Walker).pos - (cb.drone["pos"] as Vector2)).angle()
	laser_ok = laser_ok and absf(angle_difference(float(cb.drone["head"]), to_t)) < 0.6
	# C again: back on your back, switched off – foes cannot shoot it there
	cb.drone["over"] = false
	cb.drone["heat"] = 0.0
	var rmsg: String = cb.drone_command()
	for i3b in 10:
		cb.step(0.1, Vector2.ZERO)
	laser_ok = laser_ok and rmsg.contains("back") and String(cb.drone["state"]) == "docked" and not cb.drone_flying()
	cb.drone_command()
	# the kinetic one: its magazine empty, it flies back and reloads from the suit
	Commands.execute({"type": "debug_gear", "drone": "dr_kinetic:C"})
	cb.step(0.1, Vector2.ZERO)
	cb.drone_command()
	for i4 in 10:
		cb.step(0.1, Vector2.ZERO)
	var kin_ok: bool = cb.drone_alive() and String(cb.drone["kind"]) == "kinetic"
	cb.drone["ammo"] = 1
	var a0: int = gear.ammo
	for i5 in 80:
		cb.step(0.1, Vector2.ZERO)
	kin_ok = kin_ok and String(cb.drone["state"]) in ["hover", "launch"] and int(cb.drone["ammo"]) > 1 and gear.ammo < a0
	# shot down: a new one after its rebuild time
	cb._hurt_drone(99999.0, "kinetic")
	var down_ok: bool = String(cb.drone["state"]) == "down" and is_equal_approx(cb.drone_rebuild, float(GD.stats("dr_kinetic:C")["rebuild"]))
	for i6 in 10:
		cb.step(0.1, Vector2.ZERO)
	down_ok = down_ok and cb.drone.is_empty() and cb.drone_rebuild > 0.0 and cb.drone_command().contains("rebuilt")
	cb.drone_rebuild = 0.05
	for i7 in 3:
		cb.step(0.1, Vector2.ZERO)
	down_ok = down_ok and cb.drone_alive() and String(cb.drone["state"]) == "docked"
	cb.drone_command()
	for i7b in 8:
		cb.step(0.1, Vector2.ZERO)
	# foes shoot at it: a hit wears it down
	var sh0 := float(cb.drone["st"]["shield"]) + float(cb.drone["st"]["armor"])
	cb.drone["regen_wait"] = 0.0
	var hit_d := false
	for i8 in 30:
		cb.fire(foe, cb.drone, GD.stats("wp_rifle:C"))
	for i9 in 5:
		cb.step(0.1, Vector2.ZERO)
	hit_d = not cb.drone_alive() or float(cb.drone["st"]["shield"]) + float(cb.drone["st"]["armor"]) < sh0
	# the kamikaze: dives on C at your target, bursts there – and takes long to rebuild
	Commands.execute({"type": "debug_gear", "drone": "dr_kamikaze:C"})
	cb.drone = {}
	cb.drone_rebuild = 0.0
	for i10 in 3:
		cb.step(0.1, Vector2.ZERO)
	var kup: String = cb.drone_command()                  # the kamikaze: C to take off, C again to send it
	for i10b in 8:
		cb.step(0.1, Vector2.ZERO)
	# 0.7.52.19 (Luz): holding C calls it back instead – docked again, then up once more
	var rec_ok: bool = cb.drone_kamikaze_up(0) and cb.drone_recall(0).contains("back")
	for i10c in 20:
		cb.step(0.1, Vector2.ZERO)
	rec_ok = rec_ok and String(cb.drone["state"]) == "docked" and not cb.drone_kamikaze_up(0)
	cb.drone_command()
	for i10d in 8:
		cb.step(0.1, Vector2.ZERO)
	cb.lock(foe)
	var hk0 := float(foe["st"]["shield"]) + float(foe["st"]["armor"]) + float(foe["st"]["health"])
	var hp_me: float = gear.health
	var kmsg: String = cb.drone_command()
	for i11 in 30:
		cb.step(0.1, Vector2.ZERO)
		if cb.drone.is_empty():
			break
	var hk1 := float(foe["st"]["shield"]) + float(foe["st"]["armor"]) + float(foe["st"]["health"])
	var kam_ok: bool = kup.contains("again") and kmsg.contains("away") and cb.drone.is_empty() and (hk1 < hk0 or foe["dead"]) and is_equal_approx(gear.health, hp_me) \
		and is_equal_approx(cb.drone_rebuild, float(GD.stats("dr_kamikaze:C")["rebuild"])) and g.combat_hud != null
	# 0.7.52.12 (Luz): rounds are refilled at a supply point and aboard
	gear.ammo = 0
	gear.charge()
	var full_ammo: int = int(gear.totals()["ammo"])
	var ammo_ok: bool = gear.ammo == full_ammo
	gear.ammo = 3
	gear.aboard()
	ammo_ok = ammo_ok and gear.ammo == full_ammo and g.map.zones.any(func(z): return String(z.get("kind", "")) == "charge" and String(z["title"]).contains("ammunition"))
	kam_ok = kam_ok and ammo_ok
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(data_ok and eq_ok and up_ok and laser_ok and kin_ok and down_ok and hit_d and kam_ok and rec_ok,
		"0.7.52.11: ground combat drones – the combat suits' drone place, quality F–A, more rounds and energy for every suit; the laser drone fights your target and overheats, C recalls it; the kinetic one flies back and reloads from the suit; shot down and rebuilt; foes' hits wear it down; the kamikaze dives on C and bursts, sparing you, with a long rebuild  [%s]" % " ".join(PackedStringArray([str(data_ok), str(eq_ok), str(up_ok), str(laser_ok), str(kin_ok), str(down_ok), str(hit_d), str(kam_ok)])))


## 0.7.52.14: the Covenant's Pathfinder armour – no drone place, the Red Arm Laser built into its first weapon place
## (it stays with the suit), sold only in the Covenant's lands; the laser charges whatever is in hand, cuts through cover,
## the arm raised.
## Package 53a: sites to explore – found on the map per visit (ruins), generated: a pad outside, rooms and corridors
## three tiles wide, the vault behind a blast door (its box on the wall, the control room's terminal, an air shaft),
## guards, caches, tablets, the relic; the "possible targets" window, the minimap; the target done uses the site up.
func _test_poi(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	# sites per visit: the same for a visit, others for the next; a used one is gone
	var L := Universe.get_layout(f.system_id)
	var found := 0
	var same := true
	var v0 := int(GameState.poi_visits.get(str(f.system_id), 0))
	for vi in 12:
		GameState.poi_visits[str(f.system_id)] = v0 + vi
		for b in L["planets"] + L.get("moons", []):
			if Universe.landable(b):
				var a1: Array = GameState.pois_for(f.system_id, b)
				var a2: Array = GameState.pois_for(f.system_id, b)
				found += a1.size()
				same = same and a1.size() == a2.size() and (a1.is_empty() or String(a1[0]["id"]) == String(a2[0]["id"]))
	GameState.poi_visits[str(f.system_id)] = v0
	var static_ruins := false
	for b2 in L["planets"] + L.get("moons", []):
		if Universe.landable(b2):
			for s in Universe.landing_sites(f.system_id, b2):
				if String(s["kind"]) == "ruins" and not bool(s.get("poi", false)):
					static_ruins = true
	var map_ok: bool = found > 0 and same and not static_ruins
	# a generated site: the outside first – the ruin in the north, its gate shut, its panel beside it
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	var e: String = Commands.execute({"type": "debug_poi", "danger": "yellow", "seed": 5301, "gate": "panel"})
	var g = main.ground
	if g == null or e != "" or g.level != "landing":
		check(false, "53a: the site opens  [%s]" % e)
		return
	gear.refill()
	var gate: Dictionary = g._poi_gate()
	var gpanel: Dictionary = {}
	for d0 in g.map.explore:
		if String(d0["kind"]) == "panel" and int(d0.get("door", -1)) >= 0:
			gpanel = d0
	var zin: Dictionary = {}
	for z0 in g.map.zones:
		if String(z0.get("kind", "")) == "dungeon_in":
			zin = z0
	var out_ok: bool = not gate.is_empty() and String(gate["state"]) != "open" and not gpanel.is_empty() and not zin.is_empty() \
		and g.map.has_meta("fog") and g.fog != null and g.map.has_meta("poi")
	# the window on arrival (only outside), the minimap
	if g._lift_menu == null:
		g._poi_window()                                      # (it opens deferred on arrival)
	var win_ok: bool = g._lift_menu != null and g._mm != null
	g._close_lift_menu()
	g._arrive = 0.0
	g.zone = zin
	g.use()
	var shut_out: bool = g.level == "landing"              # the gate is shut: you stay outside
	g._explore_effect(gpanel, "door")
	out_ok = out_ok and shut_out and String(gate["state"]) == "open"
	g._arrive = 0.0
	g.zone = zin
	g.use()
	if g.level != "dungeon" or g.combat == null:
		check(false, "53a: into the ruin  [%s]" % g.level)
		return
	gear.refill()
	# 0.7.53.4 (Luz): the first level – the ancient lift down (woken first if it sleeps), the platform sinks
	var lift: Dictionary = {}
	for d9 in g.map.explore:
		if String(d9["kind"]) == "ancient_lift":
			lift = d9
	var lift_ok: bool = not lift.is_empty() and not g.map.explore.any(func(x): return String(x["kind"]) == "relic") 		and not _zone_of(g.map, "dungeon_down").is_empty() and int(g.map.get_meta("poi")["levels"]) == 2
	g.pilot.pos = (lift["pos"] as Vector2) + Vector2(0, 10)
	g.zone = _zone_of(g.map, "dungeon_down")
	g._arrive = 0.0
	if String(lift["state"]) == "dormant":
		g.use()
		lift_ok = lift_ok and g._sink.is_empty()          # asleep: it will not go
		g._explore_effect({}, "lift")
	lift_ok = lift_ok and String(lift["state"]) == "active"
	g.use()
	lift_ok = lift_ok and not g._sink.is_empty()
	for st in 10:
		if not g._sink.is_empty():
			g._sink_step(0.3)
	lift_ok = lift_ok and g.depth == 1 and g.level == "dungeon" and g._sink.is_empty() and not _zone_of(g.map, "dungeon_up").is_empty()
	gear.refill()
	# inside: the Precursors' ruin (its deepest level)
	var kinds := {}
	for d in g.map.explore:
		kinds[String(d["kind"])] = int(kinds.get(String(d["kind"]), 0)) + 1
	var door: Dictionary = {}
	var term: Dictionary = {}
	var relic: Dictionary = {}
	var crate: Dictionary = {}
	var cryst: Dictionary = {}
	for d2 in g.map.explore:
		match String(d2["kind"]):
			"rust_door":
				door = d2
			"terminal":
				term = d2
			"relic":
				relic = d2
			"crystals":
				cryst = d2
			"crate":
				if crate.is_empty() and not bool(d2.get("welded", false)):
					crate = d2
	var panel_wall: bool = g.map.explore.any(func(x): return String(x["kind"]) == "panel" and bool(x.get("wall", false)))
	var welded: bool = g.map.explore.any(func(x): return String(x["kind"]) == "crate" and bool(x.get("welded", false)))
	var has_out: bool = g.map.zones.any(func(z1): return String(z1.get("kind", "")) == "dungeon_up")
	var built_ok: bool = int(kinds.get("rust_door", 0)) == 1 and int(kinds.get("blastdoor", 0)) == 0 and int(kinds.get("crystals", 0)) == 1 and panel_wall \
		and int(kinds.get("tablet", 0)) == 3 and int(kinds.get("crate", 0)) >= 4 and welded and bool(relic.get("target", false)) \
		and g.combat.foes.size() >= 3 and g.map.has_meta("poi") and (g.map.get_meta("poi")["targets"] as Array).size() == 5 \
		and g.map.style == "precursor" and g.fog != null and has_out
	g._mm_tile = Vector2i(-99, -99)
	g._poi_reveal()
	var seen := 0
	for sb in g.poi_seen:
		seen += int(sb)
	win_ok = win_ok and seen > 20
	# wide ways: every floor tile (not the air shaft) has a floor neighbour on both sides one way, or two in a row
	var narrow := 0
	for y in range(2, g.map.h - 2):
		for x in range(2, g.map.w - 2):
			if GroundMap.walkable_t(g.map.t_at(x, y)) and g.map.floor_kind[y * g.map.w + x] != 16:
				var wk := func(xx: int, yy: int) -> bool: return GroundMap.walkable_t(g.map.t_at(xx, yy)) or g.map.t_at(xx, yy) == GroundMap.T.BLOCK
				var run_h: bool = (wk.call(x - 1, y) and wk.call(x + 1, y)) or (wk.call(x - 1, y) and wk.call(x - 2, y)) or (wk.call(x + 1, y) and wk.call(x + 2, y))
				var run_v: bool = (wk.call(x, y - 1) and wk.call(x, y + 1)) or (wk.call(x, y - 1) and wk.call(x, y - 2)) or (wk.call(x, y + 1) and wk.call(x, y + 2))
				if not run_h or not run_v:
					narrow += 1
	var wide_ok: bool = narrow == 0
	# the vault: shut off; the computer opens the old door and puts the crystals down; the relic read uses the site up
	var vault_p: Vector2 = (relic["pos"] as Vector2) + Vector2(0, 20)
	var acts: Array = term.get("actions", [])
	var shut_ok: bool = g.map.path(g.map.spawn, vault_p).is_empty() and String(cryst["state"]) != "off" and acts.has("crystals")
	g._hack_done(term, "door")
	g._hack_done(term, "crystals")
	var open_ok: bool = String(door["state"]) == "open" and String(cryst["state"]) == "off" and not g.map.path(g.map.spawn, vault_p).is_empty()
	var rd := GameState.research_data
	g.scan_done(relic)
	var done_ok: bool = GameState.poi_used.has(String(g._site["id"])) and GameState.research_data > rd
	# a cache: credits and something; the EMP trap; a find for the Museum
	var cr0 := GameState.credits
	g._loot(crate)
	var loot_ok: bool = GameState.credits > cr0 and String(crate["state"]) == "open"
	g._explore_effect({}, "emp")
	var emp_ok: bool = g.combat.emp_t > 0.0 and float(gear.shield) <= 0.0
	var mf := GameState.museum_finds.size()
	GameState.museum_find("pr_lens")
	emp_ok = emp_ok and GameState.museum_finds.size() == mf + 1
	GameState.museum_finds.resize(mf)
	# back out: in front of the gate, which stays open
	g.depth = 0
	g.go_level("landing", "dungeon_out")
	var gate2: Dictionary = g._poi_gate()
	var back_ok: bool = g.level == "landing" and String(gate2.get("state", "")) == "open" and g.pilot.pos.distance_to(gate2["pos"]) < 110.0
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(map_ok and out_ok and lift_ok and built_ok and win_ok and wide_ok and shut_ok and open_ok and done_ok and loot_ok and emp_ok and back_ok,
		"53a: sites to explore – ruins found per visit (the same within a visit, no fixed ruins); outside the ruin in the north with its gate shut (its panel opens it, fog); the ancient lift down (woken if it sleeps); below the Precursors' ruin: rust door, crystal guardians, 3 tablets, caches (one welded), the relic, raiders; the targets window and the minimap; ways three wide; the computer opens the door and puts the crystals down; the relic read uses the site up; a cache pays; the EMP trap; a Museum find; back out before the gate  [%s]" % " ".join(PackedStringArray([str(map_ok), str(out_ok), str(lift_ok), str(built_ok), str(win_ok), str(wide_ok), str(shut_ok), str(open_ok), str(done_ok), str(loot_ok), str(emp_ok), str(back_ok)])))


## 0.7.53.3 (Luz, package 53b): a city's way down – the back alley (a lift building, a manhole), the sewers (long wide
## tunnels with a canal, a flooded tunnel drained at the pumps or a valve, tripwires) and below them the dealer's
## hideout (a steel door with a code lock, the office with the computer and the safe); levels joined by ladders;
## every site rolled anew; more cover.
func _test_sewer(view: SystemView) -> void:
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	# variety: the structure is rolled per site
	var sigs := {}
	for sd in 6:
		var mm: GroundMap = DungeonGen53.build_inside({}, {"theme": "sewer", "seed": 700 + sd, "danger": "yellow"}, 0)
		var nroom := 0
		for y in mm.h:
			for x in mm.w:
				if mm.floor_kind[y * mm.w + x] == 21 and GroundMap.walkable_t(mm.t_at(x, y)):
					nroom += 1
		sigs["%d_%d_%d" % [mm.w, mm.h, nroom]] = true
	var pm: GroundMap = DungeonGen53.build_inside({}, {"theme": "precursor", "seed": 701, "danger": "yellow"}, 0)
	var var_ok: bool = sigs.size() >= 4 and pm.objects.size() >= 12
	# the site, outside: the alley
	var e: String = Commands.execute({"type": "debug_poi", "danger": "yellow", "seed": 5303, "theme": "sewer"})
	var g = main.ground
	if g == null or e != "":
		check(false, "53b: the sewer site opens  [%s]" % e)
		return
	gear.refill()
	var alley_ok: bool = g.map.style == "alley" and _has_kind(g.map, "manhole") and not (_zone_of(g.map, "dungeon_in") as Dictionary).is_empty() \
		and not (_zone_of(g.map, "lift") as Dictionary).is_empty() and g.map.lifts.size() == 2 and int(g.map.get_meta("poi")["levels"]) == 2
	if g._lift_menu == null:
		g._poi_window()
	alley_ok = alley_ok and g._lift_menu != null
	g._close_lift_menu()
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_in")
	g.use()
	if g.level != "dungeon" or g.combat == null:
		check(false, "53b: down into the sewers  [%s]" % g.level)
		return
	# level 1: the sewers
	var canal := 0
	var grate := 0
	var deep := 0
	for y2 in g.map.h:
		for x2 in g.map.w:
			match g.map.floor_kind[y2 * g.map.w + x2]:
				18:
					canal += int(GroundMap.walkable_t(g.map.t_at(x2, y2)))
				19:
					grate += 1
				20:
					deep += int(g.map.t_at(x2, y2) == GroundMap.T.BLOCK)
	var valve: Dictionary = {}
	var pump: Dictionary = {}
	var wire: Dictionary = {}
	for d1 in g.map.explore:
		match String(d1["kind"]):
			"valve":
				valve = d1
			"terminal":
				pump = d1
			"tripwire":
				if wire.is_empty():
					wire = d1
	var down_p: Vector2 = g.map.get_meta("down_front", Vector2.INF)
	var sewer_ok: bool = g.map.style == "sewer" and canal > 20 and grate > 40 and deep > 5 and _has_kind(g.map, "ladder") and _has_kind(g.map, "hatch") \
		and not (_zone_of(g.map, "dungeon_out") as Dictionary).is_empty() and not (_zone_of(g.map, "dungeon_down") as Dictionary).is_empty() \
		and not valve.is_empty() and (pump.get("actions", []) as Array).has("drain") and not wire.is_empty() and g.map.has_meta("dark") \
		and down_p != Vector2.INF and g.map.path(g.map.spawn, down_p).is_empty() and g.combat.foes.size() >= 2
	# wading is slow
	var wade_ok := false
	for y3 in g.map.h:
		for x3 in g.map.w:
			if not wade_ok and g.map.floor_kind[y3 * g.map.w + x3] == 18 and GroundMap.walkable_t(g.map.t_at(x3, y3)):
				g.pilot.pos = Vector2(x3 + 0.5, y3 + 0.5) * GroundMap.TILE
				wade_ok = is_equal_approx(g._wade(), 0.55)
	# the valve drains the flooded tunnel: the way down opens
	g.explore_use({"i": g.map.explore.find(valve)})
	var drain_ok: bool = String(valve["state"]) == "open" and not g.map.path(g.map.spawn, down_p).is_empty()
	# a tripwire: walked into it goes off, sneaking over it does not; disarmed it is safe
	var cb: GroundCombat = g.combat
	var a: Vector2 = wire["pos"]
	g.pilot.pos = a + (Vector2(0, 16) if bool(wire.get("vertical", true)) else Vector2(16, 0))
	cb.sneaking = true
	g._wires_step(0.1)
	var sneak_safe: bool = String(wire["state"]) == "shut"
	cb.sneaking = false
	Commands.suit_god = true
	g._wires_step(0.1)
	var fired: bool = String(wire["state"]) == "fired"
	var nb := cb.booms.size()
	g._wires_step(0.7)
	var wire_ok: bool = sneak_safe and fired and cb.booms.size() > nb
	Commands.suit_god = false
	# down the ladder: level 2, the dealer's hideout
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_down")
	g.use()
	var door: Dictionary = {}
	var ctrl: Dictionary = {}
	var target: Dictionary = {}
	var safe: Dictionary = {}
	for d2 in g.map.explore:
		match String(d2["kind"]):
			"steel_door":
				door = d2
			"terminal":
				if bool(d2.get("target", false)):
					target = d2
				else:
					ctrl = d2
			"crate":
				if bool(d2.get("safe", false)):
					safe = d2
	var keypad: bool = g.map.explore.any(func(x): return String(x["kind"]) == "panel" and String(x.get("style", "")) == "hideout" and x.has("door"))
	var office_p: Vector2 = (target.get("pos", Vector2.ZERO) as Vector2) + Vector2(0, 30)
	var hide_ok: bool = g.depth == 1 and g.level == "dungeon" and g.map.style == "hideout" and not door.is_empty() and keypad and not target.is_empty() \
		and not safe.is_empty() and (target.get("actions", []) as Array).has("list") and g.map.path(g.map.spawn, office_p).is_empty() \
		and not (_zone_of(g.map, "dungeon_up") as Dictionary).is_empty() and g.combat.foes.size() >= 3
	# 0.7.53.5 (Luz): the turret on the office wall and the alarm – it sees you, the alarm rings, more come; hacked off
	var turret: Dictionary = {}
	var alarm: Dictionary = {}
	for d4 in g.map.explore:
		if String(d4["kind"]) == "turret":
			turret = d4
		elif String(d4["kind"]) == "alarm":
			alarm = d4
	var tur_ok: bool = not turret.is_empty() and not alarm.is_empty() and String(alarm["state"]) == "armed" and (ctrl.get("actions", []) as Array).has("turrets")
	if tur_ok:
		g._turrets_step(0.0)                                # (0.8.58.6: its target made first – a foe that is no walker)
		var n_foes: int = g.combat.foes.size()
		g.pilot.pos = (turret["pos"] as Vector2) + Vector2(0, 60)
		Commands.suit_god = false
		gear.refill()
		var ns: int = g.combat.shots.size()
		for ti in 8:
			g._turrets_step(0.15)
		tur_ok = bool(turret.get("seen", false)) and String(alarm["state"]) == "ringing" and g.combat.foes.size() == n_foes + 2 and g.combat.shots.size() > ns
		g._hack_done(ctrl, "turrets")
		var ns2: int = g.combat.shots.size()
		for ti2 in 8:
			g._turrets_step(0.15)
		tur_ok = tur_ok and String(turret["state"]) == "off" and g.combat.shots.size() == ns2
		# a cut alarm does not ring
		alarm["state"] = "armed"
		gear.belt[0] = {"id": "tl_cutter:C", "n": 1}
		g.explore_use({"i": g.map.explore.find(alarm)})
		var nf2: int = g.combat.foes.size()
		g.raise_alarm()
		tur_ok = tur_ok and String(alarm["state"]) == "cut" and g.combat.foes.size() == nf2
	g._hack_done(ctrl, "door")
	var cr0 := GameState.credits
	g._hack_done(target, "list")
	var cr1 := GameState.credits
	g._loot(safe)
	var done_ok: bool = String(door["state"]) == "open" and not g.map.path(g.map.spawn, office_p).is_empty() and GameState.poi_used.has(String(g._site["id"])) \
		and cr1 > cr0 and GameState.credits > cr1
	# back up and out: the levels kept (the water stays drained), out by the manhole
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_up")
	g.use()
	var up_ok: bool = g.depth == 0 and g.level == "dungeon" and String(valve["state"]) == "open" and g.pilot.pos.distance_to(down_p) < 30.0
	g._arrive = 0.0
	g.zone = _zone_of(g.map, "dungeon_out")
	g.use()
	var out_ok: bool = g.level == "landing" and g.map.style == "alley"
	g.zone = _zone_of(g.map, "dungeon_in")
	g.use()
	out_ok = out_ok and g.level == "landing"                  # used up: nothing more down there
	# in a city: the lift goes to the back alley; the city's own site comes back on the street
	main.close_deck(false)
	main._close_planet_map()
	f.docked_at = ""
	var city_ok := true
	var L := Universe.get_layout(view.system_id)
	var cbody := {}
	for b in L["planets"] + L.get("moons", []):
		if Universe.landable(b) and Universe.landing_sites(view.system_id, b).any(func(s): return String(s["kind"]) == "city"):
			cbody = b
			break
	if not cbody.is_empty():
		var e2 := Commands.execute({"type": "debug_land", "body": String(cbody["id"]), "kind": "city"})
		g = main.ground
		city_ok = e2 == "" and g != null and g.is_city()
		if city_ok:
			g._open_lift_menu({})
			var n_keys: int = (g._lift_menu.get_meta("keys", []) as Array).size()
			g._close_lift_menu()
			var site0: Dictionary = g._site
			city_ok = Commands.execute({"type": "debug_ground_level", "level": "alley"}) == "" and g.level == "alley" and g.map.style == "alley" \
				and String(g._site.get("theme", "")) == "sewer" and n_keys >= 4 and g.combat == null and not g.map.lifts.is_empty()
			g.zone = _zone_of(g.map, "dungeon_in")
			g._arrive = 0.0
			g.use()
			city_ok = city_ok and g.level == "dungeon" and g.combat != null and g.env.is_empty()
			g.zone = _zone_of(g.map, "dungeon_out")
			g._arrive = 0.0
			g.use()
			city_ok = city_ok and g.level == "alley"
			Commands.execute({"type": "debug_ground_level", "level": "street"})
			city_ok = city_ok and g.level == "street" and g._site == site0
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
