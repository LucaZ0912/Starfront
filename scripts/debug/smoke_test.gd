	var fit_ok: bool = e1 == "" and e2 == "" and bool(st.flags.get("w58_mining", false)) and bool(st.flags.get("w58_weapon", false)) \
		and GameState.credits == 2500 and st.step_data("darling").get("id", "") == "drone"
	for hop in ["", "concourse", "drones"]:
