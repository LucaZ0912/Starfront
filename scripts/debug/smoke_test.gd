	var multi: bool = fm.fg_custom and not g1.is_empty() and fm.groups_of(String(g1[0])) == [1, 8] and fm.group_slots(8).size() == 1 and fm.group_slots(1).size() == 2
	var back := ShipFitting.from_dict(fm.to_dict())
