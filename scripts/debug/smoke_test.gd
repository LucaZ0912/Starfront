				# ---- its stamp: come near and it rears up, standing; then a ring of force runs out from it
				fresh.call()
				sv.bst["stomp"] = 0.0
				put.call((sv.fp[sv.boss_i()] as Vector2) + Vector2(0.0, 50.0))
