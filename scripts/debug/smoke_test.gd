		check(false, "0.7.52.21: the arena opens")
		return
	gear.refill()
	Commands.suit_god = true
	cb.step(0.05, Vector2.ZERO)
	var key_ok: bool = Keybinds.key_text("foot_sneak").to_lower().contains("ctrl")
