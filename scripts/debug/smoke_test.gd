				and cpos.distance_to(pp) > 60.0 and (py_idx.call() as Array).all(func(q): return (sv.fp[q] as Vector2).distance_to(cpos) > 90.0 and (sv.barrier as Rect2).has_point(sv.fp[q]))
			if c_came:
