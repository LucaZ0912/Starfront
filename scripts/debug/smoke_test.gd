				sv._hit(int((py_idx.call() as Array)[0]), 1000000.0, pp)
				var down: bool = int(sv._cnt[KI["pylon"]]) == 0 and String(sv.banner) == "THE SHIELD FALLS" and int(sv.boss_info()["phase"]) == 2 and int(sv.boss_info()["shield"]) == 0 \
