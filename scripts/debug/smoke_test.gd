	var d2: Dictionary = cb.drones[1]
	var h2 := float(d2["st"]["shield"]) + float(d2["st"]["armor"])
	var h1 := float(cb.drone["st"]["shield"]) + float(cb.drone["st"]["armor"])
	cb._hurt_drone(5.0, "kinetic", d2)
	var hurt_ok: bool = float(d2["st"]["shield"]) + float(d2["st"]["armor"]) < h2 and is_equal_approx(float(cb.drone["st"]["shield"]) + float(cb.drone["st"]["armor"]), h1)
	Commands.execute({"type": "debug_combat", "do": "drone_kill", "place": 1})
	hurt_ok = hurt_ok and String(cb.drones[1]["state"]) == "down" and cb.drone_flying()
	Commands.execute({"type": "debug_combat", "do": "drone_ready"})
	cb.step(0.05, Vector2.ZERO)
	hurt_ok = hurt_ok and String(cb.drones[1].get("state", "")) == "docked"
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(data_ok and shop_ok and slots_ok and dock_ok and second_ok and both_ok and hurt_ok,
		"0.7.52.18: the Senate armours – two drone places and stronger shields, only in the Assembly's shops; the drones docked at the arms, the second on Shift+C alone, both in the air, each hurt and lost on its own  [%s]" % " ".join(PackedStringArray([str(data_ok), str(shop_ok), str(slots_ok), str(dock_ok), str(second_ok), str(both_ok), str(hurt_ok)])))


func _test_foot_pathfinder(view: SystemView) -> void:
	var GD = GearShop.GearData
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var gear = GameState.gear
	var ps: Dictionary = GD.stats("suit_mil_pathfinder:C")
	var data_ok: bool = int(ps.get("drones", 0)) == 0 and String(ps["builtin"]) == "wp_arm_laser" and float(ps["armor"]) > float(GD.stats("suit_mil_heavy:C")["armor"]) \
		and not GD.all_ids().has("wp_arm_laser:C") and GD.all_ids().has("suit_mil_pathfinder:C") and float(GD.stats("wp_arm_laser:C")["charge"]) == 30.0
	# putting it on: the laser in the first weapon place, what was there into the pockets; it does not come off alone
	gear.suit = "suit_mil_light:C"
	gear._fit_slots()
	for i in gear.inv.size():
		gear.inv[i] = {}
	gear.weapons[0] = "wp_rifle:C"
	gear.weapons[1] = "wp_laser_rifle:C"
	gear.inv[0] = {"id": "suit_mil_pathfinder:B", "n": 1}
	var e1: String = gear.equip_from_inv(0)
	var eq_ok: bool = e1 == "" and String(gear.weapons[0]) == "wp_arm_laser:B" and gear.count("wp_rifle:C") == 1 and gear.drones.is_empty() \
		and gear.unequip("weapons", 0) != "" and String(gear.weapons[0]) == "wp_arm_laser:B"
	# taking it off: the laser goes with it, nowhere into the pockets
	var li := -1
	for i2 in gear.inv.size():
		if not (gear.inv[i2] as Dictionary).is_empty() and String(gear.inv[i2]["id"]) == "suit_mil_light:C":
			li = i2
	var e2: String = gear.equip_from_inv(li) if li >= 0 else "no light suit"
	eq_ok = eq_ok and e2 == "" and gear.count("wp_arm_laser:B") == 0 and not gear.weapons.has("wp_arm_laser:B")
	# the shop: in the Covenant's lands only (bigger places)
	var cov := {"id": "test_cov_gear", "faction": "covenant", "tier": 2, "type": "trade"}
	var asm := {"id": "test_asm_gear", "faction": "assembly", "tier": 2, "type": "trade"}
	var shop_ok: bool = GearShop.offer(cov).has("suit_mil_pathfinder") and not GearShop.offer(asm).has("suit_mil_pathfinder") and not GearShop.offer(cov).has("wp_arm_laser")
	# the fight: the laser charges whatever is in hand and cuts through a bulwark
	gear.suit = "suit_mil_pathfinder:C"
	gear._fit_slots()
	gear.weapons[1] = "wp_laser_rifle:C"
	Commands.execute({"type": "debug_arena", "world": "desert", "foes": []})
	var g = main.ground
	var cb: GroundCombat = g.combat if g != null else null
	if cb == null:
		check(false, "0.7.52.14: the arena opens")
		return
	gear.refill()
	var bw = null
	for ob in g.map.objects:
		if String(ob["kind"]) == "bulwark" and int(ob["w"]) >= 3 and bw == null:
			bw = ob
	var fight_ok := false
	var raise_ok := false
	if bw != null:
		var r := Rect2(Vector2(int(bw["x"]), int(bw["y"])) * 16.0, Vector2(int(bw["w"]), int(bw["h"])) * 16.0)
		var me := Vector2(r.get_center().x, r.end.y + 30.0)
		g.pilot.pos = me
		g.pilot.position = me * GroundMap.SCALE
		var fo: Dictionary = cb.spawn("bandit_rifleman", Vector2(r.get_center().x, r.position.y - 20.0))
		cb._wake(fo)
		cb.frozen = true
		cb.step(0.05, Vector2.ZERO)
		cb.lock(fo)
		cb.lock_t = 0.0
		cb.weapon_i = 1                                   # the laser rifle in hand: the arm laser charges anyway
		cb.arm_charge = 0.0
		for i3 in 10:
			cb.step(0.1, Vector2.ZERO)
		var charged: bool = cb.arm_charge > 0.9 and cb.sight(me, fo["w"].pos)["blocked"]
		cb.weapon_i = 0                                   # the arm laser in hand, not yet charged: no beam
		cb.step(0.05, Vector2.ZERO)
		var none_yet: bool = not cb.shots.any(func(s): return String(s["kind"]) == "armbeam")
		raise_ok = cb.arm_raised() and bool(g.pilot.look.get("arm_up", false)) and g.pilot.aim_weapon == "wp_arm_laser"
		cb.arm_charge = 30.0
		var h0 := float(fo["st"]["shield"]) + float(fo["st"]["armor"]) + float(fo["st"]["health"])
		var hit := false
		for tries in 6:
			cb.arm_charge = 30.0
			cb.pilot_cool = 0.0
			cb.step(0.05, Vector2.ZERO)
			hit = hit or float(fo["st"]["shield"]) + float(fo["st"]["armor"]) + float(fo["st"]["health"]) < h0
			if hit:
				break
		# 0.7.52.17 (Luz): the beam holds 2.5 s – still burning after a second
		var held := true
		if not fo["dead"]:
			cb.pilot_cool = 5.0
			for j in 10:
				cb.step(0.1, Vector2.ZERO)
			held = fo["dead"] or cb.shots.any(func(s): return String(s["kind"]) == "armbeam")
		fight_ok = charged and none_yet and hit and held and cb.arm_charge < 2.0
	# back
	main.close_deck(false)
	main._close_planet_map()
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	gear.suit = "suit_civil:F"
	gear._fit_slots()
	gear.aboard()
	gear.combat_t = 0.0
	main._update_input()
	check(data_ok and eq_ok and shop_ok and fight_ok and raise_ok,
		"0.7.52.14: the Pathfinder armour – no drone place, stronger plate; the Red Arm Laser in its first weapon place, staying with the suit; only in the Covenant's shops; the laser charges with another weapon in hand, its arm raised, cuts through a bulwark  [%s]" % " ".join(PackedStringArray([str(data_ok), str(eq_ok), str(shop_ok), str(fight_ok), str(raise_ok)])))


const SightGenT = preload("res://scripts/ground/sight_gen.gd")

## Package 54a (Luz): the sights on the ground – each kind built (the viewpoint reached from the landing place, the stall,
## the information holo), photos (paid once each), souvenirs, the Skyring deck in the cloud cities, excursions (seen on
## stepping up to the viewpoint) and shuttle runs between a station and a city.
func _test_sights54a(view: SystemView) -> void:
	var notes: Array = []
	var SD = load("res://data/sights.gd")
	var data_ok := true
	for th in SD.SIGHTS:
		var d: Dictionary = SD.SIGHTS[th]
		data_ok = data_ok and GameData.commodities.has(String(d["souvenir"])) and not (d["events"] as Dictionary).is_empty()
		for k in d["events"]:
			data_ok = data_ok and String(d["events"][k][1]) in ["day", "dusk", "dawn", "night", "any"]
	var f := GameState.active()
	var p := view.player
	var pos0: Vector2 = p.position
	var cr_keep: int = GameState.credits
	var cargo_keep: Dictionary = f.cargo.duplicate()
	var photos_keep: Dictionary = GameState.sight_photos.duplicate()
	f.cargo.clear()
	GameState.credits = 500000
	var built_ok := true
	var photo_ok := true
	var tour_ok := true
	var souv_ok := true
	for th2 in SD.READY:
		var e: String = Commands.execute({"type": "debug_sight", "theme": th2, "event": "", "day": 0.8})
		var g = main.ground
		if e != "" or g == null or g.map == null or not g.map.has_meta("sight"):
			built_ok = false
			notes.append("%s: %s" % [th2, e])
			continue
		var m: GroundMap = g.map
		var sg: Dictionary = m.get_meta("sight")
		var vp := _zone_of(m, "viewpoint")
		var reach: bool = not vp.is_empty() and m.path(m.spawn, (vp["rect"] as Rect2).get_center()).size() > 0
		var ok: bool = String(sg["theme"]) == th2 and String(sg["event"]) != "" and reach and not _zone_of(m, "souvenir").is_empty() and not _zone_of(m, "sight_info").is_empty()
		built_ok = built_ok and ok
		if not ok:
			notes.append("%s: reach %s, event '%s'" % [th2, reach, String(sg["event"])])
		# a photo: paid once
		var c0: int = GameState.credits
		var e1: String = Commands.execute({"type": "sight_photo"})
		var c1: int = GameState.credits
		var e2: String = Commands.execute({"type": "sight_photo"})
		photo_ok = photo_ok and e1 == "" and c1 - c0 in [SightGenT.PHOTO_PAY, SightGenT.PHOTO_PAY_RARE] and e2 != "" and GameState.credits == c1
		# an excursion aboard this ship: seen on stepping up to the viewpoint
		var tm := {"id": "exc_test", "type": "passenger", "giver": "x", "giver_system": GameState.current_system, "amount": 2, "cabin": "bulk",
			"target_system": GameState.current_system, "target_station": "x", "ship_uid": f.uid, "expires": GameState.play_time + 999.0, "time_limit": 999.0,
			"reward": 100, "title": "Excursion (test)", "desc": "", "faction": "", "progress": 0, "cabin_slot": "",
			"tour": {"system": GameState.current_system, "sight": String(sg["id"]), "name": "x", "body": "x", "kind": "ground", "t": 0.0, "done": false, "ground": true, "where": "x"}}
		GameState.missions.append(tm)
		Commands.execute({"type": "sight_tour"})
		tour_ok = tour_ok and bool(tm["tour"]["done"])
		GameState.missions.erase(tm)
		# a souvenir
		var item := String(SD.SIGHTS[th2]["souvenir"])
		var n0 := float(f.cargo.get(item, 0.0))
		var e3: String = Commands.execute({"type": "souvenir_buy", "amount": 2})
		souv_ok = souv_ok and e3 == "" and float(f.cargo.get(item, 0.0)) >= n0 + 1.99
		main.close_deck(false)
		main._close_planet_map()
	# the Skyring deck
	Commands.execute({"type": "debug_cloud", "giant": "gas", "level": "cstation", "stop": 1, "sight_event": "glory", "sight_day": 0.8})
	var gs = main.ground
	var ring_ok: bool = gs != null and gs.map != null and gs.map.has_meta("sight") and String(gs.map.get_meta("sight")["theme"]) == "skyring" \
		and String(gs.map.get_meta("sight")["event"]) == "glory" and not _zone_of(gs.map, "viewpoint").is_empty() and not _zone_of(gs.map, "souvenir").is_empty()
	if ring_ok:
		var e4: String = Commands.execute({"type": "sight_photo"})
		ring_ok = e4 == ""
	main.close_deck(false)
	main._close_planet_map()
	# excursions and shuttles on the boards
	var rng := RandomNumberGenerator.new()
	rng.seed = 54
	var n_exc := 0
	var n_sh := 0
	var sh_ok := true
	var gsights := 0
	for sid in mini(Universe.systems.size(), 40):
		if bool(Universe.systems[sid].get("outer", false)):
			continue
		gsights += Missions.ground_sights(sid).size()
		var sts: Array = Universe.get_layout(sid)["stations"]
		if sts.is_empty():
			continue
		for i in 4:
			var t: Dictionary = Missions.generate_tour(sid, sts[0], rng)
			if not t.is_empty() and bool(t["tour"].get("ground", false)):
				n_exc += 1
			var s: Dictionary = Missions.generate_shuttle(sid, sts[0], rng)
			if not s.is_empty():
				n_sh += 1
				var tgt := String(s["target_station"])
				var probe: Dictionary = s.duplicate()
				probe["ship_uid"] = f.uid
				sh_ok = sh_ok and tgt.begins_with("land:") and not Universe.find_station(sid, tgt).is_empty() and Missions.can_turn_in(probe, f, tgt)
	# back
	if main._fade_tw != null and main._fade_tw.is_valid():
		main._fade_tw.kill()
	if main._fade != null:
		main._fade.color = Color(0, 0, 0, 0)
	f.docked_at = ""
	p.visible = true
	p.scale = Vector2.ONE
	p.position = pos0
	p.order = {"type": "idle"}
	Universe.debug_bodies.clear()
	Universe.debug_sites.clear()
	GameState.gear.aboard()
	main._update_input()
	f.cargo = cargo_keep
	GameState.credits = cr_keep
	GameState.sight_photos = photos_keep
	check(data_ok and built_ok and photo_ok and tour_ok and souv_ok and ring_ok and gsights > 0 and n_exc > 0 and n_sh > 0 and sh_ok,
		"54a: sights on the ground – falls, lagoon, ice cathedral, arches, lava terraces, crater, each with its viewpoint reached from the landing place, the stall and the holo; a photo paid once; souvenirs into the hold; the Skyring deck in the cloud cities; excursions (%d) seen at the viewpoint, shuttle runs (%d) down to a city's hangar; %d sights in the first systems  [%s]%s" % [
			n_exc, n_sh, gsights, " ".join(PackedStringArray([str(data_ok), str(built_ok), str(photo_ok), str(tour_ok), str(souv_ok), str(ring_ok), str(sh_ok)])),
			(" " + ", ".join(PackedStringArray(notes))) if not notes.is_empty() else ""])


const MinigameT = preload("res://data/minigames.gd")
const PoolGameT = preload("res://scripts/ground/pool_game.gd")


## Package 54b (Luz): the bar games – stakes by the win streak, the lobby, billiards (the rack, the balls rolling and
## stopping on the table, a straight shot pocketed, the rules: groups, fouls, the 8 too early).
func _test_minigames54b(view: SystemView) -> void:
	var notes: Array = []
	# the stakes and the guests
	var st_ok: bool = MinigameT.max_stake(0) == 200 and MinigameT.max_stake(9) == 200 and MinigameT.max_stake(10) == 1000 and MinigameT.max_stake(25) == 5000 and not bool(MinigameT.stakes(9).filter(func(s): return int(s[0]) == 500)[0][1]) and bool(MinigameT.stakes(10).filter(func(s): return int(s[0]) == 500)[0][1])
	var g0: Array = MinigameT.guests("x", "billiards", 0, 3)
	var g25: Array = MinigameT.guests("x", "billiards", 25, 3)
	var guest_ok: bool = g0.size() >= 2 and g0 == MinigameT.guests("x", "billiards", 0, 3) and g0.all(func(g): return int(g["stars"]) <= 3) and g25.all(func(g): return int(g["stars"]) >= 3)
	# the stake on the table, the pot to the winner, the streak
	var keep_cr: int = GameState.credits
	var keep_streak: Dictionary = GameState.minigame_streak.duplicate()
	GameState.credits = 1000
	GameState.minigame_streak["billiards"] = 3
	var e_hi: String = Commands.execute({"type": "minigame_begin", "game": "billiards", "mode": "8ball", "stake": 500, "opponent": {"name": "T"}})
	var e_ok: String = Commands.execute({"type": "minigame_begin", "game": "billiards", "mode": "8ball", "stake": 200, "opponent": {"name": "T"}})
	var mid_cr: int = GameState.credits
	Commands.execute({"type": "minigame_end", "won": true})
	var won_ok: bool = e_hi != "" and e_ok == "" and mid_cr == 800 and GameState.credits == 1200 and int(GameState.minigame_streak["billiards"]) == 4
	Commands.execute({"type": "minigame_begin", "game": "billiards", "mode": "8ball", "stake": 100, "opponent": {"name": "T"}})
	Commands.execute({"type": "minigame_end", "won": false})
	var lost_ok: bool = GameState.credits == 1100 and int(GameState.minigame_streak["billiards"]) == 0
	# billiards
	var pg = PoolGameT.new()
	pg.setup({"mode": "8ball", "opponent": {"name": "Test Guest", "stars": 3}, "stake": 0})
	var rack_ok: bool = pg.balls.size() == 16
	pg.turn = 0
	pg._take_shot(0.0, 1.0, Vector2.ZERO)                # the break
	var n := 0
	while pg.state == "roll" and n < 6000:
		pg._physics(1.0 / 60.0)
		if not pg._moving():
			pg._shot_over()
		n += 1
	var inside := true
	for b in pg.balls:
		if not bool(b["in"]):
			var p: Vector2 = b["p"]
			inside = inside and p.x >= pg.FX0 and p.x <= pg.FX1 and p.y >= pg.FY0 and p.y <= pg.FY1
	var spread := 0
	for b2 in pg.balls:
		if int(b2["n"]) != 0 and not bool(b2["in"]) and (b2["p"] as Vector2).x < pg.FX0 + (pg.FX1 - pg.FX0) * 0.6:
			spread += 1
	var break_ok: bool = n < 6000 and inside and pg.state != "roll"
	# a straight shot into the corner pocket
	pg.balls = [{"n": 0, "p": Vector2(200, 200), "v": Vector2.ZERO, "in": false}, {"n": 3, "p": Vector2(300, 150), "v": Vector2.ZERO, "in": false},
		{"n": 8, "p": Vector2(150, 100), "v": Vector2.ZERO, "in": false}, {"n": 12, "p": Vector2(400, 230), "v": Vector2.ZERO, "in": false}]
	pg.groups = ["solid", "stripe"]
	pg.turn = 0
	pg.state = "aim"
	pg.break_shot = false
	var plan: Dictionary = pg._ai_choose(Vector2(200, 200))
	pg._before = [0, 3, 8, 12]
	pg.shoot(float(plan["a"]), float(plan["pw"]), Vector2.ZERO)
	n = 0
	while pg.state == "roll" and n < 6000:
		pg._physics(1.0 / 60.0)
		if not pg._moving():
			pg._shot_over()
		n += 1
	var pot_ok: bool = pg.balls.filter(func(b): return int(b["n"]) == 3)[0]["in"] and pg.turn == 0
	# the 8 too early loses
	pg.state = "aim"
	pg._before = [0, 8, 12]
	pg._potted = [8]
	pg._first_hit = 8
	GameState.credits = 1000
	Commands.mg_session = {"game": "billiards", "mode": "8ball", "stake": 0, "opponent": {}}
	pg.groups = ["stripe", "solid"]
	pg._shot_over()
	var early_ok: bool = pg.state == "over" and not pg.won
	# a foul: hitting the other's ball first gives the ball in hand
	var pg2 = PoolGameT.new()
	pg2.setup({"mode": "8ball", "opponent": {"name": "Test", "stars": 2}, "stake": 0})
	pg2.break_shot = false
	pg2.groups = ["solid", "stripe"]
	pg2.turn = 0
	pg2._before = [0, 1, 9]
	pg2._potted = []
	pg2._first_hit = 9
	pg2._shot_over()
	var foul_ok: bool = pg2.turn == 1 and pg2.state in ["place_ai", "ai"]
	pg.free()
	pg2.free()
	GameState.credits = keep_cr
	GameState.minigame_streak = keep_streak
	Commands.mg_session = {}
	# the tables in the bars
	var m := GroundMap.new()
	m.setup(20, 20)
	DeckGen._pool_table(m, 4, 4)
	var table_ok: bool = m.zones.any(func(z): return String(z.get("kind", "")) == "pool") and m.objects.any(func(o): return String(o["kind"]) == "pool_table")
	check(st_ok and guest_ok and won_ok and lost_ok and rack_ok and break_ok and pot_ok and early_ok and foul_ok and table_ok,
		"54b: bar games – stakes by the win streak (low, medium from 10, high from 25), the guests stronger with it; the stake on the table, the pot to the winner, the streak ends on a loss; billiards: the rack, the break rolls out and stops on the table (%d balls in the far third), a straight shot pocketed, the 8 too early loses, a foul gives the ball in hand; pool tables in the bars  [%s]" % [
			16 - spread, " ".join(PackedStringArray([str(st_ok), str(guest_ok), str(won_ok), str(lost_ok), str(rack_ok), str(break_ok), str(pot_ok), str(early_ok), str(foul_ok), str(table_ok)]))])


const DartsGameT = preload("res://scripts/ground/darts_game.gd")


## Package 54b (Luz): darts – the board scores right (bull, trebles, doubles, off the board), the guest aims at a finish,
## a bust gives back the turn's points, checking out exactly wins; around the clock; a board on its stand in the bars.
func _test_darts54b(view: SystemView) -> void:
	var D = DartsGameT
	var score_ok: bool = int(D.score_at(D.BC)[0]) == 50 and int(D.score_at(D.BC + Vector2(0, -7))[0]) == 25 \
		and String(D.score_at(D.target(20, "T"))[1]) == "T20" and int(D.score_at(D.target(20, "T"))[0]) == 60 \
		and String(D.score_at(D.target(16, "D"))[1]) == "D16" and int(D.score_at(D.target(19, "S"))[0]) == 19 \
		and int(D.score_at(D.BC + Vector2(0, -110))[0]) == 0
	var dg = D.new()
	dg.setup({"mode": "301", "opponent": {"name": "Test Guest", "stars": 3}, "stake": 0})
	var aim_ok: bool = String(D.score_at(dg.ai_aim(301))[1]) == "T20" and String(D.score_at(dg.ai_aim(32))[1]) == "D16" \
		and String(D.score_at(dg.ai_aim(17))[1]) == "17" and String(D.score_at(dg.ai_aim(50))[1]) == "Bull"
	# a bust: 10 left, a T20 – back to 10, the turn over
