	var e1 := Commands.execute({"type": "fit_module", "slot": tool_slot, "module": "t_mining:1:C"})
	var e2 := Commands.execute({"type": "fit_module", "slot": "weapon_0", "module": "w_pulse:1:C"})
	for i in 6:
