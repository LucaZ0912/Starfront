				var cnow: Vector2 = sv.fp[sv.boss_i()]
				sv.bst["spawn"] = 99.0
				sv.bst["warm"] = 0.5
				sv.bst["a"] = PI * 0.5
				put.call(cnow + Vector2(0.0, 100.0))
				sv.step(0.016)
				var c_warms: bool = float(sv.run["hp"]) == 1000.0
				sv.bst["warm"] = 0.0
				sv.bst["a"] = PI * 0.5
